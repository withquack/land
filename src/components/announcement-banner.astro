---

---

<div
  x-data="{
    bannerVisible: !localStorage.getItem('announcement-dismissed'),
    hours: 0,
    minutes: 0,
    seconds: 0,
    initTimer() {
      const endTime = new Date();
      endTime.setHours(23, 59, 59, 999);

      const updateTimer = () => {
        const now = new Date();
        const diff = endTime - now;

        if (diff <= 0) {
          this.hours = 0;
          this.minutes = 0;
          this.seconds = 0;
        } else {
          this.hours = Math.floor(diff / (1000 * 60 * 60));
          this.minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
          this.seconds = Math.floor((diff % (1000 * 60)) / 1000);
        }
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }
  }"
  x-init="initTimer()"
  x-show="bannerVisible"
  x-transition:enter="transition ease-out duration-300"
  x-transition:enter-start="opacity-0 transform -translate-y-full"
  x-transition:enter-end="opacity-100 transform translate-y-0"
  x-transition:leave="transition ease-in duration-200"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  class="fixed top-0 left-0 right-0 z-50 bg-gradient-to-r from-purple-60 via-[#FF9C20] to-cyan-50 py-3 shadow-lg"
  style="display: none;"
  x-cloak
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-4">
      <div class="flex-1 flex items-center justify-center gap-3 flex-wrap">
        <!-- Icon -->
        <svg class="w-5 h-5 text-white animate-pulse flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 2a6 6 0 00-6 6v3.586l-.707.707A1 1 0 004 14h12a1 1 0 00.707-1.707L16 11.586V8a6 6 0 00-6-6zM10 18a3 3 0 01-3-3h6a3 3 0 01-3 3z"/>
        </svg>
        <!-- Message -->
        <div class="flex items-center gap-3 flex-wrap justify-center">
          <p class="text-sm md:text-base text-white font-semibold">
            <span class="hidden sm:inline">🎉</span> Get <span class="font-bold underline">25% OFF</span> with code <span class="font-mono bg-white/20 px-2 py-1 rounded">QUACK25</span>
          </p>
          <!-- Countdown Timer -->
          <div class="flex items-center gap-2 bg-white/20 px-3 py-1 rounded-lg">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm font-mono text-white font-bold">
              <span x-text="String(hours).padStart(2, '0')">00</span>:<span x-text="String(minutes).padStart(2, '0')">00</span>:<span x-text="String(seconds).padStart(2, '0')">00</span>
            </span>
          </div>
          <a href="/pricing" class="text-white underline hover:no-underline font-semibold text-sm">Claim Now →</a>
        </div>
      </div>
      <!-- Close Button -->
      <button
        @click="localStorage.setItem('announcement-dismissed', 'true'); bannerVisible = false"
        class="text-white hover:bg-white/20 rounded-lg p-1.5 transition-colors flex-shrink-0"
        aria-label="Dismiss announcement"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<!-- Spacer to prevent content from being hidden under fixed banner -->
<div
  x-data="{ bannerVisible: !localStorage.getItem('announcement-dismissed') }"
  x-show="bannerVisible"
  class="h-12"
  style="display: none;"
  x-cloak
></div>

<style>
  [x-cloak] { display: none !important; }
</style>
