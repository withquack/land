---
// AI Server Creator Component - Natural Language Server Creation Demo
// Shows how users can create servers using plain English with QuackAI
---

<div
  class="ai-server-creator w-full max-w-5xl mx-auto"
  x-data="{
    prompt: '',
    isCreating: false,
    stage: 'idle', // idle, analyzing, configuring, deploying, complete
    serverConfig: null,
    examples: [
      'Create a survival server with economy, no PvP, medieval theme',
      'Prison server with custom mines and rankup system',
      'Skyblock server with custom islands and challenges',
      'Creative server with WorldEdit and plot system',
      'Hardcore survival with custom mobs and lore'
    ],

    // Simulated AI analysis stages
    async createServer() {
      if (!this.prompt.trim()) return;

      this.isCreating = true;
      this.stage = 'analyzing';

      // Simulate AI analysis
      await this.sleep(2000);
      this.stage = 'configuring';

      // Generate config based on prompt
      this.serverConfig = this.generateConfig(this.prompt);
      await this.sleep(2500);

      this.stage = 'deploying';
      await this.sleep(3000);

      this.stage = 'complete';
      this.isCreating = false;
    },

    generateConfig(prompt) {
      const lower = prompt.toLowerCase();

      // Parse intent from prompt
      const config = {
        game: 'Minecraft',
        version: '1.20.4',
        type: 'Survival',
        plugins: [],
        settings: {},
        estimatedSetupTime: '47 seconds'
      };

      // Detect game type
      if (lower.includes('prison')) config.type = 'Prison';
      if (lower.includes('skyblock')) config.type = 'Skyblock';
      if (lower.includes('creative')) config.type = 'Creative';
      if (lower.includes('pvp')) config.type = 'PvP';

      // Detect plugins based on keywords
      if (lower.includes('economy')) {
        config.plugins.push({ name: 'Vault', reason: 'Economy framework' });
        config.plugins.push({ name: 'EssentialsX', reason: 'Core economy features' });
      }

      if (lower.includes('no pvp') || lower.includes('no-pvp')) {
        config.settings.pvp = false;
        config.settings.pvpReason = 'Disabled as requested';
      } else if (lower.includes('pvp')) {
        config.settings.pvp = true;
      }

      if (lower.includes('medieval') || lower.includes('theme')) {
        config.plugins.push({ name: 'Medieval Factions', reason: 'Medieval theme support' });
        config.plugins.push({ name: 'Custom Textures', reason: 'Medieval resource pack' });
      }

      if (lower.includes('skyblock')) {
        config.plugins.push({ name: 'BentoBox', reason: 'Skyblock core' });
        config.plugins.push({ name: 'Level Addon', reason: 'Island levels' });
      }

      if (lower.includes('prison')) {
        config.plugins.push({ name: 'Prison', reason: 'Core prison mechanics' });
        config.plugins.push({ name: 'MineResetLite', reason: 'Auto-resetting mines' });
      }

      if (lower.includes('custom mob') || lower.includes('lore')) {
        config.plugins.push({ name: 'MythicMobs', reason: 'Custom mob creation' });
        config.plugins.push({ name: 'ModelEngine', reason: 'Custom models' });
      }

      if (lower.includes('worldedit') || lower.includes('creative')) {
        config.plugins.push({ name: 'WorldEdit', reason: 'Building tools' });
        config.plugins.push({ name: 'FastAsyncWorldEdit', reason: 'Performance optimization' });
      }

      if (lower.includes('plot')) {
        config.plugins.push({ name: 'PlotSquared', reason: 'Plot management' });
      }

      // Add default essential plugins
      config.plugins.push({ name: 'LuckPerms', reason: 'Permissions management' });
      config.plugins.push({ name: 'Spark', reason: 'Performance profiler' });

      return config;
    },

    useExample(example) {
      this.prompt = example;
      this.reset();
    },

    reset() {
      this.stage = 'idle';
      this.serverConfig = null;
    },

    sleep(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    },

    get stageText() {
      const stages = {
        idle: '',
        analyzing: 'Analyzing your requirements with QuackAI...',
        configuring: 'Selecting optimal plugins and configuration...',
        deploying: 'Deploying your server to Kubernetes cluster...',
        complete: 'Server ready! 🎉'
      };
      return stages[this.stage] || '';
    },

    get stageProgress() {
      const progress = {
        idle: 0,
        analyzing: 25,
        configuring: 60,
        deploying: 90,
        complete: 100
      };
      return progress[this.stage] || 0;
    }
  }"
  x-init="console.log('AI Server Creator initialized')"
>
  <!-- Header -->
  <div class="text-center mb-8">
    <div class="inline-block bg-gradient-to-r from-purple-600 to-pink-600 text-white px-4 py-1 rounded-full text-sm font-semibold mb-4">
      ✨ Powered by QuackAI
    </div>
    <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-3">
      Create Servers with Natural Language
    </h2>
    <p class="text-xl text-gray-600 dark:text-gray-400">
      Just describe what you want - our AI does the rest
    </p>
  </div>

  <!-- Main Interface -->
  <div class="bg-white dark:bg-gray-900 rounded-2xl shadow-2xl overflow-hidden">
    <!-- Input Section -->
    <div class="p-8 bg-gradient-to-r from-orange-50 to-red-50 dark:from-orange-900/20 dark:to-red-900/20">
      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3">
        What kind of server do you want to create?
      </label>

      <div class="relative">
        <textarea
          x-model="prompt"
          @keydown.enter.meta="createServer()"
          @keydown.enter.ctrl="createServer()"
          placeholder="e.g., Create a survival server with economy, no PvP, medieval theme..."
          rows="3"
          class="w-full px-4 py-3 pr-24 border-2 border-gray-300 dark:border-gray-700 rounded-lg focus:ring-2 focus:ring-orange-500 focus:border-orange-500 resize-none dark:bg-gray-800 dark:text-white"
          :disabled="isCreating"
        ></textarea>

        <button
          @click="createServer()"
          :disabled="!prompt.trim() || isCreating"
          class="absolute bottom-3 right-3 bg-orange-600 text-white px-6 py-2 rounded-lg font-semibold hover:bg-orange-700 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span x-show="!isCreating">Create</span>
          <span x-show="isCreating" x-cloak>
            <svg class="animate-spin h-5 w-5 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </span>
        </button>
      </div>

      <div class="text-xs text-gray-500 dark:text-gray-400 mt-2">
        Press <kbd class="px-2 py-1 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded text-xs font-mono">⌘ + Enter</kbd> to create
      </div>

      <!-- Example Prompts -->
      <div class="mt-4" x-show="stage === 'idle'">
        <div class="text-xs font-semibold text-gray-600 dark:text-gray-400 mb-2">
          Try these examples:
        </div>
        <div class="flex flex-wrap gap-2">
          <template x-for="example in examples" :key="example">
            <button
              @click="useExample(example)"
              class="text-sm px-3 py-1.5 bg-white dark:bg-gray-800 border border-gray-300 dark:border-gray-600 rounded-full hover:border-orange-500 hover:text-orange-600 transition-colors"
              x-text="example"
            ></button>
          </template>
        </div>
      </div>
    </div>

    <!-- Progress Section -->
    <div class="p-8" x-show="stage !== 'idle'" x-cloak>
      <!-- Stage Indicator -->
      <div class="mb-6">
        <div class="flex items-center justify-between mb-2">
          <span class="text-sm font-semibold text-gray-700 dark:text-gray-300" x-text="stageText"></span>
          <span class="text-sm font-semibold text-orange-600" x-text="stageProgress + '%'"></span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
          <div
            class="bg-gradient-to-r from-orange-500 to-red-500 h-2 transition-all duration-500 ease-out"
            :style="'width: ' + stageProgress + '%'"
          ></div>
        </div>
      </div>

      <!-- AI Analysis Output -->
      <div class="space-y-4" x-show="stage === 'configuring' || stage === 'deploying' || stage === 'complete'" x-cloak>
        <!-- Server Config -->
        <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
          <h3 class="font-semibold text-lg text-gray-900 dark:text-white mb-4">
            🎮 Server Configuration
          </h3>

          <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Game</div>
              <div class="font-semibold text-gray-900 dark:text-white" x-text="serverConfig?.game"></div>
            </div>
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Version</div>
              <div class="font-semibold text-gray-900 dark:text-white" x-text="serverConfig?.version"></div>
            </div>
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Type</div>
              <div class="font-semibold text-gray-900 dark:text-white" x-text="serverConfig?.type"></div>
            </div>
            <div>
              <div class="text-xs text-gray-500 dark:text-gray-400">Setup Time</div>
              <div class="font-semibold text-green-600" x-text="serverConfig?.estimatedSetupTime"></div>
            </div>
          </div>

          <!-- Plugins -->
          <div x-show="serverConfig?.plugins?.length > 0">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Selected Plugins (<span x-text="serverConfig?.plugins?.length"></span>)
            </h4>
            <div class="space-y-2">
              <template x-for="plugin in serverConfig?.plugins" :key="plugin.name">
                <div class="flex items-start space-x-3 bg-white dark:bg-gray-900 rounded-lg p-3">
                  <div class="flex-shrink-0 w-8 h-8 bg-orange-100 dark:bg-orange-900/20 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-semibold text-gray-900 dark:text-white text-sm" x-text="plugin.name"></div>
                    <div class="text-xs text-gray-500 dark:text-gray-400" x-text="plugin.reason"></div>
                  </div>
                </div>
              </template>
            </div>
          </div>

          <!-- Settings -->
          <div x-show="serverConfig?.settings?.pvp !== undefined" class="mt-4">
            <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">
              Server Settings
            </h4>
            <div class="bg-white dark:bg-gray-900 rounded-lg p-3">
              <div class="flex items-center justify-between">
                <span class="text-sm text-gray-700 dark:text-gray-300">PvP</span>
                <span class="text-sm font-semibold" :class="serverConfig?.settings?.pvp ? 'text-red-600' : 'text-green-600'">
                  <span x-text="serverConfig?.settings?.pvp ? 'Enabled' : 'Disabled'"></span>
                </span>
              </div>
              <div class="text-xs text-gray-500 dark:text-gray-400 mt-1" x-text="serverConfig?.settings?.pvpReason"></div>
            </div>
          </div>
        </div>

        <!-- Success State -->
        <div x-show="stage === 'complete'" x-cloak class="bg-gradient-to-r from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-lg p-6 border-2 border-green-500">
          <div class="flex items-start space-x-4">
            <div class="flex-shrink-0">
              <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                Server Created Successfully!
              </h3>
              <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
                Your server is ready to go. Players can join at:
              </p>
              <div class="bg-white dark:bg-gray-900 rounded-lg p-4 font-mono text-sm">
                <span class="text-orange-600">play.quackhost.net:25565</span>
              </div>

              <div class="flex space-x-3 mt-4">
                <button class="bg-orange-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-orange-700 transition-colors">
                  Open QuackPlane
                </button>
                <button class="bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 px-4 py-2 rounded-lg text-sm font-semibold hover:border-orange-500 transition-colors">
                  Copy Server IP
                </button>
                <button
                  @click="reset(); prompt = ''"
                  class="text-gray-600 dark:text-gray-400 hover:text-orange-600 text-sm font-semibold"
                >
                  Create Another →
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Grid -->
  <div class="grid md:grid-cols-3 gap-6 mt-12">
    <div class="text-center">
      <div class="w-16 h-16 bg-purple-100 dark:bg-purple-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Under 2 Minutes</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        From idea to live server in under 2 minutes. No technical knowledge required.
      </p>
    </div>

    <div class="text-center">
      <div class="w-16 h-16 bg-orange-100 dark:bg-orange-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Smart Plugin Selection</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        AI analyzes your needs and selects the best plugins automatically.
      </p>
    </div>

    <div class="text-center">
      <div class="w-16 h-16 bg-green-100 dark:bg-green-900/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
        </svg>
      </div>
      <h3 class="font-semibold text-gray-900 dark:text-white mb-2">Optimized Configuration</h3>
      <p class="text-sm text-gray-600 dark:text-gray-400">
        Pre-configured with best practices for performance and security.
      </p>
    </div>
  </div>

  <!-- Info Box -->
  <div class="bg-gradient-to-r from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-lg p-6 mt-8 border border-blue-200 dark:border-blue-800">
    <div class="flex items-start space-x-4">
      <div class="flex-shrink-0">
        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <div class="flex-1">
        <h4 class="font-semibold text-gray-900 dark:text-white mb-1">
          How does QuackAI work?
        </h4>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          QuackAI uses advanced language models to understand your server requirements, analyze thousands of plugin combinations, and generate optimal configurations in seconds. It learns from millions of successful server deployments to provide the best setup for your needs.
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  [x-cloak] {
    display: none !important;
  }

  kbd {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  }
</style>
