---

---

<div
  x-data="{ cookieBanner: !localStorage.getItem('cookies-accepted'), showSettings: false }"
  x-show="cookieBanner"
  x-cloak
  class="fixed bottom-0 left-0 right-0 z-50 p-4 md:p-6 animate-slide-up"
  style="display: none;"
>
  <div class="max-w-7xl mx-auto">
    <!-- Main Cookie Banner -->
    <div
      x-show="!showSettings"
      class="bg-gradient-to-r from-gray-90 to-gray-100 rounded-2xl border border-gray-80 shadow-2xl p-6 md:p-8"
    >
      <div class="flex flex-col md:flex-row items-start md:items-center gap-6">
        <!-- Cookie Icon -->
        <div class="flex-shrink-0">
          <svg class="w-12 h-12 text-[#FF9C20]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M21.598 11.064a1.006 1.006 0 0 0-.854-.172A2.938 2.938 0 0 1 20 11c-1.654 0-3-1.346-3.003-2.937.005-.034.016-.136.017-.17a.998.998 0 0 0-1.254-1.006A2.963 2.963 0 0 1 15 7c-1.654 0-3-1.346-3-3 0-.217.031-.444.099-.716a1 1 0 0 0-1.067-1.236A9.956 9.956 0 0 0 2 12c0 5.514 4.486 10 10 10s10-4.486 10-10c0-.049-.003-.097-.007-.16a1.004 1.004 0 0 0-.395-.776zM8.5 6a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3zm-2 8a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm2.5-6.5a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0zm3.5 6.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
          </svg>
        </div>

        <!-- Content -->
        <div class="flex-1">
          <h3 class="text-xl font-bold text-white mb-2">We value your privacy</h3>
          <p class="text-cool-gray-40 text-sm">
            We use cookies to enhance your browsing experience, analyze site traffic, and personalize content.
            By clicking "Accept All", you consent to our use of cookies.
            <a href="/privacy-policy" class="text-[#FF9C20] hover:text-[#FF8D00] underline">Learn more</a>
          </p>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto">
          <button
            @click="showSettings = true"
            class="px-6 py-3 bg-gray-80 hover:bg-gray-70 text-white font-semibold rounded-lg transition-all duration-300 text-sm whitespace-nowrap"
          >
            Customize
          </button>
          <button
            @click="localStorage.setItem('cookies-accepted', 'essential'); cookieBanner = false"
            class="px-6 py-3 bg-gray-80 hover:bg-gray-70 text-white font-semibold rounded-lg transition-all duration-300 text-sm whitespace-nowrap"
          >
            Reject All
          </button>
          <button
            @click="localStorage.setItem('cookies-accepted', 'all'); cookieBanner = false"
            class="px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all duration-300 text-sm whitespace-nowrap"
          >
            Accept All
          </button>
        </div>
      </div>
    </div>

    <!-- Cookie Settings Panel -->
    <div
      x-show="showSettings"
      class="bg-gradient-to-r from-gray-90 to-gray-100 rounded-2xl border border-gray-80 shadow-2xl p-6 md:p-8"
      x-data="{
        essential: true,
        analytics: true,
        marketing: false
      }"
    >
      <div class="mb-6">
        <h3 class="text-2xl font-bold text-white mb-2">Cookie Preferences</h3>
        <p class="text-cool-gray-40 text-sm">
          Choose which cookies you want to accept. Essential cookies cannot be disabled.
        </p>
      </div>

      <div class="space-y-4 mb-6">
        <!-- Essential Cookies -->
        <div class="flex items-start gap-4 p-4 rounded-lg bg-gray-80/50">
          <input
            type="checkbox"
            :checked="essential"
            disabled
            class="mt-1 w-5 h-5 rounded border-gray-70 bg-gray-90 text-[#FF9C20] focus:ring-[#FF9C20] focus:ring-offset-0"
          />
          <div class="flex-1">
            <h4 class="text-white font-semibold mb-1">Essential Cookies</h4>
            <p class="text-cool-gray-40 text-sm">
              Required for the website to function properly. These cannot be disabled.
            </p>
          </div>
        </div>

        <!-- Analytics Cookies -->
        <div class="flex items-start gap-4 p-4 rounded-lg bg-gray-80/50">
          <input
            type="checkbox"
            x-model="analytics"
            class="mt-1 w-5 h-5 rounded border-gray-70 bg-gray-90 text-[#FF9C20] focus:ring-[#FF9C20] focus:ring-offset-0 cursor-pointer"
          />
          <div class="flex-1">
            <h4 class="text-white font-semibold mb-1">Analytics Cookies</h4>
            <p class="text-cool-gray-40 text-sm">
              Help us understand how visitors interact with our website to improve user experience.
            </p>
          </div>
        </div>

        <!-- Marketing Cookies -->
        <div class="flex items-start gap-4 p-4 rounded-lg bg-gray-80/50">
          <input
            type="checkbox"
            x-model="marketing"
            class="mt-1 w-5 h-5 rounded border-gray-70 bg-gray-90 text-[#FF9C20] focus:ring-[#FF9C20] focus:ring-offset-0 cursor-pointer"
          />
          <div class="flex-1">
            <h4 class="text-white font-semibold mb-1">Marketing Cookies</h4>
            <p class="text-cool-gray-40 text-sm">
              Used to track visitors across websites to display relevant advertisements.
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-end">
        <button
          @click="showSettings = false"
          class="px-6 py-3 bg-gray-80 hover:bg-gray-70 text-white font-semibold rounded-lg transition-all duration-300 text-sm"
        >
          Back
        </button>
        <button
          @click="localStorage.setItem('cookies-accepted', JSON.stringify({essential, analytics, marketing})); cookieBanner = false"
          class="px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all duration-300 text-sm"
        >
          Save Preferences
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }

  @keyframes slide-up {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .animate-slide-up {
    animation: slide-up 0.3s ease-out;
  }
</style>
