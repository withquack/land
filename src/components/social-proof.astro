---
// Social Proof & Real-Time Stats Component
// Shows live activity to build trust and create FOMO
---

<div
  class="bg-gradient-to-r from-cool-gray-90 to-cool-gray-100 border border-cool-gray-70 rounded-lg p-6 mb-8"
  x-data="{
    // Simulated real-time data (replace with actual API calls)
    serversOnline: 4782,
    playersOnline: 87234,
    uptime: 99.99,
    recentSignups: [
      { name: 'Alex M.', location: 'Texas', time: '2m ago', plan: 'Pro' },
      { name: 'Sarah K.', location: 'California', time: '5m ago', plan: 'Premium' },
      { name: 'Mike R.', location: 'New York', time: '8m ago', plan: 'Basic' },
      { name: 'Emma L.', location: 'Florida', time: '12m ago', plan: 'Pro' },
      { name: 'James P.', location: 'Canada', time: '15m ago', plan: 'Starter' }
    ],
    currentIndex: 0,
    init() {
      // Rotate through recent signups every 4 seconds
      setInterval(() => {
        this.currentIndex = (this.currentIndex + 1) % this.recentSignups.length;
      }, 4000);

      // Simulate live counter updates (small increments)
      setInterval(() => {
        if (Math.random() > 0.5) {
          this.playersOnline += Math.floor(Math.random() * 5);
        }
      }, 3000);
    },
    get currentSignup() {
      return this.recentSignups[this.currentIndex];
    }
  }"
>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <!-- Servers Online -->
    <div class="text-center">
      <div class="flex justify-center mb-2">
        <img src="/index/doodles/rocking chair.svg" alt="" width="32" height="32" />
      </div>
      <div class="text-3xl font-bold text-[#FF9C20] mb-1" x-text="serversOnline.toLocaleString()"></div>
      <div class="text-cool-gray-40 text-sm">Servers Online</div>
      <div class="text-green-50 text-xs mt-1">● Live</div>
    </div>

    <!-- Players Gaming -->
    <div class="text-center">
      <div class="flex justify-center mb-2">
        <img src="/index/doodles/joy leap 2.svg" alt="" width="32" height="32" />
      </div>
      <div class="text-3xl font-bold text-cyan-50 mb-1" x-text="playersOnline.toLocaleString()"></div>
      <div class="text-cool-gray-40 text-sm">Players Gaming</div>
      <div class="text-green-50 text-xs mt-1">● Live</div>
    </div>

    <!-- Uptime -->
    <div class="text-center">
      <div class="flex justify-center mb-2">
        <img src="/index/doodles/cycle.svg" alt="" width="32" height="32" class="animate-spin-slow" />
      </div>
      <div class="text-3xl font-bold text-green-50 mb-1" x-text="uptime + '%'"></div>
      <div class="text-cool-gray-40 text-sm">Uptime (30 days)</div>
      <a href="/service-status" class="text-blue-40 text-xs hover:underline">View Status →</a>
    </div>

    <!-- Recent Activity -->
    <div class="text-center">
      <div class="flex justify-center mb-2">
        <img src="/index/doodles/hand holding.svg" alt="" width="32" height="32" />
      </div>
      <div
        class="h-16 flex flex-col justify-center"
        x-show="currentSignup"
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 transform translate-y-2"
        x-transition:enter-end="opacity-100 transform translate-y-0"
      >
        <div class="text-sm font-semibold" x-text="currentSignup.name"></div>
        <div class="text-xs text-cool-gray-40" x-text="'from ' + currentSignup.location"></div>
        <div class="text-xs text-[#FF9C20]" x-text="'launched ' + currentSignup.plan + ' • ' + currentSignup.time"></div>
      </div>
    </div>
  </div>
</div>

<!-- Trust Indicators Banner -->
<div class="flex flex-wrap justify-center items-center gap-8 mb-16 text-cool-gray-40 text-sm">
  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
    </svg>
    <span>99.99% Uptime SLA</span>
  </div>

  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
    </svg>
    <span>DDoS Protected</span>
  </div>

  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
      <path d="M8.433 7.418c.155-.103.346-.196.567-.267v1.698a2.305 2.305 0 01-.567-.267C8.07 8.34 8 8.114 8 8c0-.114.07-.34.433-.582zM11 12.849v-1.698c.22.071.412.164.567.267.364.243.433.468.433.582 0 .114-.07.34-.433.582a2.305 2.305 0 01-.567.267z"></path>
      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-13a1 1 0 10-2 0v.092a4.535 4.535 0 00-1.676.662C6.602 6.234 6 7.009 6 8c0 .99.602 1.765 1.324 2.246.48.32 1.054.545 1.676.662v1.941c-.391-.127-.68-.317-.843-.504a1 1 0 10-1.51 1.31c.562.649 1.413 1.076 2.353 1.253V15a1 1 0 102 0v-.092a4.535 4.535 0 001.676-.662C13.398 13.766 14 12.991 14 12c0-.99-.602-1.765-1.324-2.246A4.535 4.535 0 0011 9.092V7.151c.391.127.68.317.843.504a1 1 0 101.511-1.31c-.563-.649-1.413-1.076-2.354-1.253V5z" clip-rule="evenodd"></path>
    </svg>
    <span>No Setup Fees</span>
  </div>

  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
    </svg>
    <span>24/7 Support</span>
  </div>

  <div class="flex items-center gap-2">
    <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
      <path d="M13 7H7v6h6V7z"></path>
      <path fill-rule="evenodd" d="M7 2a1 1 0 012 0v1h2V2a1 1 0 112 0v1h2a2 2 0 012 2v2h1a1 1 0 110 2h-1v2h1a1 1 0 110 2h-1v2a2 2 0 01-2 2h-2v1a1 1 0 11-2 0v-1H9v1a1 1 0 11-2 0v-1H5a2 2 0 01-2-2v-2H2a1 1 0 110-2h1V9H2a1 1 0 010-2h1V5a2 2 0 012-2h2V2zM5 5h10v10H5V5z" clip-rule="evenodd"></path>
    </svg>
    <span>Instant Provisioning</span>
  </div>
</div>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 3s linear infinite;
  }
</style>
