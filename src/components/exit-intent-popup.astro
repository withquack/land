---
// Exit Intent Popup Component
// Captures leaving users with a special offer
---

<div
  x-data="{
    showPopup: false,
    hasShown: false,
    email: '',
    submitted: false,
    init() {
      // Check if user has already seen the popup (using localStorage)
      if (localStorage.getItem('quack_exit_popup_shown')) {
        this.hasShown = true;
        return;
      }

      // Detect exit intent (mouse leaving viewport from top)
      document.addEventListener('mouseout', (e) => {
        if (!this.hasShown && !e.relatedTarget && e.clientY < 10) {
          this.showPopup = true;
          this.hasShown = true;
          localStorage.setItem('quack_exit_popup_shown', 'true');
        }
      });

      // Also trigger after 30 seconds as backup
      setTimeout(() => {
        if (!this.hasShown) {
          this.showPopup = true;
          this.hasShown = true;
          localStorage.setItem('quack_exit_popup_shown', 'true');
        }
      }, 30000);
    },
    closePopup() {
      this.showPopup = false;
    },
    handleSubmit() {
      if (this.email && this.email.includes('@')) {
        // TODO: Send to email marketing service (Mailchimp, ConvertKit, etc.)
        console.log('Email captured:', this.email);
        this.submitted = true;

        // Close popup after 2 seconds
        setTimeout(() => {
          this.showPopup = false;
        }, 2000);
      }
    }
  }"
  @keydown.escape.window="closePopup()"
>
  <!-- Popup Overlay -->
  <div
    x-show="showPopup"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    class="fixed inset-0 bg-black bg-opacity-75 z-50 flex items-center justify-center p-4"
    @click="closePopup()"
    x-cloak
  >
    <!-- Popup Content -->
    <div
      x-show="showPopup"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0 transform scale-90"
      x-transition:enter-end="opacity-100 transform scale-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100 transform scale-100"
      x-transition:leave-end="opacity-0 transform scale-90"
      @click.stop
      class="bg-cool-gray-100 border-2 border-[#FF9C20] rounded-lg max-w-lg w-full p-8 relative shadow-2xl"
    >
      <!-- Close Button -->
      <button
        @click="closePopup()"
        class="absolute top-4 right-4 text-cool-gray-40 hover:text-white transition-colors"
        aria-label="Close popup"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>

      <!-- Success State -->
      <div x-show="submitted" class="text-center py-8">
        <div class="text-6xl mb-4">🎉</div>
        <h3 class="text-2xl font-bold mb-3 text-green-50">You're in!</h3>
        <p class="text-cool-gray-40">
          Check your email for your exclusive 50% off code. We'll see you on the other side!
        </p>
      </div>

      <!-- Default State -->
      <div x-show="!submitted">
        <!-- Mascot + Headline -->
        <div class="text-center mb-6">
          <div class="flex justify-center mb-4">
            <img src="/mascot.svg" alt="QuackHost Mascot" class="w-20 h-20" />
          </div>
          <h3 class="text-3xl font-bold mb-2">
            <span class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
              Wait! Don't Leave Yet
            </span>
          </h3>
          <p class="text-xl text-cool-gray-40">
            Get <span class="text-[#FF9C20] font-bold">50% off</span> your first 3 months
          </p>
        </div>

        <!-- Benefits -->
        <div class="space-y-3 mb-6">
          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-50 flex items-center justify-center">
              <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-cool-gray-30">Server online in under 2 minutes</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-50 flex items-center justify-center">
              <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-cool-gray-30">99.99% uptime guarantee</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-50 flex items-center justify-center">
              <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-cool-gray-30">Terrabit-scale DDoS protection</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="flex-shrink-0 w-6 h-6 rounded-full bg-green-50 flex items-center justify-center">
              <svg class="w-4 h-4 text-black" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <span class="text-cool-gray-30">Cancel anytime, no contracts</span>
          </div>
        </div>

        <!-- Email Capture Form -->
        <form @submit.prevent="handleSubmit()" class="space-y-4">
          <div>
            <input
              type="email"
              x-model="email"
              placeholder="Enter your email"
              required
              class="w-full px-4 py-3 bg-cool-gray-90 border border-cool-gray-70 rounded text-white placeholder-cool-gray-50 focus:outline-none focus:border-[#FF9C20] transition-colors"
            />
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] hover:from-[#CC6600] hover:to-[#CC7000] text-black font-bold rounded transition-all duration-200 transform hover:scale-105"
          >
            Get My 50% Off Code →
          </button>
        </form>

        <div class="mt-4 text-center text-xs text-cool-gray-50">
          We respect your privacy. No spam, ever. Unsubscribe anytime.
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
