---

---

<footer class="bg-gradient-to-b from-gray-100 to-black border-t border-gray-80 mt-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Main Footer Content -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-12 mb-12">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <div class="flex items-center mb-4">
          <img src="/mascot.svg" loading="lazy" alt="GooseQuack" class="w-8 h-8 mr-3" />
          <span class="text-xl font-bold text-white">QuackHost</span>
        </div>
        <p class="text-cool-gray-40 text-sm mb-6">
          Unbeatable game server hosting with blazing performance and rock-solid reliability.
        </p>
        <!-- Social Links -->
        <div class="flex gap-4">
          <a href="/discord-flock" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-gray-90 border border-gray-80 flex items-center justify-center hover:border-purple-50 hover:bg-purple-50/10 transition-all duration-300 group">
            <svg class="w-5 h-5 text-cool-gray-40 group-hover:text-purple-40 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
            </svg>
          </a>
          <a href="https://twitter.com/quackhost" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-gray-90 border border-gray-80 flex items-center justify-center hover:border-cyan-50 hover:bg-cyan-50/10 transition-all duration-300 group">
            <svg class="w-5 h-5 text-cool-gray-40 group-hover:text-cyan-40 transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a href="https://github.com/quackhost" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-lg bg-gray-90 border border-gray-80 flex items-center justify-center hover:border-cool-gray-40 hover:bg-cool-gray-40/10 transition-all duration-300 group">
            <svg class="w-5 h-5 text-cool-gray-40 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Products Column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Products</h3>
        <ul class="space-y-3">
          <li><a href="/games" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Game Servers</a></li>
          <li><a href="/quackplane" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">QuackPlane Panel</a></li>
          <li><a href="/pricing" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Pricing</a></li>
          <li><a href="/#features" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Features</a></li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Resources</h3>
        <ul class="space-y-3">
          <li><a href="/guides-&-tutorials" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Guides & Tutorials</a></li>
          <li><a href="/service-status" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Service Status</a></li>
          <li><a href="/#faq" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">FAQ</a></li>
          <li><a href="/learn-more" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Documentation</a></li>
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Company</h3>
        <ul class="space-y-3">
          <li><a href="/#about" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">About Us</a></li>
          <li><a href="/#testimonials" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Testimonials</a></li>
          <li><a href="/discord-flock" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Community</a></li>
          <li><a href="/privacy-policy" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Privacy Policy</a></li>
          <li><a href="/terms-of-service" class="text-cool-gray-40 hover:text-[#FF9C20] transition-colors text-sm">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Newsletter Column -->
      <div>
        <h3 class="text-white font-semibold mb-4">Stay Updated</h3>
        <p class="text-cool-gray-40 text-sm mb-4">Get the latest updates, guides, and exclusive offers.</p>
        <form class="space-y-3" x-data="{ email: '' }" @submit.prevent="alert('Newsletter signup coming soon!')">
          <div class="relative">
            <input
              type="email"
              x-model="email"
              placeholder="Enter your email"
              class="w-full px-4 py-2.5 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors text-sm"
              required
            />
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2.5 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all duration-300 text-sm"
          >
            Subscribe
          </button>
        </form>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-gray-80">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <div class="flex items-center" x-data="{ currentYear: new Date().getFullYear() }">
          <p class="text-cool-gray-60 text-sm">
            © 2023-<span x-text="currentYear"></span> QuackHost. All Rights Reserved.
          </p>
        </div>

        <!-- Trust Badges -->
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-60 text-xs font-medium">SSL Secured</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-blue-40" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
              <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-60 text-xs font-medium">GDPR Compliant</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-purple-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-60 text-xs font-medium">DDoS Protected</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</footer>
