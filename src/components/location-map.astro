---
/**
 * Interactive Server Location Map Component
 *
 * Shows data center locations with latency indicators
 * Allows users to select their preferred location
 */

import { DATA_CENTERS } from '../config/pricing';
---

<div
  class="bg-cool-gray-90 border border-cool-gray-70 rounded-lg p-6"
  x-data="{
    selectedLocation: null,
    hoveredLocation: null,
    dataCenters: [],

    init() {
      this.dataCenters = this.$root.dataCenters;
      this.selectedLocation = this.dataCenters[0]?.id;
    },

    selectLocation(locationId) {
      this.selectedLocation = locationId;
      this.$dispatch('location-selected', { locationId });
    },

    getStatusBadge(status) {
      if (status === 'live') return { text: 'Live', color: 'green' };
      if (status === 'coming-soon') return { text: 'Coming Soon', color: 'blue' };
      return { text: 'Planned', color: 'gray' };
    }
  }"
  x-init="init()"
>
  <h3 class="text-2xl font-semibold mb-4 text-white flex items-center gap-3">
    <svg class="w-8 h-8 text-[#FF9C20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    Choose Your Server Location
  </h3>

  <p class="text-cool-gray-30 mb-6">
    Select the data center closest to your players for the best performance. Lower ping = better experience!
  </p>

  <!-- Simplified World Map Visualization -->
  <div class="relative bg-cool-gray-80 rounded-lg p-8 mb-6 overflow-hidden" style="min-height: 300px;">
    <!-- Decorative grid -->
    <div class="absolute inset-0 opacity-10">
      <svg width="100%" height="100%">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#FF9C20" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <!-- Location Markers -->
    <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-4">
      {DATA_CENTERS.map((dc) => (
        <button
          type="button"
          @click={`selectLocation('${dc.id}')`}
          @mouseenter={`hoveredLocation = '${dc.id}'`}
          @mouseleave="hoveredLocation = null"
          :class={`selectedLocation === '${dc.id}' ? 'bg-[#FF9C20] text-black border-[#FF9C20] shadow-lg shadow-[#FF9C20]/50' : 'bg-cool-gray-70 text-white border-cool-gray-60 hover:border-[#FF9C20] hover:shadow-lg'`}
          class="p-4 rounded-lg border-2 transition-all duration-200 text-left group"
        >
          <div class="flex items-start justify-between mb-2">
            <div>
              <div class="font-bold text-lg">{dc.city}</div>
              <div class="text-sm opacity-80">{dc.location}</div>
            </div>

            <!-- Status Badge -->
            <div
              class="text-xs px-2 py-1 rounded-full font-semibold"
              class:list={[
                dc.status === 'live' && 'bg-green-50 text-green-10',
                dc.status === 'coming-soon' && 'bg-blue-50 text-blue-10',
                dc.status === 'planned' && 'bg-cool-gray-60 text-cool-gray-20',
              ]}
            >
              {dc.status === 'live' ? '● Live' : dc.status === 'coming-soon' ? '○ Coming Soon' : '○ Planned'}
            </div>
          </div>

          {dc.estimatedLaunch && (
            <div class="text-xs opacity-70 mb-2">
              Launch: {dc.estimatedLaunch}
            </div>
          )}

          <!-- Latency Indicator -->
          <div class="flex items-center gap-2 text-xs opacity-80">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
            <span>Excellent: &lt;20ms · Good: &lt;50ms · OK: &lt;100ms</span>
          </div>

          <!-- Selection Indicator -->
          <div
            x-show={`selectedLocation === '${dc.id}'`}
            x-transition
            class="mt-3 pt-3 border-t border-current/20"
          >
            <div class="flex items-center gap-2 text-sm font-semibold">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
              </svg>
              Selected Location
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Location Details -->
  <template x-for="dc in dataCenters" :key="dc.id">
    <div
      x-show="selectedLocation === dc.id"
      x-transition
      class="bg-gradient-to-r from-[#FF9C20]/20 to-[#FF8D00]/20 border-2 border-[#FF9C20] rounded-lg p-5"
    >
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <h4 class="text-white font-semibold text-lg mb-2" x-text="`${dc.city}, ${dc.country}`"></h4>
          <div class="text-cool-gray-30 text-sm space-y-1">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <span x-text="`Location: ${dc.location}`"></span>
            </div>
            <div class="flex items-center gap-2" x-show="dc.status !== 'live'">
              <svg class="w-4 h-4 text-blue-40" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd" />
              </svg>
              <span x-text="`Estimated Launch: ${dc.estimatedLaunch}`"></span>
            </div>
          </div>
        </div>

        <div>
          <div class="text-white font-semibold mb-2">Coverage Zones</div>
          <div class="space-y-1 text-sm">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-green-50"></div>
              <span class="text-cool-gray-30">Excellent (&lt;20ms): <span class="text-white" x-text="`${dc.pingZones.excellent}km radius`"></span></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-blue-50"></div>
              <span class="text-cool-gray-30">Good (&lt;50ms): <span class="text-white" x-text="`${dc.pingZones.good}km radius`"></span></span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-yellow-30"></div>
              <span class="text-cool-gray-30">Acceptable (&lt;100ms): <span class="text-white" x-text="`${dc.pingZones.acceptable}km radius`"></span></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </template>

  <!-- Pro Tip -->
  <div class="mt-4 bg-blue-60/10 border border-blue-50 rounded-lg p-4">
    <div class="flex items-start gap-3">
      <svg class="w-6 h-6 text-blue-40 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
      </svg>
      <div class="flex-1">
        <div class="text-white font-semibold mb-1">💡 Pro Tip</div>
        <p class="text-sm text-cool-gray-30">
          Choose a location close to where most of your players are located. If you have players worldwide, consider starting in one region and adding more locations as you grow!
        </p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ dataCenters: DATA_CENTERS }}>
  // Make data centers available to Alpine
  document.addEventListener('alpine:init', () => {
    Alpine.data('dataCenters', () => dataCenters);
  });
</script>
