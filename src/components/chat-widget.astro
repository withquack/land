---

---

<div
  x-data="{ chatOpen: false, minimized: true }"
  class="fixed bottom-6 right-6 z-40"
>
  <!-- Chat Button -->
  <button
    @click="chatOpen = !chatOpen; minimized = false"
    x-show="!chatOpen"
    class="group w-16 h-16 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] rounded-full shadow-2xl hover:shadow-[#FF9C20]/50 flex items-center justify-center transition-all duration-300 hover:scale-110 transform"
    aria-label="Open chat support"
  >
    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
    </svg>
    <!-- Notification Badge -->
    <span class="absolute -top-1 -right-1 w-5 h-5 bg-red-50 text-white text-xs font-bold rounded-full flex items-center justify-center animate-pulse">1</span>
  </button>

  <!-- Chat Window -->
  <div
    x-show="chatOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 transform translate-y-4"
    x-transition:enter-end="opacity-100 transform translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 transform translate-y-0"
    x-transition:leave-end="opacity-0 transform translate-y-4"
    class="w-96 bg-gradient-to-br from-gray-90 to-gray-100 rounded-2xl shadow-2xl border border-gray-80 overflow-hidden"
    style="display: none;"
    x-cloak
  >
    <!-- Chat Header -->
    <div class="bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] p-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative">
          <img src="/mascot.svg" alt="Support" class="w-10 h-10 rounded-full bg-white p-1" />
          <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-40 border-2 border-white rounded-full"></span>
        </div>
        <div>
          <h3 class="font-bold text-white">QuackSupport</h3>
          <p class="text-xs text-white/80">Typically replies instantly</p>
        </div>
      </div>
      <button
        @click="chatOpen = false"
        class="text-white hover:bg-white/20 rounded-lg p-2 transition-colors"
        aria-label="Close chat"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Chat Messages -->
    <div class="h-96 overflow-y-auto p-4 space-y-4">
      <!-- Bot Message -->
      <div class="flex items-start gap-3">
        <img src="/mascot.svg" alt="Bot" class="w-8 h-8 rounded-full bg-white p-1 flex-shrink-0" />
        <div class="bg-gray-80 rounded-2xl rounded-tl-sm p-4 max-w-[80%]">
          <p class="text-white text-sm">
            Hey there! 👋 Welcome to QuackHost!
          </p>
          <p class="text-white text-sm mt-2">
            I'm here to help you get started with the best game server hosting. How can I assist you today?
          </p>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="flex flex-col gap-2 pl-11">
        <button class="bg-gray-80 hover:bg-gray-70 text-white px-4 py-3 rounded-lg text-sm text-left transition-colors">
          🚀 I want to launch a server
        </button>
        <button class="bg-gray-80 hover:bg-gray-70 text-white px-4 py-3 rounded-lg text-sm text-left transition-colors">
          💰 Questions about pricing
        </button>
        <button class="bg-gray-80 hover:bg-gray-70 text-white px-4 py-3 rounded-lg text-sm text-left transition-colors">
          🎮 Supported games
        </button>
        <button class="bg-gray-80 hover:bg-gray-70 text-white px-4 py-3 rounded-lg text-sm text-left transition-colors">
          🔧 Technical support
        </button>
      </div>

      <!-- Info Message -->
      <div class="flex items-start gap-3">
        <img src="/mascot.svg" alt="Bot" class="w-8 h-8 rounded-full bg-white p-1 flex-shrink-0" />
        <div class="bg-gray-80 rounded-2xl rounded-tl-sm p-4 max-w-[80%]">
          <p class="text-white text-sm">
            Or connect with us on <a href="/discord-flock" class="text-[#FF9C20] hover:text-[#FF8D00] font-semibold underline">Discord</a> for instant community support! 🦆
          </p>
        </div>
      </div>
    </div>

    <!-- Chat Input -->
    <div class="p-4 border-t border-gray-80">
      <form class="flex gap-2" @submit.prevent="alert('Chat integration coming soon! Join our Discord for instant support.')">
        <input
          type="text"
          placeholder="Type your message..."
          class="flex-1 px-4 py-3 bg-gray-80 border border-gray-70 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors text-sm"
        />
        <button
          type="submit"
          class="px-4 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all duration-300 flex-shrink-0"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
          </svg>
        </button>
      </form>
      <p class="text-cool-gray-60 text-xs mt-2 text-center">
        Live support available 24/7
      </p>
    </div>
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
</style>
