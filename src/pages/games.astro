---
import Layout from "../layouts/layout.astro";

const games = [
  {
    id: 'minecraft-java',
    name: 'Minecraft Java Edition',
    status: 'available',
    description: 'The original Minecraft experience with unlimited modding possibilities',
    players: '12.5K+ servers',
    versions: '1.8.x - 1.20.x',
    icon: '⛏️',
    color: 'green',
    features: ['Plugins', 'Mods', 'Custom Worlds', 'Resource Packs']
  },
  {
    id: 'minecraft-bedrock',
    name: 'Minecraft Bedrock',
    status: 'available',
    description: 'Cross-platform Minecraft for PC, mobile, and console players',
    players: '3.2K+ servers',
    versions: 'Latest',
    icon: '📱',
    color: 'blue',
    features: ['Cross-platform', 'Mobile Support', 'Add-ons', 'Realms']
  },
  {
    id: 'valheim',
    name: 'Valheim',
    status: 'available',
    description: 'Viking survival adventure with epic boss battles and exploration',
    players: '890 servers',
