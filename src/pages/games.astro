  },
  {
    id: 'terraria',
    name: 'Terraria',
    status: 'available',
    description: '2D sandbox adventure with crafting, building, and combat',
    players: '1.2K+ servers',
    versions: '1.4.x',
    icon: '🌳',
    color: 'green',
    features: ['Multiplayer', 'Modding', 'Adventure', 'Building']
  },
  {
    id: 'ark',
    name: 'ARK: Survival Evolved',
    status: 'available',
    description: 'Dinosaur survival with taming, breeding, and massive world',
    players: '2.1K+ servers',
    versions: 'Latest',
    icon: '🦖',
    color: 'orange',
    features: ['Dinosaurs', 'Taming', 'PvP/PvE', 'Tribes']
  },
  {
    id: 'rust',
    name: 'Rust',
    status: 'available',
    description: 'Hardcore survival multiplayer with building and raiding',
    players: '4.5K+ servers',
    versions: 'Latest',
    icon: '🔧',
    color: 'red',
    features: ['Hardcore', 'Building', 'Raiding', 'PvP']
  },
  {
    id: 'vrising',
    name: 'V Rising',
    status: 'coming-soon',
    description: 'Vampire survival game with castle building and blood hunting',
    players: 'Coming Soon',
    versions: 'TBA',
    icon: '🧛',
    color: 'purple',
    features: ['Vampires', 'Castle Building', 'PvP', 'Co-op']
  },
  {
    id: 'palworld',
    name: 'Palworld',
    status: 'coming-soon',
    description: 'Creature collecting survival with base automation',
    players: 'Coming Soon',
    versions: 'TBA',
    icon: '🐾',
    color: 'blue',
    features: ['Creature Collecting', 'Automation', 'Co-op', 'Building']
  },
  {
    id: 'fivem',
    name: 'FiveM (GTA V)',
    status: 'coming-soon',
    description: 'GTA V multiplayer modification with custom servers and roleplay',
    players: 'Coming Soon',
    versions: 'TBA',
    icon: '🚗',
    color: 'orange',
    features: ['Roleplay', 'Custom Scripts', 'Vehicles', 'Jobs']
  },
  {
    id: 'discord',
    name: 'Discord Bots',
    status: 'beta',
    description: 'Host your Discord bots with 24/7 uptime and auto-restart',
    players: '250+ bots',
    versions: 'All languages',
    icon: '🤖',
    color: 'blue',
    features: ['24/7 Uptime', 'Auto-restart', 'Logs', 'Multiple Languages']
  },
  {
    id: 'csgo',
    name: 'Counter-Strike 2',
    status: 'coming-soon',
    description: 'Competitive FPS with custom game modes and maps',
    players: 'Coming Soon',
    versions: 'TBA',
    icon: '🔫',
