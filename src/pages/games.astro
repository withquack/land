---

<Layout title="/ Games">
  <div class="mb-16 mt-32">
    <h1 class="text-4xl font-bold xl:text-6xl mb-4">Supported Games</h1>
    <p class="text-xl text-gray-600">Host any game server with QuackHost. Request new games anytime.</p>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-16 max-w-4xl mx-auto">
    <div class="text-center bg-white rounded-lg shadow-md p-6">
      <div class="text-3xl font-bold text-green-600">6</div>
      <div class="text-gray-600 text-sm">Games Available</div>
    </div>
    <div class="text-center bg-white rounded-lg shadow-md p-6">
      <div class="text-3xl font-bold text-blue-600">4</div>
      <div class="text-gray-600 text-sm">Coming Soon</div>
    </div>
    <div class="text-center bg-white rounded-lg shadow-md p-6">
      <div class="text-3xl font-bold text-orange-600">24K+</div>
      <div class="text-gray-600 text-sm">Active Servers</div>
    </div>
    <div class="text-center bg-white rounded-lg shadow-md p-6">
      <div class="text-3xl font-bold text-purple-600">1</div>
      <div class="text-gray-600 text-sm">Control Panel</div>
    </div>
  </div>

  <!-- Filter Tabs -->
  <div
    x-data="{
      filter: 'all',
      games: ${JSON.stringify(games)},
      get filteredGames() {
        if (this.filter === 'all') return this.games;
        if (this.filter === 'available') return this.games.filter(g => g.status === 'available');
        if (this.filter === 'coming-soon') return this.games.filter(g => g.status === 'coming-soon' || g.status === 'beta');
        return this.games;
      }
    }"
  >
    <div class="flex justify-center gap-4 mb-12">
      <button
        @click="filter = 'all'"
        :class="filter === 'all' ? 'bg-orange-500 text-white' : 'bg-gray-100 text-gray-700'"
        class="px-6 py-3 rounded-lg font-semibold transition-all"
      >
        All Games
      </button>
      <button
        @click="filter = 'available'"
        :class="filter === 'available' ? 'bg-green-500 text-white' : 'bg-gray-100 text-gray-700'"
        class="px-6 py-3 rounded-lg font-semibold transition-all"
      >
        Available Now
      </button>
      <button
        @click="filter = 'coming-soon'"
        :class="filter === 'coming-soon' ? 'bg-blue-500 text-white' : 'bg-gray-100 text-gray-700'"
        class="px-6 py-3 rounded-lg font-semibold transition-all"
      >
        Coming Soon
      </button>
    </div>

    <!-- Games Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <template x-for="game in filteredGames" :key="game.id">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all transform hover:-translate-y-1">
          <!-- Game Header -->
          <div
            class="h-32 bg-gradient-to-br relative flex items-center justify-center"
            :class="{
              'from-green-400 to-green-600': game.color === 'green',
              'from-blue-400 to-blue-600': game.color === 'blue',
              'from-purple-400 to-purple-600': game.color === 'purple',
              'from-orange-400 to-orange-600': game.color === 'orange',
              'from-red-400 to-red-600': game.color === 'red',
              'from-gray-400 to-gray-600': game.color === 'gray'
            }"
          >
            <div class="text-7xl" x-text="game.icon"></div>

            <!-- Status Badge -->
            <div class="absolute top-4 right-4">
              <span
                class="px-3 py-1 rounded-full text-xs font-bold uppercase"
                :class="{
                  'bg-green-500 text-white': game.status === 'available',
                  'bg-blue-500 text-white': game.status === 'coming-soon',
                  'bg-yellow-500 text-white': game.status === 'beta',
                  'bg-gray-500 text-white': game.status === 'request'
                }"
                x-text="game.status === 'available' ? 'Available' : game.status === 'coming-soon' ? 'Coming Soon' : game.status === 'beta' ? 'Beta' : 'Request'"
              ></span>
            </div>
          </div>

          <!-- Game Info -->
          <div class="p-6">
            <h3 class="text-2xl font-bold mb-2" x-text="game.name"></h3>
            <p class="text-gray-600 text-sm mb-4" x-text="game.description"></p>

            <!-- Game Details -->
            <div class="space-y-2 mb-4 text-sm">
              <div class="flex justify-between">
                <span class="text-gray-500">Active Servers:</span>
                <span class="font-semibold" x-text="game.players"></span>
              </div>
              <div class="flex justify-between">
                <span class="text-gray-500">Versions:</span>
                <span class="font-semibold" x-text="game.versions"></span>
              </div>
            </div>

            <!-- Features -->
            <div class="mb-4">
              <div class="flex flex-wrap gap-2">
                <template x-for="feature in game.features" :key="feature">
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-xs font-semibold" x-text="feature"></span>
                </template>
              </div>
            </div>

            <!-- Action Button -->
            <template x-if="game.status === 'available' || game.status === 'beta'">
              <a
                href="/templates"
                class="block w-full bg-orange-500 text-white text-center py-3 rounded-lg font-bold hover:bg-orange-600 transition-all"
              >
                Browse Templates
              </a>
            </template>
            <template x-if="game.status === 'coming-soon'">
              <button class="block w-full bg-gray-300 text-gray-700 text-center py-3 rounded-lg font-bold cursor-not-allowed">
                Coming Soon
              </button>
            </template>
            <template x-if="game.status === 'request'">
              <a
                href="#request-game"
                class="block w-full bg-purple-500 text-white text-center py-3 rounded-lg font-bold hover:bg-purple-600 transition-all"
              >
                Request Game
              </a>
            </template>
          </div>
        </div>
      </template>
    </div>
  </div>

  <!-- Request New Game Section -->
  <div id="request-game" class="mt-24 bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl p-12 text-white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-4xl font-bold text-center mb-4">Don't see your game?</h2>
      <p class="text-xl text-center mb-8 opacity-90">We're constantly adding new games. Request support for any multiplayer game!</p>

      <div class="bg-white rounded-xl p-8 text-gray-900">
        <form class="space-y-4">
          <div>
            <label class="block font-semibold mb-2">Game Name</label>
            <input
              type="text"
              placeholder="e.g., Satisfactory, 7 Days to Die"
              class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:border-purple-500 focus:outline-none"
            />
          </div>

          <div>
            <label class="block font-semibold mb-2">Why do you want this game?</label>
            <textarea
              placeholder="Tell us why you'd like to host this game and how many players you expect..."
              rows="4"
              class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:border-purple-500 focus:outline-none"
            ></textarea>
          </div>

          <div>
            <label class="block font-semibold mb-2">Your Email</label>
            <input
              type="email"
              placeholder="you@example.com"
              class="w-full px-4 py-3 rounded-lg border-2 border-gray-200 focus:border-purple-500 focus:outline-none"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-purple-500 text-white py-4 rounded-lg font-bold hover:bg-purple-600 transition-all"
          >
            Submit Request
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Why Choose QuackHost -->
  <div class="mt-24">
    <h2 class="text-3xl font-bold text-center mb-12">Why Choose QuackHost for Your Game Server?</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="font-bold mb-2">Instant Setup</h3>
        <p class="text-gray-600 text-sm">Launch any game server in under 60 seconds</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="font-bold mb-2">DDoS Protection</h3>
        <p class="text-gray-600 text-sm">Terrabit-scale protection on all servers</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path>
          </svg>
        </div>
        <h3 class="font-bold mb-2">Auto Backups</h3>
        <p class="text-gray-600 text-sm">Never lose your progress with automatic backups</p>
      </div>

      <div class="text-center">
        <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
        <h3 class="font-bold mb-2">Easy Scaling</h3>
        <p class="text-gray-600 text-sm">Upgrade or downgrade anytime with one click</p>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <div class="mt-24 bg-gradient-to-r from-orange-500 to-purple-500 rounded-2xl p-12 text-center text-white">
    <h2 class="text-4xl font-bold mb-4">Ready to launch your game server?</h2>
    <p class="text-xl mb-8 opacity-90">Join thousands of gamers hosting with QuackHost</p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/templates" class="bg-white text-orange-600 px-8 py-4 rounded-lg font-bold hover:bg-gray-100 transition-all">
        Browse Templates
      </a>
      <a href="/pricing" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-white hover:text-orange-600 transition-all">
        View Pricing
      </a>
    </div>
  </div>
</Layout>
