---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Learn More">
  <!-- Hero Section -->
  <div class="mb-20 mt-16 lg:mt-32">
    <div class="text-center mb-12">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-purple-50/20 to-cyan-50/20 border border-purple-50/50 rounded-full">
        <span class="text-purple-50 font-bold text-sm">GAME HOSTING EXPLAINED</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        Everything you need to know about <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">game hosting</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto">
        From the basics to advanced features, learn how QuackHost makes game server hosting simple, powerful, and affordable.
      </p>
    </div>
  </div>

  <!-- What is Game Hosting -->
  <div class="mb-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
          What is <span class="text-[#FF9C20]">game hosting?</span>
        </h2>
        <div class="space-y-4 text-cool-gray-20 text-lg">
          <p>
            Game hosting is a service that provides dedicated servers for multiplayer games. Instead of running a server on your personal computer, you rent powerful hardware in professional data centers.
          </p>
          <p>
            This means your game server is online 24/7, loads faster, handles more players, and doesn't impact your home internet or electricity bill.
          </p>
          <p>
            QuackHost specializes in making game hosting accessible to everyone - whether you're running a private server for friends or a massive public community.
          </p>
        </div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8">
        <div class="space-y-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-[#FF9C20]/20 flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🚀</span>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">Always Online</h3>
              <p class="text-cool-gray-20">Your server runs 24/7 in our data centers, even when your computer is off.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-cyan-50/20 flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">⚡</span>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">High Performance</h3>
              <p class="text-cool-gray-20">Enterprise-grade hardware ensures smooth gameplay with zero lag.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 rounded-full bg-purple-50/20 flex items-center justify-center flex-shrink-0">
              <span class="text-2xl">🛡️</span>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-2">DDoS Protected</h3>
              <p class="text-cool-gray-20">Advanced protection keeps your server safe from attacks.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- How It Works -->
  <div class="mb-20">
    <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
      How QuackHost <span class="text-[#FF9C20]">works</span>
    </h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] flex items-center justify-center">
          <span class="text-2xl font-bold text-black">1</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Choose Your Game</h3>
        <p class="text-cool-gray-20">
          Select from 50+ supported games including Minecraft, Rust, ARK, Valheim, and more.
        </p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-cyan-50 to-purple-50 flex items-center justify-center">
          <span class="text-2xl font-bold text-black">2</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Pick Your Plan</h3>
        <p class="text-cool-gray-20">
          Choose the perfect amount of RAM and storage based on your player count and needs.
        </p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-purple-50 to-[#FF9C20] flex items-center justify-center">
          <span class="text-2xl font-bold text-black">3</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Instant Setup</h3>
        <p class="text-cool-gray-20">
          Your server deploys automatically within seconds. No technical knowledge required.
        </p>
      </div>
      <div class="text-center">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-green-50 to-cyan-50 flex items-center justify-center">
          <span class="text-2xl font-bold text-black">4</span>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Start Playing</h3>
        <p class="text-cool-gray-20">
          Invite friends, install mods, and customize your server through QuackPlane.
        </p>
      </div>
    </div>
  </div>

  <!-- Why Choose QuackHost -->
  <div class="mb-20">
    <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Why choose <span class="text-[#FF9C20]">QuackHost?</span>
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div>
          <div class="text-4xl mb-4">💰</div>
          <h3 class="text-xl font-bold text-white mb-3">Affordable Pricing</h3>
          <p class="text-cool-gray-20">
            Starting at just $3/month with no hidden fees. Pay only for what you use.
          </p>
        </div>
        <div>
          <div class="text-4xl mb-4">🎮</div>
          <h3 class="text-xl font-bold text-white mb-3">50+ Games Supported</h3>
          <p class="text-cool-gray-20">
            From indie hits to AAA titles, we support all the most popular multiplayer games.
          </p>
        </div>
        <div>
          <div class="text-4xl mb-4">⚙️</div>
          <h3 class="text-xl font-bold text-white mb-3">Full Control</h3>
          <p class="text-cool-gray-20">
            Complete FTP access, mod support, and custom configurations for power users.
          </p>
        </div>
        <div>
          <div class="text-4xl mb-4">📱</div>
          <h3 class="text-xl font-bold text-white mb-3">Mobile App Ready</h3>
          <p class="text-cool-gray-20">
            Manage your server from anywhere with QuackPlane's responsive interface.
          </p>
        </div>
        <div>
          <div class="text-4xl mb-4">🔄</div>
          <h3 class="text-xl font-bold text-white mb-3">Automatic Backups</h3>
          <p class="text-cool-gray-20">
            Daily backups keep your world safe. One-click restore if anything goes wrong.
          </p>
        </div>
        <div>
          <div class="text-4xl mb-4">💬</div>
          <h3 class="text-xl font-bold text-white mb-3">24/7 Support</h3>
          <p class="text-cool-gray-20">
            Expert support team available around the clock via Discord and tickets.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Technical Specs -->
  <div class="mb-20">
    <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
      Enterprise-grade <span class="text-[#FF9C20]">infrastructure</span>
    </h2>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8">
        <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
          <span class="text-3xl">🖥️</span>
          Hardware
        </h3>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">AMD Ryzen 9 7950X CPUs</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">DDR5 5600MHz RAM</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">NVMe Gen4 SSDs</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">10Gbps network uplinks</span>
          </div>
        </div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8">
        <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
          <span class="text-3xl">🌍</span>
          Global Network
        </h3>
        <div class="space-y-4">
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">US, EU, and APAC locations</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">99.9% uptime SLA</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">Enterprise DDoS protection</span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-5 h-5 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span class="text-cool-gray-20">Redundant power & cooling</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div class="mb-20">
    <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
      Common <span class="text-[#FF9C20]">questions</span>
    </h2>
    <div class="max-w-3xl mx-auto space-y-4" x-data="{ activeQ: null }">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
        <button
          @click="activeQ = activeQ === 1 ? null : 1"
          class="w-full p-6 text-left flex items-center justify-between hover:bg-gray-85 transition-colors"
        >
          <span class="text-lg font-semibold text-white">Do I need technical knowledge to run a server?</span>
          <svg class="w-5 h-5 text-cool-gray-30 transition-transform" :class="activeQ === 1 ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="activeQ === 1" x-transition class="px-6 pb-6">
          <p class="text-cool-gray-20">
            Not at all! QuackHost is designed for everyone. Our one-click installer sets up your server automatically, and QuackPlane makes management simple with its intuitive interface. We also have extensive guides and 24/7 support if you need help.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
        <button
          @click="activeQ = activeQ === 2 ? null : 2"
          class="w-full p-6 text-left flex items-center justify-between hover:bg-gray-85 transition-colors"
        >
          <span class="text-lg font-semibold text-white">Can I install mods and plugins?</span>
          <svg class="w-5 h-5 text-cool-gray-30 transition-transform" :class="activeQ === 2 ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="activeQ === 2" x-transition class="px-6 pb-6">
          <p class="text-cool-gray-20">
            Absolutely! You have full FTP access and can install any mods, plugins, or custom configurations you want. QuackPlane includes a built-in file manager, and we support popular mod loaders like Forge, Fabric, Paper, and more.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
        <button
          @click="activeQ = activeQ === 3 ? null : 3"
          class="w-full p-6 text-left flex items-center justify-between hover:bg-gray-85 transition-colors"
        >
          <span class="text-lg font-semibold text-white">How many players can my server handle?</span>
          <svg class="w-5 h-5 text-cool-gray-30 transition-transform" :class="activeQ === 3 ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="activeQ === 3" x-transition class="px-6 pb-6">
          <p class="text-cool-gray-20">
            It depends on your plan and game type. Generally, our Duck plan (2GB RAM) handles 10-20 players for vanilla games, while our Swan plan (8GB RAM) can support 50+ players. Modded servers require more resources. Use our pricing calculator for personalized recommendations.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
        <button
          @click="activeQ = activeQ === 4 ? null : 4"
          class="w-full p-6 text-left flex items-center justify-between hover:bg-gray-85 transition-colors"
        >
          <span class="text-lg font-semibold text-white">Can I upgrade or downgrade my plan?</span>
          <svg class="w-5 h-5 text-cool-gray-30 transition-transform" :class="activeQ === 4 ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="activeQ === 4" x-transition class="px-6 pb-6">
          <p class="text-cool-gray-20">
            Yes! You can upgrade or downgrade your server at any time through QuackPlane. Changes take effect immediately, and billing is prorated automatically. Scale up for big events or scale down during quiet periods.
          </p>
        </div>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
        <button
          @click="activeQ = activeQ === 5 ? null : 5"
          class="w-full p-6 text-left flex items-center justify-between hover:bg-gray-85 transition-colors"
        >
          <span class="text-lg font-semibold text-white">What happens to my data if I cancel?</span>
          <svg class="w-5 h-5 text-cool-gray-30 transition-transform" :class="activeQ === 5 ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </button>
        <div x-show="activeQ === 5" x-transition class="px-6 pb-6">
          <p class="text-cool-gray-20">
            You can download a full backup of your server files at any time through QuackPlane. After cancellation, we keep your data for 7 days in case you change your mind. After that, the server and its data are permanently deleted.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="mb-20">
    <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-12 lg:p-16 text-center">
      <h2 class="text-3xl lg:text-5xl font-bold text-black mb-6">
        Ready to start your adventure?
      </h2>
      <p class="text-xl text-gray-90 mb-8 max-w-2xl mx-auto">
        Join thousands of gamers already hosting with QuackHost. Get your server online in under 60 seconds.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/pricing"
          class="px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-gray-90 transition-all hover:scale-105"
        >
          View Pricing
        </a>
        <a
          href="/games"
          class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-100 transition-all hover:scale-105"
        >
          Browse Games
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  Alpine.start();
</script>
