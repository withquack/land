---

<Layout title="/ Deployment Index">
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-semibold mb-4">
      <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
        Deployment Index
      </span>
    </h1>
    <p class="text-cool-gray-40 text-lg">
      Browse all Cloudflare Pages deployments across different branches and iterations.
    </p>
    <p class="text-cool-gray-50 text-sm mt-2">
      Last updated: November 16, 2025
    </p>
  </div>

  {deployments.map((category) => (
    <div class="mb-12">
      <h2 class="text-2xl font-semibold mb-4 border-b border-cool-gray-70 pb-2">
        {category.category}
        <span class="text-cool-gray-50 text-lg ml-2">({category.items.length})</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {category.items.map((deployment) => (
          <a
            href={deployment.url}
            target="_blank"
            rel="noopener noreferrer"
            class="block p-4 bg-cool-gray-90 hover:bg-cool-gray-80 border border-cool-gray-70 hover:border-[#FF9C20] transition-all duration-200 group"
          >
            <div class="flex items-start justify-between mb-2">
              <h3 class="text-white font-semibold text-sm group-hover:text-[#FF9C20] transition-colors flex-1">
                {deployment.name}
              </h3>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-cool-gray-50 group-hover:text-[#FF9C20] flex-shrink-0 ml-2"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </div>
            <div class="text-cool-gray-50 text-xs font-mono mb-1">
              {deployment.commit}
            </div>
            <div class="text-cool-gray-60 text-xs break-all">
              {deployment.url.replace('https://', '')}
            </div>
          </a>
        ))}
      </div>
    </div>
  ))}

  <div class="mt-16 p-6 bg-cool-gray-90 border border-cool-gray-70">
    <h3 class="text-xl font-semibold mb-2">About This Index</h3>
    <p class="text-cool-gray-40 leading-relaxed mb-2">
      This page provides quick access to all live Cloudflare Pages deployments. Each link opens in a new tab for easy comparison between different iterations.
    </p>
    <p class="text-cool-gray-50 text-sm">
      Total deployments: <strong class="text-white">{deployments.reduce((acc, cat) => acc + cat.items.length, 0)}</strong>
    </p>
  </div>

  <style>
    /* Custom scrollbar for better aesthetics */
    ::-webkit-scrollbar {
      width: 8px;
    }

    ::-webkit-scrollbar-track {
      background: #1a1a1a;
    }

    ::-webkit-scrollbar-thumb {
      background: #FF9C20;
      border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
      background: #FF8D00;
    }
  </style>

  <script is:inline>
    // Note: Opening links in background tabs is controlled by browser behavior
    // Ctrl+Click or Cmd+Click will open in background, regular click may open in foreground
    // Links open in new tabs via target="_blank"
  </script>
</Layout>
