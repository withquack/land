---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Contact Us">
  <div class="max-w-6xl mx-auto">
    <!-- Hero Section -->
    <div class="mb-16 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-green-50/20 to-cyan-50/20 border border-green-50/50 rounded-full">
        <span class="text-green-50 font-bold text-sm">GET IN TOUCH</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        We're here to <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">help</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto">
        Get expert support 24/7. Our team of gaming enthusiasts is ready to help you with any questions or issues.
      </p>
    </div>

    <!-- Contact Methods Grid -->
    <div class="grid md:grid-cols-3 gap-8 mb-20">
      <!-- Discord -->
      <a href="/discord-flock" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-purple-50 transition-all hover:-translate-y-1">
        <div class="flex items-center justify-center w-16 h-16 rounded-full bg-purple-50/20 mb-6 group-hover:bg-purple-50/30 transition-all">
          <svg class="w-8 h-8 text-purple-40" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515a.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0a12.64 12.64 0 0 0-.617-1.25a.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057a19.9 19.9 0 0 0 5.993 3.03a.078.078 0 0 0 .084-.028a14.09 14.09 0 0 0 1.226-1.994a.076.076 0 0 0-.041-.106a13.107 13.107 0 0 1-1.872-.892a.077.077 0 0 1-.008-.128a10.2 10.2 0 0 0 .372-.292a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127a12.299 12.299 0 0 1-1.873.892a.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028a19.839 19.839 0 0 0 6.002-3.03a.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.956-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419c0-1.333.955-2.419 2.157-2.419c1.21 0 2.176 1.096 2.157 2.42c0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Discord Community</h3>
        <p class="text-cool-gray-20 mb-4">
          Join 10,000+ gamers in our Discord server. Get instant help from our community and staff.
        </p>
        <div class="flex items-center text-purple-40 font-semibold group-hover:underline">
          Join Discord
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </div>
      </a>

      <!-- Email Support -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-[#FF9C20] transition-all">
        <div class="flex items-center justify-center w-16 h-16 rounded-full bg-[#FF9C20]/20 mb-6">
          <svg class="w-8 h-8 text-[#FF9C20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Email Support</h3>
        <p class="text-cool-gray-20 mb-4">
          Send us a detailed message and we'll respond within 24 hours.
        </p>
        <a href="mailto:support@quack.host" class="text-[#FF9C20] font-semibold hover:underline">
          support@quack.host
        </a>
      </div>

      <!-- Ticket System -->
      <a href="https://client.quack.host" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-cyan-50 transition-all hover:-translate-y-1">
        <div class="flex items-center justify-center w-16 h-16 rounded-full bg-cyan-50/20 mb-6 group-hover:bg-cyan-50/30 transition-all">
          <svg class="w-8 h-8 text-cyan-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
          </svg>
        </div>
        <h3 class="text-2xl font-bold text-white mb-3">Support Tickets</h3>
        <p class="text-cool-gray-20 mb-4">
          Open a priority ticket through our client portal for account-specific issues.
        </p>
        <div class="flex items-center text-cyan-40 font-semibold group-hover:underline">
          Open Ticket
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </div>
      </a>
    </div>

    <!-- Contact Form -->
    <div class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12">
        <h2 class="text-3xl font-bold text-white mb-6 text-center">Send us a message</h2>
        <form
          x-data="{
            name: '',
            email: '',
            subject: '',
            message: '',
            category: 'general'
          }"
          @submit.prevent="alert('Thank you for your message! Our team will respond within 24 hours.')"
          class="max-w-3xl mx-auto space-y-6"
        >
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-white font-semibold mb-2">Name *</label>
              <input
                type="text"
                id="name"
                x-model="name"
                required
                class="w-full px-4 py-3 bg-gray-100 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block text-white font-semibold mb-2">Email *</label>
              <input
                type="email"
                id="email"
                x-model="email"
                required
                class="w-full px-4 py-3 bg-gray-100 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                placeholder="your@email.com"
              />
            </div>
          </div>

          <div>
            <label for="category" class="block text-white font-semibold mb-2">Category *</label>
            <select
              id="category"
              x-model="category"
              required
              class="w-full px-4 py-3 bg-gray-100 border border-gray-80 rounded-lg text-white focus:outline-none focus:border-[#FF9C20] transition-colors"
            >
              <option value="general">General Inquiry</option>
              <option value="sales">Sales Question</option>
              <option value="technical">Technical Support</option>
              <option value="billing">Billing Issue</option>
              <option value="partnership">Partnership Opportunity</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="subject" class="block text-white font-semibold mb-2">Subject *</label>
            <input
              type="text"
              id="subject"
              x-model="subject"
              required
              class="w-full px-4 py-3 bg-gray-100 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
              placeholder="Brief description of your inquiry"
            />
          </div>

          <div>
            <label for="message" class="block text-white font-semibold mb-2">Message *</label>
            <textarea
              id="message"
              x-model="message"
              required
              rows="6"
              class="w-full px-4 py-3 bg-gray-100 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors resize-none"
              placeholder="Tell us more about your inquiry..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-bold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>

    <!-- Department Contacts -->
    <div class="mb-20">
      <h2 class="text-3xl font-bold text-white text-center mb-12">Department Contacts</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-[#FF9C20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Technical Support</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Server issues, configuration help, and technical assistance</p>
          <a href="mailto:support@quack.host" class="text-[#FF9C20] hover:underline text-sm">support@quack.host</a>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-cyan-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Billing & Payments</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Invoices, payment issues, and account billing</p>
          <a href="mailto:billing@quack.host" class="text-cyan-50 hover:underline text-sm">billing@quack.host</a>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-purple-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Abuse & Security</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Report abuse, security concerns, or policy violations</p>
          <a href="mailto:abuse@quack.host" class="text-purple-50 hover:underline text-sm">abuse@quack.host</a>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-green-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Legal & Compliance</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Privacy requests, GDPR, legal matters</p>
          <a href="mailto:legal@quack.host" class="text-green-50 hover:underline text-sm">legal@quack.host</a>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-[#FF9C20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Sales & Partnerships</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Enterprise inquiries, partnerships, bulk orders</p>
          <a href="mailto:sales@quack.host" class="text-[#FF9C20] hover:underline text-sm">sales@quack.host</a>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center gap-3 mb-3">
            <svg class="w-6 h-6 text-cyan-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/>
            </svg>
            <h3 class="text-xl font-bold text-white">Media & Press</h3>
          </div>
          <p class="text-cool-gray-20 text-sm mb-3">Press inquiries, media kits, interviews</p>
          <a href="mailto:press@quack.host" class="text-cyan-50 hover:underline text-sm">press@quack.host</a>
        </div>
      </div>
    </div>

    <!-- FAQ Quick Links -->
    <div class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12 text-center">
        <h2 class="text-3xl font-bold text-white mb-4">Looking for quick answers?</h2>
        <p class="text-cool-gray-20 text-lg mb-6">
          Check out our comprehensive guides and documentation first - you might find what you're looking for instantly.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/guides-&-tutorials-b" class="px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-semibold rounded-lg hover:border-[#FF9C20] transition-all">
            Guides & Tutorials
          </a>
          <a href="/learn-more" class="px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-semibold rounded-lg hover:border-cyan-50 transition-all">
            Documentation
          </a>
          <a href="/service-status" class="px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-semibold rounded-lg hover:border-purple-50 transition-all">
            Service Status
          </a>
        </div>
      </div>
    </div>

    <!-- Support Hours -->
    <div class="mb-20 text-center">
      <div class="inline-block bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-green-50 rounded-2xl px-8 py-6">
        <div class="flex items-center gap-4">
          <div class="w-3 h-3 rounded-full bg-green-40 animate-pulse"></div>
          <div class="text-left">
            <p class="text-white font-bold text-lg">We're online 24/7</p>
            <p class="text-cool-gray-20 text-sm">Average response time: Under 2 hours</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  Alpine.start();
</script>
