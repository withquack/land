---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ About Us">
  <div class="max-w-6xl mx-auto">
    <!-- Hero Section -->
    <div class="mb-20 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-cyan-50/20 to-purple-50/20 border border-cyan-50/50 rounded-full">
        <span class="text-cyan-50 font-bold text-sm">ABOUT US</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        Powered by gamers, <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">built for gamers</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
        We're on a mission to make game server hosting simple, affordable, and accessible to everyone - from casual players to professional communities.
      </p>
    </div>

    <!-- Mission Statement -->
    <div class="mb-20 bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-[#FF9C20] rounded-2xl p-8 lg:p-12">
      <div class="flex items-start gap-6">
        <div class="text-6xl">🎯</div>
        <div class="flex-1">
          <h2 class="text-3xl font-bold text-white mb-4">Our Mission</h2>
          <p class="text-xl text-cool-gray-20 leading-relaxed">
            To empower gamers worldwide with blazing-fast, reliable, and affordable game server hosting. We believe everyone deserves a lag-free gaming experience, whether you're hosting a private server for friends or running a massive public community.
          </p>
        </div>
      </div>
    </div>

    <!-- Story Section -->
    <div class="mb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
            Our <span class="text-[#FF9C20]">Story</span>
          </h2>
          <div class="space-y-4 text-cool-gray-20 text-lg">
            <p>
              QuackHost was born out of frustration. Like many gamers, our founders struggled with expensive, slow, and complicated server hosting services. Support tickets went unanswered, performance was unreliable, and pricing was confusing.
            </p>
            <p>
              We knew there had to be a better way. So we built it.
            </p>
            <p>
              Starting in 2023, QuackHost set out to revolutionize game server hosting with three core principles: transparency, performance, and accessibility. Today, we're proud to serve thousands of gaming communities worldwide.
            </p>
          </div>
        </div>
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8">
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-[#FF9C20]/20 flex items-center justify-center flex-shrink-0">
                <span class="text-2xl">🚀</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">2023</h3>
                <p class="text-cool-gray-20">QuackHost founded with a vision to democratize game hosting</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-cyan-50/20 flex items-center justify-center flex-shrink-0">
                <span class="text-2xl">🌍</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">Global Expansion</h3>
                <p class="text-cool-gray-20">Launched data centers across US, EU, and APAC regions</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-purple-50/20 flex items-center justify-center flex-shrink-0">
                <span class="text-2xl">👥</span>
              </div>
              <div>
                <h3 class="text-xl font-bold text-white mb-2">Community First</h3>
                <p class="text-cool-gray-20">Built an active Discord community of 10,000+ gamers</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Values Section -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Our <span class="text-[#FF9C20]">Values</span>
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-2xl font-bold text-white mb-3">Performance First</h3>
          <p class="text-cool-gray-20">
            We use only the latest enterprise hardware (AMD Ryzen 9, DDR5, NVMe Gen4) to ensure your servers run at peak performance.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">💎</div>
          <h3 class="text-2xl font-bold text-white mb-3">Transparent Pricing</h3>
          <p class="text-cool-gray-20">
            No hidden fees, no surprises. What you see is what you pay. Simple, straightforward, and fair.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">🤝</div>
          <h3 class="text-2xl font-bold text-white mb-3">Customer Success</h3>
          <p class="text-cool-gray-20">
            Your success is our success. We're here 24/7 to help you grow your gaming community.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Security & Privacy</h3>
          <p class="text-cool-gray-20">
            Enterprise-grade DDoS protection, encrypted data, and GDPR compliance. Your data is safe with us.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">🌱</div>
          <h3 class="text-2xl font-bold text-white mb-3">Continuous Innovation</h3>
          <p class="text-cool-gray-20">
            We're constantly improving. New features, better performance, and enhanced tools ship every week.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">🌍</div>
          <h3 class="text-2xl font-bold text-white mb-3">Global Accessibility</h3>
          <p class="text-cool-gray-20">
            Low-latency servers worldwide ensure great performance no matter where you or your players are located.
          </p>
        </div>
      </div>
    </div>

    <!-- Stats Section -->
    <div class="mb-20 bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        By the <span class="text-[#FF9C20]">Numbers</span>
      </h2>
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="text-5xl font-bold text-[#FF9C20] mb-2">10K+</div>
          <div class="text-cool-gray-20">Active Servers</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-cyan-50 mb-2">50+</div>
          <div class="text-cool-gray-20">Supported Games</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-purple-50 mb-2">99.9%</div>
          <div class="text-cool-gray-20">Uptime SLA</div>
        </div>
        <div class="text-center">
          <div class="text-5xl font-bold text-green-50 mb-2">24/7</div>
          <div class="text-cool-gray-20">Expert Support</div>
        </div>
      </div>
    </div>

    <!-- Technology Stack -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Powered by cutting-edge <span class="text-[#FF9C20]">technology</span>
      </h2>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12">
        <div class="grid md:grid-cols-2 gap-12">
          <div>
            <h3 class="text-2xl font-bold text-white mb-6">Infrastructure</h3>
            <ul class="space-y-3 text-cool-gray-20">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">AMD Ryzen 9 7950X</strong> - 16-core processors with exceptional single-thread performance</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">DDR5 5600MHz RAM</strong> - Lightning-fast memory for instant responsiveness</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">NVMe Gen4 SSDs</strong> - 7000MB/s read speeds for near-instant world loading</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">10Gbps Network</strong> - Premium bandwidth with no throttling or caps</span>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white mb-6">Security & Protection</h3>
            <ul class="space-y-3 text-cool-gray-20">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-cyan-50 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">Multi-layer DDoS Protection</strong> - Up to 3.5Tbps mitigation capacity</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-cyan-50 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">Automated Backups</strong> - Daily snapshots with 7-day retention</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-cyan-50 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">TLS/SSL Encryption</strong> - All data encrypted in transit and at rest</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 text-cyan-50 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span><strong class="text-white">GDPR Compliant</strong> - Full compliance with international data protection laws</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Team Section -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-6">
        Built by <span class="text-[#FF9C20]">gamers</span>, for gamers
      </h2>
      <p class="text-xl text-cool-gray-20 text-center max-w-3xl mx-auto mb-12">
        Our team is made up of passionate gamers, developers, and infrastructure engineers who understand the pain points of game hosting because we've experienced them ourselves.
      </p>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12 text-center">
        <p class="text-cool-gray-20 text-lg mb-6">
          We're a remote-first company with team members across North America, Europe, and Asia Pacific, ensuring 24/7 coverage and support for our global community.
        </p>
        <a href="/discord-flock" class="inline-block px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg transition-all">
          Join Our Community →
        </a>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mb-20">
      <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-12 lg:p-16 text-center">
        <h2 class="text-3xl lg:text-5xl font-bold text-black mb-6">
          Ready to experience the QuackHost difference?
        </h2>
        <p class="text-xl text-gray-90 mb-8 max-w-2xl mx-auto">
          Join thousands of gaming communities who trust QuackHost for their server hosting needs.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="/pricing"
            class="px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-gray-90 transition-all hover:scale-105"
          >
            View Pricing
          </a>
          <a
            href="/games"
            class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-100 transition-all hover:scale-105"
          >
            Browse Games
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
