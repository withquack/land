---
import Layout from "../layouts/layout.astro";
---

<Layout
  title="/ Pricing"
  description="Transparent, honest pricing for game server hosting. No hidden fees, no surprise charges, no contracts. Choose the perfect plan for your community and scale anytime."
>
  <!-- Header Section -->
  <section class="mb-16 lg:mb-20 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-semibold mb-6">
      <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
        Transparent pricing.
      </span>
      <br />
      <span class="text-white">No surprises.</span>
    </h1>
    <p class="text-lg lg:text-xl text-cool-gray-30 leading-relaxed max-w-3xl mx-auto">
      What you see is what you pay. No hidden fees, no setup charges, no contracts. Scale up or down anytime - billing is prorated to the second.
    </p>
  </section>

  <!-- Trust Badges -->
  <div class="mb-12 flex flex-wrap justify-center gap-6 text-sm text-cool-gray-40">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
