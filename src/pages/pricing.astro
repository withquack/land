---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Pricing">
  <!-- Hero Section -->
  <div class="mb-16 lg:mb-20 text-center">
    <h1
      class="text-4xl md:text-6xl font-bold mb-6 text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
    >
      Simple, transparent pricing
    </h1>
    <p class="text-xl text-cool-gray-40 max-w-2xl mx-auto mb-8">
      Start free, upgrade when you need more. No hidden fees, no surprises.
      Cancel anytime.
    </p>

    <!-- Billing Toggle -->
    <div
      class="inline-flex items-center gap-4 bg-cool-gray-90 p-2 rounded-lg"
      x-data="{ annually: false }"
    >
      <button
        @click="annually = false"
        :class="!annually ? 'bg-[#FF9C20] text-black' : 'text-white'"
        class="px-6 py-2 rounded-md transition-all duration-200 font-semibold"
      >
        Monthly
      </button>
      <button
        @click="annually = true"
        :class="annually ? 'bg-[#FF9C20] text-black' : 'text-white'"
        class="px-6 py-2 rounded-md transition-all duration-200 font-semibold relative"
      >
        Annually
        <span
          class="absolute -top-2 -right-2 bg-green-50 text-cool-gray-100 text-xs px-2 py-0.5 rounded-full"
          >Save 20%</span
        >
      </button>
    </div>
  </div>

