---
import Layout from "../layouts/layout.astro";
import PricingCalculator from "../components/pricing-calculator.astro";
---

<Layout title="/ Pricing">
  <div class="container mx-auto px-4 py-16">

    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-4xl md:text-6xl font-bold mb-4">
        Simple, Transparent Pricing
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        No hidden fees. No surprises. Scale up or down anytime. Pay only for what you use.
      </p>
    </div>

    <!-- Pricing Toggle -->
    <div class="flex justify-center mb-12" x-data="{ billing: 'monthly' }">
      <div class="inline-flex rounded-lg bg-gray-800 p-1">
        <button
          @click="billing = 'monthly'"
          :class="billing === 'monthly' ? 'bg-orange-500 text-white' : 'text-gray-400'"
          class="px-6 py-2 rounded-md font-medium transition-all"
        >
          Monthly
        </button>
        <button
          @click="billing = 'annual'"
          :class="billing === 'annual' ? 'bg-orange-500 text-white' : 'text-gray-400'"
          class="px-6 py-2 rounded-md font-medium transition-all"
        >
          Annual
          <span class="ml-2 text-xs bg-green-500 text-white px-2 py-1 rounded">Save 15%</span>
        </button>
      </div>
    </div>

    <!-- Pricing Cards -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16" x-data="{ billing: 'monthly' }">

      <!-- Starter Plan -->
      <div class="bg-gray-900 border border-gray-700 rounded-lg p-8 hover:border-orange-500 transition-all">
        <h3 class="text-2xl font-bold mb-2">Starter</h3>
        <p class="text-gray-400 text-sm mb-6">Perfect for small communities</p>
        <div class="mb-6">
          <span class="text-5xl font-bold">$12</span>
          <span class="text-gray-400" x-show="billing === 'monthly'">/mo</span>
          <span class="text-gray-400" x-show="billing === 'annual'">/mo</span>
          <div x-show="billing === 'annual'" class="text-sm text-green-500 mt-1">
            $122/year (save $22)
          </div>
        </div>
        <ul class="space-y-3 mb-8 text-sm">
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>2 CPU Cores</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>4 GB RAM</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>50 GB NVMe Storage</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Up to 20 Players</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>DDoS Protection</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 text-green-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>Daily Backups</span>
