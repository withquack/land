    <!-- FAQ Section -->
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-8">Pricing FAQ</h2>
      <div class="space-y-4" x-data="{ active: null }">

        <div class="bg-gray-900 border border-gray-700 rounded-lg">
