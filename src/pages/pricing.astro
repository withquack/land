---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Pricing">
  <!-- Hero -->
  <div class="mb-16 text-center">
    <h1 class="text-4xl lg:text-6xl font-bold mb-4">
      <span class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
        Revolutionary Pricing
      </span>
    </h1>
    <p class="text-xl text-cool-gray-30 max-w-2xl mx-auto">
      Only pay for what you use. Our Sleep Mode technology automatically pauses
      your server when empty, saving you up to 60% on hosting costs.
    </p>
  </div>

  <!-- Interactive Savings Calculator -->
  <div
    class="mb-16 lg:mb-24 bg-gradient-to-br from-cool-gray-90 to-cool-gray-95 p-8 lg:p-12 rounded-lg border border-cool-gray-80"
    x-data="{
      hoursPerDay: 8,
      planSize: 'medium',
      plans: {
        small: { name: '2GB RAM', traditional: 12, perHour: 0.60 },
        medium: { name: '4GB RAM', traditional: 20, perHour: 1.00 },
        large: { name: '8GB RAM', traditional: 35, perHour: 1.75 },
        xlarge: { name: '16GB RAM', traditional: 60, perHour: 3.00 }
      },
      get currentPlan() { return this.plans[this.planSize] },
      get activeHoursPerMonth() { return this.hoursPerDay * 30 },
      get quackHostCost() { return (this.activeHoursPerMonth * this.currentPlan.perHour).toFixed(2) },
      get traditionalCost() { return this.currentPlan.traditional },
      get savings() { return (this.traditionalCost - this.quackHostCost).toFixed(2) },
      get savingsPercent() { return ((this.savings / this.traditionalCost) * 100).toFixed(0) }
    }"
  >
    <h2 class="text-2xl lg:text-3xl font-semibold mb-8 text-center">
      Calculate Your Savings
    </h2>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Calculator Inputs -->
      <div class="space-y-8">
        <div>
          <label class="block text-lg font-semibold mb-4">
            How many hours per day is your server active?
          </label>
          <input
            type="range"
            x-model.number="hoursPerDay"
            min="1"
            max="24"
            class="w-full h-2 bg-cool-gray-70 rounded-lg appearance-none cursor-pointer accent-[#FF9C20]"
          />
          <div class="flex justify-between mt-2 text-cool-gray-40">
            <span>1 hour</span>
            <span class="text-2xl font-bold text-white" x-text="hoursPerDay"></span>
            <span>24 hours</span>
          </div>
          <p class="text-sm text-cool-gray-50 mt-2">
            (Most servers are active 6-10 hours/day)
          </p>
        </div>

        <div>
          <label class="block text-lg font-semibold mb-4">
            Select your server size
          </label>
          <div class="grid grid-cols-2 gap-3">
            <button
              @click="planSize = 'small'"
              :class="planSize === 'small' ? 'bg-[#FF9C20] text-black' : 'bg-cool-gray-80 text-white hover:bg-cool-gray-70'"
              class="p-4 rounded-lg font-semibold transition-colors"
            >
              2GB RAM<br/>
              <span class="text-sm font-normal">~10 players</span>
            </button>
            <button
              @click="planSize = 'medium'"
              :class="planSize === 'medium' ? 'bg-[#FF9C20] text-black' : 'bg-cool-gray-80 text-white hover:bg-cool-gray-70'"
              class="p-4 rounded-lg font-semibold transition-colors"
            >
              4GB RAM<br/>
              <span class="text-sm font-normal">~25 players</span>
            </button>
            <button
              @click="planSize = 'large'"
              :class="planSize === 'large' ? 'bg-[#FF9C20] text-black' : 'bg-cool-gray-80 text-white hover:bg-cool-gray-70'"
              class="p-4 rounded-lg font-semibold transition-colors"
            >
              8GB RAM<br/>
              <span class="text-sm font-normal">~50 players</span>
            </button>
            <button
              @click="planSize = 'xlarge'"
              :class="planSize === 'xlarge' ? 'bg-[#FF9C20] text-black' : 'bg-cool-gray-80 text-white hover:bg-cool-gray-70'"
              class="p-4 rounded-lg font-semibold transition-colors"
            >
              16GB RAM<br/>
              <span class="text-sm font-normal">~100 players</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Results -->
      <div class="bg-cool-gray-95 p-8 rounded-lg border border-cool-gray-70">
        <h3 class="text-xl font-semibold mb-6">Your Monthly Cost Breakdown</h3>

        <div class="space-y-6">
          <div class="flex justify-between items-center pb-4 border-b border-cool-gray-70">
            <div>
              <p class="text-cool-gray-40">Traditional Hosting</p>
              <p class="text-sm text-cool-gray-50">24/7 always-on</p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold" x-text="'$' + traditionalCost"></p>
              <p class="text-sm text-cool-gray-50">/month</p>
            </div>
          </div>

          <div class="flex justify-between items-center pb-4 border-b border-cool-gray-70">
            <div>
              <p class="text-green-40 font-semibold">QuackHost Sleep Mode</p>
              <p class="text-sm text-cool-gray-50" x-text="activeHoursPerMonth + ' active hours/month'"></p>
            </div>
            <div class="text-right">
              <p class="text-2xl font-bold text-green-40" x-text="'$' + quackHostCost"></p>
              <p class="text-sm text-cool-gray-50">/month</p>
            </div>
          </div>

          <div class="bg-gradient-to-r from-green-90 to-teal-90 p-6 rounded-lg border border-green-70">
            <p class="text-sm text-cool-gray-30 mb-2">You Save</p>
            <p class="text-4xl font-bold text-green-40 mb-1" x-text="'$' + savings"></p>
            <p class="text-lg text-green-50" x-text="savingsPercent + '% cheaper'"></p>
            <p class="text-sm text-cool-gray-40 mt-3" x-text="'That\'s $' + (savings * 12).toFixed(2) + ' saved per year!'"></p>
          </div>

          <div class="pt-4">
            <a
              href="#plans"
              class="block w-full text-center py-4 px-6 bg-[#FF9C20] hover:bg-[#CC6600] text-black font-semibold rounded-lg transition-colors"
            >
              Start Saving Now →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Standard Pricing Plans -->
  <div id="plans" class="mb-16 lg:mb-24">
    <h2 class="text-3xl lg:text-4xl font-semibold mb-4 text-center">
      Choose Your Plan
    </h2>
    <p class="text-center text-cool-gray-40 mb-12 max-w-2xl mx-auto">
      All plans include DDoS protection, automatic backups, QuackPlane control panel,
      and our AI-powered features. No setup fees, no long-term contracts.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Starter Plan -->
      <div class="bg-cool-gray-90 p-8 rounded-lg border border-cool-gray-80 hover:border-[#FF9C20] transition-colors">
        <h3 class="text-2xl font-bold mb-2">Starter</h3>
        <p class="text-cool-gray-40 mb-6">Perfect for small groups</p>

        <div class="mb-6">
          <p class="text-4xl font-bold">$12<span class="text-xl text-cool-gray-50">/mo</span></p>
          <p class="text-sm text-cool-gray-50">or pay per hour</p>
        </div>

        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">2GB RAM</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">~10 players</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">Sleep Mode included</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">Automatic backups</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">DDoS protection</span>
          </li>
        </ul>

        <a href="#" class="block w-full text-center py-3 px-6 bg-cool-gray-80 hover:bg-[#FF9C20] hover:text-black text-white font-semibold rounded transition-colors">
          Get Started
        </a>
      </div>

      <!-- Popular Plan -->
      <div class="bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] p-1 rounded-lg relative">
        <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-[#FF9C20] text-black px-4 py-1 rounded-full text-sm font-semibold">
          Most Popular
        </div>
        <div class="bg-cool-gray-90 p-8 rounded-lg h-full">
          <h3 class="text-2xl font-bold mb-2">Standard</h3>
          <p class="text-cool-gray-40 mb-6">For growing communities</p>

          <div class="mb-6">
            <p class="text-4xl font-bold">$20<span class="text-xl text-cool-gray-50">/mo</span></p>
            <p class="text-sm text-cool-gray-50">or pay per hour</p>
          </div>

          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-2">
              <span class="text-green-40 mt-1">✓</span>
              <span class="text-cool-gray-30">4GB RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-40 mt-1">✓</span>
              <span class="text-cool-gray-30">~25 players</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-40 mt-1">✓</span>
              <span class="text-cool-gray-30">Sleep Mode included</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-40 mt-1">✓</span>
              <span class="text-cool-gray-30">Priority support</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-40 mt-1">✓</span>
              <span class="text-cool-gray-30">AI crash analyzer</span>
            </li>
          </ul>

          <a href="#" class="block w-full text-center py-3 px-6 bg-[#FF9C20] hover:bg-[#CC6600] text-black font-semibold rounded transition-colors">
            Get Started
          </a>
        </div>
      </div>

      <!-- Pro Plan -->
      <div class="bg-cool-gray-90 p-8 rounded-lg border border-cool-gray-80 hover:border-[#FF9C20] transition-colors">
        <h3 class="text-2xl font-bold mb-2">Pro</h3>
        <p class="text-cool-gray-40 mb-6">For serious servers</p>

        <div class="mb-6">
          <p class="text-4xl font-bold">$35<span class="text-xl text-cool-gray-50">/mo</span></p>
          <p class="text-sm text-cool-gray-50">or pay per hour</p>
        </div>

        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">8GB RAM</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">~50 players</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">All Standard features</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">Daily backups</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">Custom subdomain</span>
          </li>
        </ul>

        <a href="#" class="block w-full text-center py-3 px-6 bg-cool-gray-80 hover:bg-[#FF9C20] hover:text-black text-white font-semibold rounded transition-colors">
          Get Started
        </a>
      </div>

      <!-- Enterprise Plan -->
      <div class="bg-cool-gray-90 p-8 rounded-lg border border-cool-gray-80 hover:border-[#FF9C20] transition-colors">
        <h3 class="text-2xl font-bold mb-2">Enterprise</h3>
        <p class="text-cool-gray-40 mb-6">Maximum performance</p>

        <div class="mb-6">
          <p class="text-4xl font-bold">$60<span class="text-xl text-cool-gray-50">/mo</span></p>
          <p class="text-sm text-cool-gray-50">or pay per hour</p>
        </div>

        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">16GB RAM</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">~100 players</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">All Pro features</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">Dedicated CPU cores</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-green-40 mt-1">✓</span>
            <span class="text-cool-gray-30">24/7 priority support</span>
          </li>
        </ul>

        <a href="#" class="block w-full text-center py-3 px-6 bg-cool-gray-80 hover:bg-[#FF9C20] hover:text-black text-white font-semibold rounded transition-colors">
          Get Started
        </a>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="mb-16 lg:mb-24">
    <h2 class="text-3xl font-semibold mb-8 text-center">Pricing Questions</h2>

    <div class="max-w-3xl mx-auto space-y-4">
      <details class="bg-cool-gray-90 p-6 rounded-lg border border-cool-gray-80">
        <summary class="font-semibold cursor-pointer">How does Sleep Mode billing work?</summary>
        <p class="mt-4 text-cool-gray-40">
          When your server has 0 players for 5 minutes, it automatically pauses and stops billing.
          When a player connects, the server wakes up in ~15 seconds and resumes billing. You only
          pay for the time your server is actually being used.
        </p>
      </details>

      <details class="bg-cool-gray-90 p-6 rounded-lg border border-cool-gray-80">
        <summary class="font-semibold cursor-pointer">Can I switch between pay-per-hour and monthly?</summary>
        <p class="mt-4 text-cool-gray-40">
          Yes! You can switch billing modes anytime. We'll automatically recommend the cheaper option
          based on your usage patterns. If your server runs 24/7, monthly is better. If it's only
          active a few hours per day, pay-per-hour with Sleep Mode saves you money.
        </p>
      </details>

      <details class="bg-cool-gray-90 p-6 rounded-lg border border-cool-gray-80">
        <summary class="font-semibold cursor-pointer">What happens if I exceed my player limit?</summary>
        <p class="mt-4 text-cool-gray-40">
          The server will continue running normally. We'll notify you and suggest upgrading to the
          next tier for better performance. There are no overage charges - we'll never surprise you
          with unexpected fees.
        </p>
      </details>

      <details class="bg-cool-gray-90 p-6 rounded-lg border border-cool-gray-80">
        <summary class="font-semibold cursor-pointer">Is there a free trial?</summary>
        <p class="mt-4 text-cool-gray-40">
          Yes! Get 48 hours free to test QuackHost with your mods, plugins, and friends. No credit
          card required to start. After the trial, choose the plan that fits your needs.
        </p>
      </details>
    </div>
  </div>
</Layout>

<style>
  /* Improve range slider appearance */
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #FF9C20;
    cursor: pointer;
  }

  input[type="range"]::-moz-range-thumb {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #FF9C20;
    cursor: pointer;
    border: none;
  }
</style>
