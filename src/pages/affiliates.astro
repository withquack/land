---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Affiliate Program">
  <div class="max-w-7xl mx-auto">
    <!-- Hero Section -->
    <div class="mb-20 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-[#FF9C20]/20 to-purple-50/20 border border-[#FF9C20]/50 rounded-full">
        <span class="text-[#FF9C20] font-bold text-sm">PARTNER PROGRAM</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        Earn <span class="bg-gradient-to-r from-[#FF9C20] to-purple-50 bg-clip-text text-transparent">30% commission</span> with QuackHost
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
        Join our affiliate program and earn recurring commissions by referring game server hosting customers.
      </p>
      <a
        href="#apply"
        class="inline-block px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all hover:scale-105"
      >
        Apply Now →
      </a>
    </div>

    <!-- Benefits Grid -->
    <div class="mb-20 grid md:grid-cols-3 gap-6">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-[#FF9C20] rounded-xl p-8 text-center">
        <div class="text-5xl font-bold text-[#FF9C20] mb-2">30%</div>
        <div class="text-white font-semibold mb-2">Commission Rate</div>
        <div class="text-cool-gray-40 text-sm">Industry-leading payouts on every sale</div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-purple-50 rounded-xl p-8 text-center">
        <div class="text-5xl font-bold text-purple-50 mb-2">∞</div>
        <div class="text-white font-semibold mb-2">Lifetime Recurring</div>
        <div class="text-cool-gray-40 text-sm">Earn commissions for the life of the customer</div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-cyan-50 rounded-xl p-8 text-center">
        <div class="text-5xl font-bold text-cyan-50 mb-2">$50</div>
        <div class="text-white font-semibold mb-2">Minimum Payout</div>
        <div class="text-cool-gray-40 text-sm">Low threshold with PayPal or crypto</div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        How it <span class="text-[#FF9C20]">works</span>
      </h2>
      <div class="grid md:grid-cols-4 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl font-bold text-black">1</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Apply</h3>
          <p class="text-cool-gray-20">
            Fill out our simple application form. We review applications within 24 hours.
          </p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-cyan-50 to-purple-50 flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl font-bold text-black">2</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Get Approved</h3>
          <p class="text-cool-gray-20">
            Receive your unique referral link and promotional materials.
          </p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-50 to-cyan-50 flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl font-bold text-black">3</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Promote</h3>
          <p class="text-cool-gray-20">
            Share your link with your audience through videos, streams, or content.
          </p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 rounded-full bg-gradient-to-br from-green-50 to-[#FF9C20] flex items-center justify-center mx-auto mb-4">
            <span class="text-3xl font-bold text-black">4</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Earn</h3>
          <p class="text-cool-gray-20">
            Get paid 30% recurring commissions for every customer you refer.
          </p>
        </div>
      </div>
    </div>

    <!-- Earnings Calculator -->
    <div class="mb-20">
      <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-1">
        <div class="bg-gray-100 rounded-xl p-8 lg:p-12">
          <h2 class="text-3xl font-bold text-white text-center mb-8">
            Earnings Calculator
          </h2>
          <div x-data="{ referrals: 10, avgPrice: 20 }" class="max-w-3xl mx-auto">
            <div class="space-y-6 mb-8">
              <div>
                <label class="block text-white font-semibold mb-3">
                  Monthly Referrals: <span x-text="referrals" class="text-[#FF9C20]"></span>
                </label>
                <input
                  type="range"
                  x-model="referrals"
                  min="1"
                  max="100"
                  class="w-full h-3 bg-gray-90 rounded-lg appearance-none cursor-pointer slider"
                />
              </div>
              <div>
                <label class="block text-white font-semibold mb-3">
                  Average Order Value: $<span x-text="avgPrice" class="text-[#FF9C20]"></span>
                </label>
                <input
                  type="range"
                  x-model="avgPrice"
                  min="10"
                  max="100"
                  step="5"
                  class="w-full h-3 bg-gray-90 rounded-lg appearance-none cursor-pointer slider"
                />
              </div>
            </div>

            <div class="bg-gradient-to-br from-gray-90 to-gray-100 rounded-xl p-8">
              <div class="grid md:grid-cols-3 gap-6 text-center">
                <div>
                  <div class="text-cool-gray-40 text-sm mb-2">Monthly Earnings</div>
                  <div class="text-4xl font-bold text-[#FF9C20]">
                    $<span x-text="(referrals * avgPrice * 0.3).toFixed(0)"></span>
                  </div>
                </div>
                <div>
                  <div class="text-cool-gray-40 text-sm mb-2">Yearly Earnings</div>
                  <div class="text-4xl font-bold text-cyan-50">
                    $<span x-text="(referrals * avgPrice * 0.3 * 12).toFixed(0)"></span>
                  </div>
                </div>
                <div>
                  <div class="text-cool-gray-40 text-sm mb-2">Commission Rate</div>
                  <div class="text-4xl font-bold text-purple-50">30%</div>
                </div>
              </div>
              <p class="text-cool-gray-40 text-sm text-center mt-6">
                * Estimates based on recurring monthly subscriptions. Actual earnings may vary.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Who Should Join -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Perfect for <span class="text-cyan-50">creators</span>
      </h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🎥</div>
          <h3 class="text-xl font-bold text-white mb-3">YouTubers</h3>
          <p class="text-cool-gray-20">
            Create server setup tutorials and earn from every viewer who signs up.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">📺</div>
          <h3 class="text-xl font-bold text-white mb-3">Streamers</h3>
          <p class="text-cool-gray-20">
            Host your own server and share your unique link with your community.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">✍️</div>
          <h3 class="text-xl font-bold text-white mb-3">Bloggers</h3>
          <p class="text-cool-gray-20">
            Write hosting reviews and guides with your affiliate links embedded.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-green-50 transition-all">
          <div class="text-4xl mb-4">👥</div>
          <h3 class="text-xl font-bold text-white mb-3">Communities</h3>
          <p class="text-cool-gray-20">
            Run a Discord server or forum? Earn from members who need hosting.
          </p>
        </div>
      </div>
    </div>

    <!-- Program Features -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Program <span class="text-purple-50">features</span>
      </h2>
      <div class="grid lg:grid-cols-2 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
          <h3 class="text-2xl font-bold text-white mb-6 flex items-center gap-3">
            <span class="text-3xl">📊</span>
            Real-Time Dashboard
          </h3>
          <ul class="space-y-3 text-cool-gray-20">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Track clicks, conversions, and earnings in real-time</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
