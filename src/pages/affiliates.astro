          <form class="max-w-2xl mx-auto space-y-6" x-data="{ name: '', email: '', platform: '', audience: '', website: '' }" @submit.prevent="alert('Affiliate application coming soon!')">
            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-white font-semibold mb-2">Full Name *</label>
                <input
                  type="text"
                  x-model="name"
                  placeholder="John Doe"
                  class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                  required
                />
              </div>
              <div>
                <label class="block text-white font-semibold mb-2">Email Address *</label>
                <input
                  type="email"
                  x-model="email"
                  placeholder="you@example.com"
                  class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                  required
                />
              </div>
            </div>

            <div>
              <label class="block text-white font-semibold mb-2">Primary Platform *</label>
              <select
                x-model="platform"
                class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white focus:outline-none focus:border-[#FF9C20] transition-colors"
                required
              >
                <option value="" class="bg-gray-90">Select a platform...</option>
                <option value="youtube" class="bg-gray-90">YouTube</option>
                <option value="twitch" class="bg-gray-90">Twitch</option>
                <option value="blog" class="bg-gray-90">Blog/Website</option>
                <option value="discord" class="bg-gray-90">Discord Community</option>
                <option value="other" class="bg-gray-90">Other</option>
              </select>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              <div>
                <label class="block text-white font-semibold mb-2">Channel/Website URL *</label>
                <input
                  type="url"
                  x-model="website"
                  placeholder="https://youtube.com/@yourhandle"
                  class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                  required
                />
              </div>
              <div>
                <label class="block text-white font-semibold mb-2">Audience Size *</label>
                <select
                  x-model="audience"
                  class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white focus:outline-none focus:border-[#FF9C20] transition-colors"
                  required
                >
                  <option value="" class="bg-gray-90">Select range...</option>
                  <option value="<1k" class="bg-gray-90">Less than 1,000</option>
                  <option value="1k-10k" class="bg-gray-90">1,000 - 10,000</option>
                  <option value="10k-100k" class="bg-gray-90">10,000 - 100,000</option>
                  <option value="100k+" class="bg-gray-90">100,000+</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-white font-semibold mb-2">Tell us about your content</label>
              <textarea
                placeholder="Describe your channel/content and how you plan to promote QuackHost..."
                class="w-full px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors h-32"
              ></textarea>
            </div>

            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="terms"
                class="mt-1"
                required
              />
              <label for="terms" class="text-cool-gray-20 text-sm">
                I agree to the <a href="/terms-of-service" class="text-[#FF9C20] hover:underline">Terms of Service</a> and <a href="/privacy-policy" class="text-[#FF9C20] hover:underline">Privacy Policy</a>, and confirm that I will promote QuackHost ethically and honestly.
              </label>
            </div>

            <button
              type="submit"
              class="w-full px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all"
            >
              Submit Application
            </button>

            <p class="text-cool-gray-40 text-sm text-center">
              We review all applications within 24 hours. You'll receive an email with your decision.
            </p>
          </form>
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
        Frequently <span class="text-cyan-50">asked questions</span>
      </h2>
      <div class="max-w-3xl mx-auto space-y-4">
        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 group">
          <summary class="text-white font-bold cursor-pointer list-none flex items-center justify-between">
            <span>How much can I realistically earn?</span>
            <svg class="w-5 h-5 text-cool-gray-40 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-cool-gray-20 mt-4">
            Earnings vary based on your audience size and engagement. Our top affiliates earn $1,000-$3,000/month. With 30% recurring commissions, even 10 referrals at $20/month = $60/month in passive income.
          </p>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 group">
          <summary class="text-white font-bold cursor-pointer list-none flex items-center justify-between">
            <span>What does "lifetime recurring" mean?</span>
            <svg class="w-5 h-5 text-cool-gray-40 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-cool-gray-20 mt-4">
            You earn 30% commission not just on the first payment, but every month the customer remains subscribed. If someone you refer stays for a year, you earn commissions for all 12 months.
          </p>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 group">
          <summary class="text-white font-bold cursor-pointer list-none flex items-center justify-between">
            <span>How long does approval take?</span>
            <svg class="w-5 h-5 text-cool-gray-40 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-cool-gray-20 mt-4">
            Most applications are reviewed within 24 hours. We accept affiliates with audiences of all sizes, as long as you create quality gaming content.
          </p>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 group">
          <summary class="text-white font-bold cursor-pointer list-none flex items-center justify-between">
            <span>When and how do I get paid?</span>
            <svg class="w-5 h-5 text-cool-gray-40 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-cool-gray-20 mt-4">
            Payments are sent on the 1st of each month via PayPal, bank transfer, or cryptocurrency. Minimum payout is $50. If you don't reach the minimum, your earnings roll over to the next month.
          </p>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 group">
          <summary class="text-white font-bold cursor-pointer list-none flex items-center justify-between">
            <span>Can I be an affiliate if I'm not a content creator?</span>
            <svg class="w-5 h-5 text-cool-gray-40 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="text-cool-gray-20 mt-4">
            Absolutely! If you run a Discord server, gaming forum, or have any other way to refer customers, you're welcome to apply. We evaluate each application individually.
          </p>
        </details>
      </div>
    </div>

  </div>
</Layout>
