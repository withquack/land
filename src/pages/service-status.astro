---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Service Status">
  <div class="max-w-7xl mx-auto">
    <!-- Hero Section -->
    <div class="mb-16 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-green-50/20 to-cyan-50/20 border border-green-50/50 rounded-full">
        <span class="text-green-50 font-bold text-sm">REAL-TIME STATUS</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        All Systems <span class="bg-gradient-to-r from-green-50 to-cyan-50 bg-clip-text text-transparent">Operational</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto">
        Real-time monitoring of all QuackHost services and infrastructure. We're committed to 99.9% uptime.
      </p>
    </div>

    <!-- Current Status Overview -->
    <div class="mb-12 grid md:grid-cols-4 gap-6">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-green-50 rounded-xl p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-white font-semibold">Core Services</h3>
          <div class="w-3 h-3 rounded-full bg-green-50 animate-pulse"></div>
        </div>
        <p class="text-2xl font-bold text-green-50">Operational</p>
        <p class="text-cool-gray-40 text-sm mt-1">All systems running</p>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-green-50 rounded-xl p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-white font-semibold">Game Servers</h3>
          <div class="w-3 h-3 rounded-full bg-green-50 animate-pulse"></div>
        </div>
        <p class="text-2xl font-bold text-green-50">Operational</p>
        <p class="text-cool-gray-40 text-sm mt-1">100% availability</p>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-green-50 rounded-xl p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-white font-semibold">QuackPlane</h3>
          <div class="w-3 h-3 rounded-full bg-green-50 animate-pulse"></div>
        </div>
        <p class="text-2xl font-bold text-green-50">Operational</p>
        <p class="text-cool-gray-40 text-sm mt-1">Panel accessible</p>
      </div>

      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-green-50 rounded-xl p-6">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-white font-semibold">Billing/API</h3>
          <div class="w-3 h-3 rounded-full bg-green-50 animate-pulse"></div>
        </div>
        <p class="text-2xl font-bold text-green-50">Operational</p>
        <p class="text-cool-gray-40 text-sm mt-1">All endpoints up</p>
      </div>
    </div>

    <!-- Uptime Statistics -->
    <div class="mb-12 bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8">
      <h2 class="text-2xl font-bold text-white mb-6">Uptime Statistics</h2>
      <div class="grid md:grid-cols-3 gap-8">
        <div>
          <div class="text-cool-gray-40 text-sm mb-2">Last 30 Days</div>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-green-50">99.98%</span>
            <span class="text-cool-gray-20">uptime</span>
          </div>
        </div>
        <div>
          <div class="text-cool-gray-40 text-sm mb-2">Last 90 Days</div>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-green-50">99.97%</span>
            <span class="text-cool-gray-20">uptime</span>
          </div>
        </div>
        <div>
          <div class="text-cool-gray-40 text-sm mb-2">All Time</div>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-bold text-green-50">99.96%</span>
            <span class="text-cool-gray-20">uptime</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Detailed Status Monitor -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Detailed Status Monitor</h2>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl overflow-hidden">
        <script
          type="text/javascript"
          src="https://static.hetrix.io/iframeResizer/iframeResizer.min.js"></script>
        <iframe
          class="htframe w-full"
          src="https://wl.hetrixtools.com/r/e8b1f3172d6e054d8bf49a3e03ed5358/"
          scrolling="no"
          style="border:none; min-height: 400px;"
          sandbox="allow-scripts allow-same-origin allow-popups"
          onload="iFrameResize([{log:false}],'.htframe')"></iframe>
      </div>
    </div>

    <!-- Regional Status -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Regional Status</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <!-- North America -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="text-2xl">🌎</div>
              <h3 class="text-xl font-bold text-white">North America</h3>
            </div>
            <div class="w-3 h-3 rounded-full bg-green-50"></div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">New York, US</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Los Angeles, US</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Dallas, US</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Toronto, CA</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
          </div>
        </div>

        <!-- Europe -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="text-2xl">🌍</div>
              <h3 class="text-xl font-bold text-white">Europe</h3>
            </div>
            <div class="w-3 h-3 rounded-full bg-green-50"></div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">London, UK</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Frankfurt, DE</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Paris, FR</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Amsterdam, NL</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
          </div>
        </div>

        <!-- Asia Pacific -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-3">
              <div class="text-2xl">🌏</div>
              <h3 class="text-xl font-bold text-white">Asia Pacific</h3>
            </div>
            <div class="w-3 h-3 rounded-full bg-green-50"></div>
          </div>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Singapore, SG</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Tokyo, JP</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Sydney, AU</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-20">Mumbai, IN</span>
              <span class="text-green-50 font-semibold">Online</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Incident History -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Recent Incident History</h2>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
        <div class="text-center py-12">
          <div class="text-6xl mb-4">✨</div>
          <h3 class="text-2xl font-bold text-white mb-2">No Recent Incidents</h3>
          <p class="text-cool-gray-20">All systems have been running smoothly for the past 30 days.</p>
        </div>
      </div>
    </div>

    <!-- Maintenance Schedule -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Scheduled Maintenance</h2>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
        <div class="text-center py-8">
          <div class="text-4xl mb-4">📅</div>
          <h3 class="text-xl font-bold text-white mb-2">No Scheduled Maintenance</h3>
          <p class="text-cool-gray-20">We'll notify you at least 48 hours before any planned maintenance.</p>
        </div>
      </div>
    </div>

    <!-- Status Updates -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Subscribe to Updates</h2>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
        <div class="max-w-2xl mx-auto">
          <p class="text-cool-gray-20 mb-6 text-center">
            Get notified immediately when issues occur or when maintenance is scheduled. We'll keep you informed every step of the way.
          </p>
          <form class="space-y-4" x-data="{ email: '' }" @submit.prevent="alert('Status notification signup coming soon!')">
            <div class="flex gap-3">
              <input
                type="email"
                x-model="email"
                placeholder="Enter your email for status updates"
                class="flex-1 px-4 py-3 bg-gray-90 border border-gray-80 rounded-lg text-white placeholder-cool-gray-60 focus:outline-none focus:border-[#FF9C20] transition-colors"
                required
              />
              <button
                type="submit"
                class="px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-white font-semibold rounded-lg hover:shadow-lg hover:shadow-[#FF9C20]/50 transition-all duration-300 whitespace-nowrap"
              >
                Subscribe
              </button>
            </div>
            <p class="text-cool-gray-40 text-sm text-center">
              We'll only email you about critical updates and maintenance windows.
            </p>
          </form>
        </div>
      </div>
    </div>

    <!-- SLA Information -->
    <div class="mb-20">
      <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-1">
        <div class="bg-gray-100 rounded-xl p-8 lg:p-12">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div>
              <h2 class="text-3xl font-bold text-white mb-4">Our Uptime Guarantee</h2>
              <p class="text-cool-gray-20 text-lg mb-6">
                We're committed to providing industry-leading reliability. Our 99.9% uptime SLA is backed by automatic service credits if we don't meet our commitment.
              </p>
              <ul class="space-y-3 text-cool-gray-20">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong class="text-white">99.9% uptime SLA</strong> - We guarantee your servers will be available</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong class="text-white">Automatic credits</strong> - Service credits issued if we miss our SLA</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-[#FF9C20] flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong class="text-white">Real-time monitoring</strong> - 24/7 automated health checks</span>
                </li>
              </ul>
            </div>
            <div class="bg-gradient-to-br from-gray-90 to-gray-100 rounded-xl p-8">
              <h3 class="text-xl font-bold text-white mb-6">Current Month Performance</h3>
              <div class="space-y-4">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-cool-gray-20">Uptime</span>
                    <span class="text-green-50 font-bold">99.99%</span>
                  </div>
                  <div class="w-full bg-gray-80 rounded-full h-2">
                    <div class="bg-gradient-to-r from-green-50 to-cyan-50 h-2 rounded-full" style="width: 99.99%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-cool-gray-20">Response Time</span>
                    <span class="text-cyan-50 font-bold">~12ms</span>
                  </div>
                  <div class="w-full bg-gray-80 rounded-full h-2">
                    <div class="bg-gradient-to-r from-cyan-50 to-purple-50 h-2 rounded-full" style="width: 95%"></div>
                  </div>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="text-cool-gray-20">Support Response</span>
                    <span class="text-purple-50 font-bold">~2min</span>
                  </div>
                  <div class="w-full bg-gray-80 rounded-full h-2">
                    <div class="bg-gradient-to-r from-purple-50 to-[#FF9C20] h-2 rounded-full" style="width: 98%"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
</Layout>
