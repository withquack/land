---
import Layout from "../layouts/layout.astro";
---

<Layout title="QuackHost vs Apex Hosting - Honest Comparison">
  <!-- Hero Section -->
  <div class="mb-12">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">
      <span class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
        QuackHost vs Apex Hosting
      </span>
    </h1>
    <p class="text-xl text-cool-gray-40">
      An honest, side-by-side comparison to help you choose the right Minecraft hosting provider
    </p>
  </div>

  <!-- Quick Verdict -->
  <div class="bg-cool-gray-90 border border-[#FF9C20] rounded-lg p-6 mb-12">
    <div class="flex items-start gap-3">
      <div class="text-3xl">🎯</div>
      <div>
        <h2 class="text-2xl font-semibold mb-2">Quick Verdict</h2>
        <p class="text-cool-gray-40 leading-relaxed mb-4">
          Both are solid hosting providers. <span class="text-[#FF9C20] font-semibold">Choose QuackHost</span> if you want:
          better performance-to-price ratio, terrabit-scale DDoS protection, and off-site backups.
          <span class="text-cool-gray-40">Choose Apex</span> if you prefer an established brand with more years in the market.
        </p>
      </div>
    </div>
  </div>

  <!-- Detailed Comparison Table -->
  <div class="mb-12 overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b-2 border-cool-gray-70">
          <th class="text-left py-4 px-4 text-cool-gray-40 font-semibold">Feature</th>
          <th class="text-center py-4 px-4 bg-cool-gray-90">
            <div class="text-[#FF9C20] font-bold text-lg mb-1">QuackHost</div>
            <div class="text-cool-gray-40 text-sm font-normal">Our Platform</div>
          </th>
          <th class="text-center py-4 px-4">
            <div class="text-white font-bold text-lg mb-1">Apex Hosting</div>
            <div class="text-cool-gray-40 text-sm font-normal">Competitor</div>
          </th>
        </tr>
      </thead>
      <tbody>
        <!-- Performance -->
        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">CPU Performance</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">Latest AMD Ryzen 9</div>
            <div class="text-xs text-cool-gray-40">5.4GHz+ boost</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">Intel Xeon</div>
            <div class="text-xs text-cool-gray-50">Varies by plan</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Storage Type</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">100% NVMe SSD</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">NVMe SSD</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">RAM Type</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">DDR5</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">DDR4</div>
          </td>
        </tr>

        <!-- Security -->
        <tr class="border-b border-cool-gray-80 bg-cool-gray-95">
          <td class="py-4 px-4 font-semibold" colspan="3">
            <div class="flex items-center gap-2">
              <img src="/index/doodles/rain.svg" alt="" width="24" height="24" />
              <span class="text-lg">Security & Protection</span>
            </div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">DDoS Protection</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">Terrabit-scale</div>
            <div class="text-xs text-cool-gray-40">All plans</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">Standard</div>
            <div class="text-xs text-cool-gray-50">Basic protection</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Backup Storage</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">Off-site</div>
            <div class="text-xs text-cool-gray-40">Datacenter-independent</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">On-site</div>
            <div class="text-xs text-cool-gray-50">Same datacenter</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Automatic Backups</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50">✓ Included</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">✓ Included</div>
          </td>
        </tr>

        <!-- Pricing -->
        <tr class="border-b border-cool-gray-80 bg-cool-gray-95">
          <td class="py-4 px-4 font-semibold" colspan="3">
            <div class="flex items-center gap-2">
              <img src="/index/doodles/cycle.svg" alt="" width="24" height="24" />
              <span class="text-lg">Pricing & Value</span>
            </div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Starting Price</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-[#FF9C20] font-bold text-xl">$5/mo</div>
            <div class="text-xs text-cool-gray-40">2GB RAM</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40 text-xl">$7.99/mo</div>
            <div class="text-xs text-cool-gray-50">2GB RAM</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Setup Fee</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">$0</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">$0</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Money-Back Guarantee</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50">7 days</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">7 days</div>
          </td>
        </tr>

        <!-- Control Panel -->
        <tr class="border-b border-cool-gray-80 bg-cool-gray-95">
          <td class="py-4 px-4 font-semibold" colspan="3">
            <div class="flex items-center gap-2">
              <img src="/index/doodles/wizard.svg" alt="" width="24" height="24" />
              <span class="text-lg">Control Panel & Features</span>
            </div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Control Panel</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">QuackPlane</div>
            <div class="text-xs text-cool-gray-40">Custom-built</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">Multicraft</div>
            <div class="text-xs text-cool-gray-50">Industry standard</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">One-Click Modpacks</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50">✓</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">✓</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Sub-Users/Staff Access</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">✓ Unlimited</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">✓ Limited</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">File Manager</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50">✓ Drag & Drop</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">✓</div>
          </td>
        </tr>

        <!-- Support -->
        <tr class="border-b border-cool-gray-80 bg-cool-gray-95">
          <td class="py-4 px-4 font-semibold" colspan="3">
            <div class="flex items-center gap-2">
              <img src="/index/doodles/chat.svg" alt="" width="24" height="24" />
              <span class="text-lg">Support</span>
            </div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Support Availability</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50">24/7</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-green-50">24/7</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Average Response Time</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-green-50 font-semibold">&lt; 15 minutes</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40">Varies</div>
          </td>
        </tr>

        <tr class="border-b border-cool-gray-80">
          <td class="py-4 px-4 font-semibold">Support Channels</td>
          <td class="py-4 px-4 text-center bg-cool-gray-100">
            <div class="text-cool-gray-40 text-sm">Discord, Email, Tickets</div>
          </td>
          <td class="py-4 px-4 text-center">
            <div class="text-cool-gray-40 text-sm">Email, Live Chat, Tickets</div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- What Users Say -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6 flex items-center gap-2">
      <img src="/index/doodles/hand holding.svg" alt="" width="32" height="32" />
      <span class="underline decoration-4 decoration-cyan-50">What Switchers Say</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-cool-gray-90 border border-cool-gray-70 rounded-lg p-6">
        <div class="flex items-start gap-3 mb-3">
          <div class="text-2xl">💬</div>
          <div>
            <div class="font-semibold">Jake M.</div>
            <div class="text-xs text-cool-gray-40">Switched from Apex</div>
          </div>
        </div>
        <p class="text-cool-gray-40 leading-relaxed">
          "The price difference is huge. I'm getting better performance with QuackHost for 40% less.
          The off-site backups saved me when I needed to roll back after a griefing incident."
        </p>
        <div class="text-yellow-50 mt-2">★★★★★</div>
      </div>

      <div class="bg-cool-gray-90 border border-cool-gray-70 rounded-lg p-6">
        <div class="flex items-start gap-3 mb-3">
          <div class="text-2xl">💬</div>
          <div>
            <div class="font-semibold">Sarah K.</div>
            <div class="text-xs text-cool-gray-40">Switched from Apex</div>
          </div>
        </div>
        <p class="text-cool-gray-40 leading-relaxed">
          "QuackPlane is so much cleaner than Multicraft. The migration was painless and support
          helped me transfer everything. No regrets switching."
        </p>
        <div class="text-yellow-50 mt-2">★★★★★</div>
      </div>
    </div>
  </div>

  <!-- Migration Offer -->
  <div class="bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] rounded-lg p-8 text-black mb-12">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to Switch?</h2>
      <p class="text-lg mb-6 opacity-90">
        We'll help you migrate from Apex to QuackHost completely free. Get 25% off your first 3 months when you switch.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/pricing"
          class="inline-flex justify-center items-center px-8 py-3 bg-black text-white hover:bg-cool-gray-100 transition-colors duration-200 font-semibold"
        >
          View Pricing →
        </a>
        <a
          href="https://discord.gg/quackhost"
          class="inline-flex justify-center items-center px-8 py-3 bg-white text-black hover:bg-cool-gray-20 transition-colors duration-200 font-semibold"
        >
          Ask Questions on Discord
        </a>
      </div>
    </div>
  </div>

  <!-- Fair Comparison Disclaimer -->
  <div class="bg-cool-gray-90 border border-cool-gray-70 rounded-lg p-6">
    <div class="flex items-start gap-3">
      <div class="text-2xl">ℹ️</div>
      <div class="text-sm text-cool-gray-40 leading-relaxed">
        <strong class="text-white">Fair Comparison Disclaimer:</strong> We've done our best to accurately
        represent Apex Hosting's offerings based on publicly available information. Pricing and features
        may vary. We recommend checking both providers before making a decision. This comparison was
        last updated in November 2025.
      </div>
    </div>
  </div>
</Layout>

<style>
  table {
    font-size: 0.95rem;
  }

  @media (max-width: 768px) {
    table {
      font-size: 0.85rem;
    }
  }
</style>
