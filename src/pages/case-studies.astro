---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Case Studies">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-16 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-green-50/20 to-cyan-50/20 border border-green-50/50 rounded-full">
        <span class="text-green-50 font-bold text-sm">SUCCESS STORIES</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        Real Communities, <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">Real Results</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
        See how gaming communities around the world use QuackHost to power their servers and grow their player bases.
      </p>
    </div>

    <!-- Featured Case Study -->
    <div class="mb-20">
      <div class="bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] rounded-2xl p-1">
        <div class="bg-gray-100 rounded-xl p-8 lg:p-12">
          <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
              <span class="px-3 py-1 bg-[#FF9C20] text-black text-xs font-bold rounded-full">FEATURED CASE STUDY</span>
              <h2 class="text-4xl font-bold text-white mt-6 mb-4">PixelCraft Network</h2>
              <p class="text-xl text-cool-gray-20 mb-6">
                How a small Minecraft community grew to 50,000+ players with QuackHost's infrastructure
              </p>
              <div class="grid grid-cols-3 gap-6 mb-8">
                <div>
                  <div class="text-3xl font-bold text-[#FF9C20]">50K+</div>
                  <div class="text-cool-gray-30 text-sm">Monthly Players</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-cyan-50">99.98%</div>
                  <div class="text-cool-gray-30 text-sm">Uptime</div>
                </div>
                <div>
                  <div class="text-3xl font-bold text-purple-50">12</div>
                  <div class="text-cool-gray-30 text-sm">Servers</div>
                </div>
              </div>
              <a
                href="#pixelcraft"
                class="inline-block px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg transition-all"
              >
                Read Full Story →
              </a>
            </div>
            <div class="bg-gray-90 rounded-xl p-8 border-2 border-gray-80">
              <div class="mb-4">
                <svg class="w-12 h-12 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              </div>
              <p class="text-white text-lg italic mb-4">
                "QuackHost transformed our network from a single server struggling with lag to a multi-server powerhouse. Their support team is incredible, and the performance is unmatched."
              </p>
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-full bg-[#FF9C20] flex items-center justify-center text-black font-bold">
                  MJ
                </div>
                <div>
                  <div class="text-white font-semibold">Marcus Johnson</div>
                  <div class="text-cool-gray-40 text-sm">Founder, PixelCraft Network</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Case Studies Grid -->
    <div class="grid md:grid-cols-2 gap-8 mb-20">
      <!-- Case Study 1: SurvivalCraft -->
      <div id="survivalcraft" class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-green-50 transition-all">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-16 h-16 rounded-full bg-green-50/20 flex items-center justify-center text-3xl">
            🌲
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">SurvivalCraft HQ</h3>
            <p class="text-cool-gray-30">Valheim • Rust • ARK</p>
          </div>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Challenge</h4>
          <p class="text-cool-gray-20">
            Running multiple survival game servers on their previous host resulted in constant crashes, poor performance during peak hours, and frustrated players leaving for other servers.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Solution</h4>
          <p class="text-cool-gray-20">
            Migrated to QuackHost's Swan plan with NVMe storage and AMD Ryzen 9 processors. Implemented automated backups and scheduled restarts during off-peak hours using QuackPlane.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Results</h4>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-40">+180%</div>
              <div class="text-cool-gray-30 text-sm">Player Growth</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-40">95%</div>
              <div class="text-cool-gray-30 text-sm">Less Downtime</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-40">60ms</div>
              <div class="text-cool-gray-30 text-sm">Avg Latency</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-green-40">4.9★</div>
              <div class="text-cool-gray-30 text-sm">Player Rating</div>
            </div>
          </div>
        </div>

        <div class="p-4 bg-gray-95 rounded-lg border-l-4 border-green-50">
          <p class="text-white italic text-sm">
            "The difference is night and day. We went from constant complaints to players praising our server performance. Worth every penny."
          </p>
          <p class="text-cool-gray-40 text-xs mt-2">— Sarah K., Server Admin</p>
        </div>
      </div>

      <!-- Case Study 2: Competitive Edge -->
      <div id="competitiveedge" class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-16 h-16 rounded-full bg-cyan-50/20 flex items-center justify-center text-3xl">
            🎯
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">Competitive Edge Gaming</h3>
            <p class="text-cool-gray-30">Counter-Strike 2 • 128-Tick</p>
          </div>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Challenge</h4>
          <p class="text-cool-gray-20">
            Esports organization needed ultra-low latency servers for competitive CS2 matches and scrims. Previous provider couldn't deliver consistent sub-20ms tick rates.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Solution</h4>
          <p class="text-cool-gray-20">
            Deployed dedicated Flock plan servers in multiple regions (US East, EU West, APAC) with 10Gbps networking. Custom 128-tick configurations optimized by QuackHost support team.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Results</h4>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-cyan-50">12ms</div>
              <div class="text-cool-gray-30 text-sm">Avg Tick Rate</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-cyan-50">0</div>
              <div class="text-cool-gray-30 text-sm">Match Delays</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-cyan-50">500+</div>
              <div class="text-cool-gray-30 text-sm">Monthly Matches</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-cyan-50">99.9%</div>
              <div class="text-cool-gray-30 text-sm">Uptime</div>
            </div>
          </div>
        </div>

        <div class="p-4 bg-gray-95 rounded-lg border-l-4 border-cyan-50">
          <p class="text-white italic text-sm">
            "QuackHost is the only provider we trust for tournament play. The tick rates are perfect, and we've never had a server crash mid-match."
          </p>
          <p class="text-cool-gray-40 text-xs mt-2">— Jason T., League Coordinator</p>
        </div>
      </div>

      <!-- Case Study 3: Creative Builders -->
      <div id="creativebuilders" class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-16 h-16 rounded-full bg-purple-50/20 flex items-center justify-center text-3xl">
            🏗️
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">Creative Builders Network</h3>
            <p class="text-cool-gray-30">Minecraft • Creative Mode</p>
          </div>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Challenge</h4>
          <p class="text-cool-gray-20">
            Large creative Minecraft server with massive builds needed more storage and RAM. Previous 100GB limit was constantly exceeded, requiring frequent cleanups that deleted player creations.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Solution</h4>
          <p class="text-cool-gray-20">
            Upgraded to custom Flock plan with 500GB NVMe storage and 32GB RAM. Implemented automated world backups to off-site storage with 30-day retention using QuackPlane's scheduling system.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Results</h4>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-50">5000+</div>
              <div class="text-cool-gray-30 text-sm">Saved Builds</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-50">0</div>
              <div class="text-cool-gray-30 text-sm">Data Loss</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-50">300%</div>
              <div class="text-cool-gray-30 text-sm">More Storage</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-purple-50">24/7</div>
              <div class="text-cool-gray-30 text-sm">Auto Backups</div>
            </div>
          </div>
        </div>

        <div class="p-4 bg-gray-95 rounded-lg border-l-4 border-purple-50">
          <p class="text-white italic text-sm">
            "No more storage anxiety! Our builders can create freely without worrying about space. The automatic backups have saved us multiple times."
          </p>
          <p class="text-cool-gray-40 text-xs mt-2">— Emily R., Community Manager</p>
        </div>
      </div>

      <!-- Case Study 4: PixelCraft (Detailed) -->
      <div id="pixelcraft" class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-[#FF9C20] rounded-xl p-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-16 h-16 rounded-full bg-[#FF9C20]/20 flex items-center justify-center text-3xl">
            ⚡
          </div>
          <div>
            <h3 class="text-2xl font-bold text-white">PixelCraft Network</h3>
            <p class="text-cool-gray-30">Minecraft Network • Multi-Server</p>
          </div>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">The Journey</h4>
          <p class="text-cool-gray-20 mb-3">
            PixelCraft started as a small survival server in 2023 with 20 players. As the community grew, they faced constant performance issues, especially during weekend peak hours when player counts exceeded 100.
          </p>
          <p class="text-cool-gray-20">
            After migrating to QuackHost in early 2024, they expanded to a multi-server network with Survival, Creative, Skyblock, and minigame servers all interconnected through BungeeCord.
          </p>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">Infrastructure</h4>
          <div class="space-y-2 text-cool-gray-20 text-sm">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>12 Servers across 3 regions (US East, EU, APAC)</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Total 96GB RAM, 2TB NVMe storage</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Automated hourly backups with 14-day retention</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-[#FF9C20]" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>DDoS protection (survived 500Gbps attack)</span>
            </div>
          </div>
        </div>

        <div class="mb-6">
          <h4 class="text-white font-semibold mb-3">Growth Metrics</h4>
          <div class="grid grid-cols-2 gap-4">
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-[#FF9C20]">20 → 50K</div>
              <div class="text-cool-gray-30 text-sm">Monthly Players</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-[#FF9C20]">1 → 12</div>
              <div class="text-cool-gray-30 text-sm">Servers</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-[#FF9C20]">85% → 99.98%</div>
              <div class="text-cool-gray-30 text-sm">Uptime SLA</div>
            </div>
            <div class="bg-gray-95 rounded-lg p-4">
              <div class="text-2xl font-bold text-[#FF9C20]">$2K</div>
              <div class="text-cool-gray-30 text-sm">Monthly Revenue</div>
            </div>
          </div>
        </div>

        <div class="p-4 bg-gray-95 rounded-lg border-l-4 border-[#FF9C20]">
          <p class="text-white italic text-sm mb-2">
            "QuackHost didn't just host our servers - they partnered with us to build a thriving community. From migration assistance to custom optimizations, their support team treats us like family."
          </p>
          <p class="text-cool-gray-40 text-xs">— Marcus Johnson, Founder</p>
        </div>
      </div>
    </div>

    <!-- Stats Overview -->
    <div class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-12">
        <h2 class="text-3xl font-bold text-white text-center mb-12">QuackHost Community Impact</h2>
        <div class="grid md:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="text-5xl font-bold text-[#FF9C20] mb-2">10,000+</div>
            <div class="text-cool-gray-20">Active Servers</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-cyan-50 mb-2">5M+</div>
            <div class="text-cool-gray-20">Players Hosted</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-purple-50 mb-2">99.9%</div>
            <div class="text-cool-gray-20">Avg Uptime</div>
          </div>
          <div class="text-center">
            <div class="text-5xl font-bold text-green-50 mb-2">4.9/5</div>
            <div class="text-cool-gray-20">Customer Rating</div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="mb-20">
      <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-12 lg:p-16 text-center">
        <h2 class="text-3xl lg:text-5xl font-bold text-black mb-6">
          Ready to Write Your Success Story?
        </h2>
        <p class="text-xl text-gray-90 mb-8 max-w-2xl mx-auto">
          Join thousands of successful gaming communities powered by QuackHost. Start your journey today with our risk-free 7-day money-back guarantee.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a
            href="/pricing"
            class="px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-gray-90 transition-all hover:scale-105"
          >
            View Pricing Plans
          </a>
          <a
            href="/contact"
            class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-100 transition-all hover:scale-105"
          >
            Talk to Our Team
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
