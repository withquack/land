---
/**
 * QuackPlane Feature Page
 *
 * Showcase the control panel features and capabilities
 */

import Layout from "../layouts/layout.astro";
---

<Layout title="/ QuackPlane Control Panel">
  <div class="mb-16 mt-16 lg:mb-24 lg:mt-24">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <div class="inline-block bg-teal-50/10 border border-teal-50 text-teal-40 px-4 py-2 rounded-full text-sm font-semibold mb-6">
        Powered by QuackPlane
      </div>

      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold mb-6">
        Control Your Server <br />
        <span class="text-gradient">From Anywhere</span>
      </h1>

      <p class="text-xl lg:text-2xl text-cool-gray-30 max-w-3xl mx-auto mb-8">
        Web-based control panel that makes server management simple. No software to install, no complicated commands to memorize.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="/pricing"
          class="inline-flex items-center justify-center gap-2 bg-[#FF9C20] text-black px-8 py-4 rounded-lg text-lg font-bold hover:bg-[#FF8D00] transition-colors"
        >
          Get Started
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <a
          href="https://plane.quack.host"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-cool-gray-80 text-white border-2 border-cool-gray-60 px-8 py-4 rounded-lg text-lg font-bold hover:border-[#FF9C20] transition-colors"
        >
          Try Demo
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>

    <!-- Screenshot -->
    <div class="mb-20">
      <img
        src="/index/quackplane.webp"
        alt="QuackPlane Control Panel Interface"
        class="w-full rounded-lg border-2 border-cool-gray-70 shadow-2xl"
        loading="eager"
      />
    </div>

    <!-- CTA Section -->
    <div class="text-center bg-gradient-to-r from-[#FF9C20]/10 to-[#FF8D00]/10 border border-[#FF9C20] rounded-lg p-12">
      <h2 class="text-3xl lg:text-4xl font-bold mb-4">
        Ready to Experience QuackPlane?
      </h2>
      <p class="text-xl text-cool-gray-30 mb-8">
        Included FREE with every QuackHost server
      </p>
      <a
        href="/pricing"
        class="inline-flex items-center gap-2 bg-[#FF9C20] text-black px-12 py-5 rounded-lg text-xl font-bold hover:bg-[#FF8D00] transition-colors shadow-xl hover:shadow-2xl"
      >
        View Pricing Plans
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</Layout>

<style>
  .text-gradient {
    background: linear-gradient(135deg, #FF9C20 0%, #FF8D00 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
