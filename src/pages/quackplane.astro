---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ QuackPlane">
  <!-- Hero Section -->
  <div class="mb-20 mt-16 lg:mt-32 text-center">
    <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-[#FF9C20]/20 to-cyan-50/20 border border-[#FF9C20]/50 rounded-full">
      <span class="text-[#FF9C20] font-bold text-sm">NEXT-GEN CONTROL PANEL</span>
    </div>
    <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
      Meet <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">QuackPlane</span>
    </h1>
    <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-12">
      The modern control panel built for gamers. Manage your servers from anywhere, on any device, with an interface that actually makes sense.
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <a
        href="/pricing"
        class="px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-2xl hover:shadow-[#FF9C20]/50 transition-all hover:-translate-y-1"
      >
        Start Free Trial
      </a>
      <a
        href="#features"
        class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-[#FF9C20] transition-all"
      >
        Explore Features
      </a>
    </div>
  </div>

  <!-- Key Features Grid -->
  <div id="features" class="mb-20">
    <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
      Everything you need, <span class="text-[#FF9C20]">everywhere you go</span>
    </h2>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <!-- Feature 1: Multi-Device -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-purple-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">📱</div>
        <h3 class="text-xl font-bold text-white mb-3">Access Anywhere</h3>
        <p class="text-cool-gray-20">
          Desktop, tablet, or phone - QuackPlane adapts to your screen. Manage servers from your couch, office, or on the go.
        </p>
      </div>

      <!-- Feature 2: Real-Time Monitoring -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-cyan-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">📊</div>
        <h3 class="text-xl font-bold text-white mb-3">Live Monitoring</h3>
        <p class="text-cool-gray-20">
          Real-time CPU, RAM, and player stats. Beautiful graphs that update every second so you're always in the know.
        </p>
      </div>

      <!-- Feature 3: One-Click Actions -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-[#FF9C20] transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="text-xl font-bold text-white mb-3">One-Click Management</h3>
        <p class="text-cool-gray-20">
          Start, stop, restart servers with a single tap. Install mods, update versions, and manage backups effortlessly.
        </p>
      </div>

      <!-- Feature 4: File Manager -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-purple-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">📁</div>
        <h3 class="text-xl font-bold text-white mb-3">Built-In File Manager</h3>
        <p class="text-cool-gray-20">
          Edit configs, upload files, and browse directories - all from your browser. No FTP client needed.
        </p>
      </div>

      <!-- Feature 5: Console Access -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-cyan-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">💻</div>
        <h3 class="text-xl font-bold text-white mb-3">Live Console</h3>
        <p class="text-cool-gray-20">
          Full console access with command history and auto-complete. Execute commands and see output in real-time.
        </p>
      </div>

      <!-- Feature 6: Scheduled Tasks -->
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-2xl border-2 border-gray-80 hover:border-[#FF9C20] transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
        <div class="text-4xl mb-4">⏰</div>
        <h3 class="text-xl font-bold text-white mb-3">Smart Scheduling</h3>
        <p class="text-cool-gray-20">
          Automate backups, restarts, and maintenance. Set it once and let QuackPlane handle the routine work.
        </p>
      </div>
    </div>
  </div>

  <!-- Interactive Feature Showcase -->
  <div class="mb-20">
    <h2 class="text-3xl lg:text-4xl font-bold text-white text-center mb-12">
      Built for <span class="text-[#FF9C20]">power users</span>
    </h2>

    <div
      x-data="{ activeTab: 'dashboard' }"
      class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl overflow-hidden shadow-2xl"
    >
      <!-- Tab Navigation -->
      <div class="flex flex-wrap border-b border-gray-80 bg-gray-95">
        <button
          @click="activeTab = 'dashboard'"
          :class="activeTab === 'dashboard' ? 'border-b-2 border-[#FF9C20] text-white' : 'text-cool-gray-30 hover:text-white'"
          class="flex-1 min-w-[120px] px-6 py-4 font-semibold transition-all"
        >
          Dashboard
        </button>
        <button
          @click="activeTab = 'console'"
          :class="activeTab === 'console' ? 'border-b-2 border-[#FF9C20] text-white' : 'text-cool-gray-30 hover:text-white'"
          class="flex-1 min-w-[120px] px-6 py-4 font-semibold transition-all"
        >
          Console
        </button>
        <button
          @click="activeTab = 'files'"
          :class="activeTab === 'files' ? 'border-b-2 border-[#FF9C20] text-white' : 'text-cool-gray-30 hover:text-white'"
          class="flex-1 min-w-[120px] px-6 py-4 font-semibold transition-all"
        >
          Files
        </button>
        <button
          @click="activeTab = 'backups'"
          :class="activeTab === 'backups' ? 'border-b-2 border-[#FF9C20] text-white' : 'text-cool-gray-30 hover:text-white'"
          class="flex-1 min-w-[120px] px-6 py-4 font-semibold transition-all"
        >
          Backups
        </button>
      </div>

      <!-- Tab Content -->
      <div class="p-8 lg:p-12">
        <!-- Dashboard Tab -->
        <div x-show="activeTab === 'dashboard'" class="space-y-6">
          <h3 class="text-2xl font-bold text-white mb-4">Server Overview at a Glance</h3>
          <div class="grid md:grid-cols-3 gap-6">
            <div class="bg-gray-95 border border-gray-80 rounded-xl p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-cool-gray-30 text-sm font-semibold">CPU USAGE</span>
                <span class="text-green-40 text-xs font-bold">HEALTHY</span>
              </div>
              <div class="text-3xl font-bold text-white mb-2">24%</div>
              <div class="h-2 bg-gray-80 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-green-50 to-green-40 w-1/4"></div>
              </div>
            </div>
            <div class="bg-gray-95 border border-gray-80 rounded-xl p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-cool-gray-30 text-sm font-semibold">MEMORY</span>
                <span class="text-cyan-50 text-xs font-bold">OPTIMAL</span>
              </div>
              <div class="text-3xl font-bold text-white mb-2">4.2GB / 8GB</div>
              <div class="h-2 bg-gray-80 rounded-full overflow-hidden">
                <div class="h-full bg-gradient-to-r from-cyan-50 to-purple-50 w-1/2"></div>
              </div>
            </div>
            <div class="bg-gray-95 border border-gray-80 rounded-xl p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-cool-gray-30 text-sm font-semibold">PLAYERS</span>
                <span class="text-[#FF9C20] text-xs font-bold">ONLINE</span>
              </div>
              <div class="text-3xl font-bold text-white mb-2">12 / 50</div>
              <div class="flex gap-1 mt-2">
                <div class="w-2 h-2 bg-green-40 rounded-full animate-pulse"></div>
                <div class="text-cool-gray-30 text-xs">Server running</div>
              </div>
            </div>
          </div>
          <p class="text-cool-gray-20 mt-4">
            Monitor server health, track player activity, and spot performance issues before they become problems.
          </p>
        </div>

        <!-- Console Tab -->
        <div x-show="activeTab === 'console'" class="space-y-6">
          <h3 class="text-2xl font-bold text-white mb-4">Full Console Access</h3>
          <div class="bg-gray-95 border border-gray-80 rounded-xl p-6 font-mono text-sm">
            <div class="space-y-2 text-cool-gray-20 mb-4">
              <div>[12:34:56] [Server thread/INFO]: Server started successfully</div>
              <div>[12:35:12] [Server thread/INFO]: Player joined the game</div>
              <div class="text-green-40">[12:35:30] [Server thread/INFO]: Autosave complete</div>
            </div>
            <div class="flex items-center gap-2 mt-4">
              <span class="text-[#FF9C20]">></span>
              <input
                type="text"
                placeholder="Type command here..."
                class="flex-1 bg-transparent border-none outline-none text-white placeholder-cool-gray-40"
                disabled
              />
            </div>
          </div>
          <p class="text-cool-gray-20">
            Real-time log streaming with syntax highlighting. Execute commands instantly and see results as they happen.
          </p>
        </div>

        <!-- Files Tab -->
        <div x-show="activeTab === 'files'" class="space-y-6">
          <h3 class="text-2xl font-bold text-white mb-4">Integrated File Manager</h3>
          <div class="bg-gray-95 border border-gray-80 rounded-xl overflow-hidden">
            <div class="flex items-center gap-4 p-4 bg-gray-100 border-b border-gray-80">
              <svg class="w-5 h-5 text-cool-gray-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
              </svg>
              <span class="text-cool-gray-20 text-sm font-mono">/server/</span>
            </div>
            <div class="divide-y divide-gray-80">
              <div class="flex items-center justify-between p-4 hover:bg-gray-90 cursor-pointer group">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-[#FF9C20]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <span class="text-white font-mono text-sm">server.properties</span>
                </div>
                <span class="text-cool-gray-30 text-xs">2.4 KB</span>
              </div>
              <div class="flex items-center justify-between p-4 hover:bg-gray-90 cursor-pointer group">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-cyan-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                  </svg>
                  <span class="text-white font-mono text-sm">plugins/</span>
                </div>
                <span class="text-cool-gray-30 text-xs">12 items</span>
              </div>
              <div class="flex items-center justify-between p-4 hover:bg-gray-90 cursor-pointer group">
                <div class="flex items-center gap-3">
                  <svg class="w-5 h-5 text-purple-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
                  </svg>
                  <span class="text-white font-mono text-sm">worlds/</span>
                </div>
                <span class="text-cool-gray-30 text-xs">3 items</span>
              </div>
            </div>
          </div>
          <p class="text-cool-gray-20">
            Edit configs directly in your browser with syntax highlighting. Upload, download, and organize files with drag-and-drop.
          </p>
        </div>

        <!-- Backups Tab -->
        <div x-show="activeTab === 'backups'" class="space-y-6">
          <h3 class="text-2xl font-bold text-white mb-4">Automated Backup System</h3>
          <div class="space-y-3">
            <div class="bg-gray-95 border border-gray-80 rounded-xl p-6 flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-green-50/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-green-40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="text-white font-semibold">Daily Backup</div>
                  <div class="text-cool-gray-30 text-sm">Today at 3:00 AM • 1.2 GB</div>
                </div>
              </div>
              <button class="px-4 py-2 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg text-sm hover:shadow-lg transition-all">
                Restore
              </button>
            </div>
            <div class="bg-gray-95 border border-gray-80 rounded-xl p-6 flex items-center justify-between">
              <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-cyan-50/20 flex items-center justify-center">
                  <svg class="w-6 h-6 text-cyan-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <div>
                  <div class="text-white font-semibold">Weekly Backup</div>
                  <div class="text-cool-gray-30 text-sm">Sunday at 12:00 AM • 1.1 GB</div>
                </div>
              </div>
              <button class="px-4 py-2 bg-gray-80 text-white font-bold rounded-lg text-sm hover:bg-gray-70 transition-all">
                Download
              </button>
            </div>
          </div>
          <p class="text-cool-gray-20 mt-4">
            Scheduled backups run automatically. One-click restore in case something goes wrong. Your data is always safe.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Platform Compatibility -->
  <div class="mb-20">
    <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-8 lg:p-12 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
        Works on <span class="text-[#FF9C20]">everything</span>
      </h2>
      <p class="text-xl text-cool-gray-20 mb-12 max-w-2xl mx-auto">
        QuackPlane is fully responsive and works seamlessly across all your devices and browsers.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-3xl mx-auto">
        <div class="flex flex-col items-center gap-3">
          <div class="text-5xl">💻</div>
          <span class="text-white font-semibold">Desktop</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="text-5xl">📱</div>
          <span class="text-white font-semibold">Mobile</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="text-5xl">📟</div>
          <span class="text-white font-semibold">Tablet</span>
        </div>
        <div class="flex flex-col items-center gap-3">
          <div class="text-5xl">🌐</div>
          <span class="text-white font-semibold">Any Browser</span>
        </div>
      </div>
    </div>
  </div>

  <!-- CTA Section -->
  <div class="mb-20">
    <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-12 lg:p-16 text-center">
      <h2 class="text-3xl lg:text-5xl font-bold text-black mb-6">
        Ready to experience QuackPlane?
      </h2>
      <p class="text-xl text-gray-90 mb-8 max-w-2xl mx-auto">
        Start managing your servers the modern way. Free trial included with all plans.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="/pricing"
          class="px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-gray-90 transition-all hover:scale-105"
        >
          View Pricing Plans
        </a>
        <a
          href="/games"
          class="px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-gray-100 transition-all hover:scale-105"
        >
          Browse Games
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  Alpine.start();
</script>
