---
import Layout from "../../layouts/layout.astro";
---

<Layout title="Rust Server Hosting - QuackHost">
  <div class="max-w-7xl mx-auto">

    <!-- Hero Section -->
    <div class="mb-20 mt-16 lg:mt-32 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-cyan-50/10 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative">
        <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-cyan-50/20 to-green-50/20 border border-cyan-50/50 rounded-full">
          <span class="text-cyan-50 font-bold text-sm">⚡ RUST SERVER HOSTING</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
          High-Performance <br class="hidden lg:block"/>
          <span class="bg-gradient-to-r from-cyan-50 to-green-50 bg-clip-text text-transparent">Rust Server Hosting</span>
        </h1>
        <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
          Powerful dedicated resources, instant wipes, and uMod/Oxide support. Built for survival servers that never lag.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/pricing" class="px-8 py-4 bg-gradient-to-r from-cyan-50 to-green-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-lg">
            View Rust Plans →
          </a>
          <a href="/blog/rust-server-setup-guide" class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-cyan-50 transition-all text-lg">
            Setup Guide
          </a>
        </div>
      </div>
    </div>

    <!-- Key Features for Rust -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Optimized for Rust's Demands
        </h2>
        <p class="text-xl text-cool-gray-20 max-w-3xl mx-auto">
          Rust servers are notoriously resource-intensive. We've built our infrastructure specifically to handle it.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">💨</div>
          <h3 class="text-2xl font-bold text-white mb-3">Dedicated CPU Cores</h3>
          <p class="text-cool-gray-20 mb-4">
            No CPU sharing. Your server gets dedicated Ryzen 9 7950X cores for consistent performance even during monument runs.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 3.5GHz+ single-thread performance</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">🗺️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Large Map Support</h3>
          <p class="text-cool-gray-20 mb-4">
            Host procedural maps up to 6000 size or custom maps. NVMe SSDs handle map generation and saves with zero lag spikes.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 5000 size maps standard</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-2xl font-bold text-white mb-3">uMod/Oxide Ready</h3>
          <p class="text-cool-gray-20 mb-4">
            Pre-installed Oxide framework. Install plugins from umod.org with one click. Kits, teleports, clans, and more.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 1000+ compatible plugins</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">🔄</div>
          <h3 class="text-2xl font-bold text-white mb-3">Auto-Wipe Scheduling</h3>
          <p class="text-cool-gray-20 mb-4">
            Configure weekly, bi-weekly, or monthly wipes. Automatic BP wipes, map changes, and server restarts on your schedule.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Follows Facepunch forced wipes</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Advanced DDoS Protection</h3>
          <p class="text-cool-gray-20 mb-4">
            Rust servers are prime targets. Our 1+ Tbps protection keeps you online even during rage attacks from banned players.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Automatic mitigation &lt;60s</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-4xl mb-4">⚙️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Pre-Configured Settings</h3>
          <p class="text-cool-gray-20 mb-4">
            Optimized server.cfg, decay rates, gather multipliers, and performance settings. Start with best practices out of the box.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Customizable via panel</div>
        </div>
      </div>
    </section>

    <!-- Rust-Specific Pricing -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Rust Server Plans
        </h2>
        <p class="text-xl text-cool-gray-20">
          RAM and CPU configured specifically for Rust's requirements
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Duck Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <h3 class="text-2xl font-bold text-white mb-2">Duck</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$16</span>
            <span class="text-cool-gray-40">/mo</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li>8GB DDR5 RAM</li>
            <li>2 Dedicated Cores</li>
            <li>80GB NVMe SSD</li>
            <li class="text-white font-semibold">10-25 players</li>
            <li>3500 map size</li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 text-white font-bold rounded-lg hover:bg-gray-70 transition-all text-center">
            Order Now
          </a>
        </div>

        <!-- Goose Plan - Popular -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-cyan-50 rounded-xl p-8 relative">
          <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 px-3 py-1 bg-cyan-50 text-black text-xs font-bold rounded-full">
            POPULAR
          </div>
          <h3 class="text-2xl font-bold text-white mb-2">Goose</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$32</span>
            <span class="text-cool-gray-40">/mo</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="text-white">16GB DDR5 RAM</li>
            <li class="text-white">4 Dedicated Cores</li>
            <li>160GB NVMe SSD</li>
            <li class="text-cyan-50 font-semibold">25-75 players</li>
            <li>5000 map size</li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gradient-to-r from-cyan-50 to-green-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-center">
            Order Now
          </a>
        </div>

        <!-- Swan Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <h3 class="text-2xl font-bold text-white mb-2">Swan</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$64</span>
            <span class="text-cool-gray-40">/mo</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li>32GB DDR5 RAM</li>
            <li>6 Dedicated Cores</li>
            <li>320GB NVMe SSD</li>
            <li class="text-white font-semibold">75-150 players</li>
            <li>6000 map size</li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 text-white font-bold rounded-lg hover:bg-gray-70 transition-all text-center">
            Order Now
          </a>
        </div>

        <!-- Flock Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-green-50 transition-all">
          <h3 class="text-2xl font-bold text-white mb-2">Flock</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$128</span>
            <span class="text-cool-gray-40">/mo</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li>64GB DDR5 RAM</li>
            <li>8 Dedicated Cores</li>
            <li>640GB NVMe SSD</li>
            <li class="text-white font-semibold">150-300+ players</li>
            <li>Custom map size</li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 text-white font-bold rounded-lg hover:bg-gray-70 transition-all text-center">
            Order Now
          </a>
        </div>
      </div>

      <div class="bg-gradient-to-br from-cyan-50/10 to-green-50/10 border-2 border-cyan-50/50 rounded-xl p-6 text-center">
        <p class="text-white mb-2">
          <strong>Note:</strong> Rust requires more resources than most games. We recommend starting with Goose (16GB) for the best experience.
        </p>
        <p class="text-cool-gray-20 text-sm">Duck plan suitable for small friend servers only (10-15 players max)</p>
      </div>
    </section>

    <!-- Plugin Library -->
    <section class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-8 text-center">
          Essential Rust Plugins Pre-Installed
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">Kits</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Create starter kits, VIP kits, and auto-kits for players</p>
            <div class="text-cool-gray-40 text-xs">Most Popular</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">NTeleportation</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Home, town, and friend teleports with cooldowns</p>
            <div class="text-cool-gray-40 text-xs">Quality of Life</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">Economics</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Currency system for shops and trading</p>
            <div class="text-cool-gray-40 text-xs">RP/Economy</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">Clans</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Team system with shared cupboards and chat</p>
            <div class="text-cool-gray-40 text-xs">Team Play</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">Admin Radar</h3>
            <p class="text-cool-gray-20 text-sm mb-3">ESP and admin tools for server moderation</p>
            <div class="text-cool-gray-40 text-xs">Moderation</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-cyan-50 mb-2">Stack Size</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Customize stack sizes for items and resources</p>
            <div class="text-cool-gray-40 text-xs">Customization</div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-cool-gray-20 mb-3">Browse 1,000+ more plugins at umod.org</p>
          <p class="text-cool-gray-40 text-sm">All compatible plugins can be installed via one-click in QuackPlane</p>
        </div>
      </div>
    </section>

    <!-- Performance Specs -->
    <section class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
        Real-World Rust Performance
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 text-center">
          <div class="text-5xl font-bold text-cyan-50 mb-2">60 FPS</div>
          <div class="text-xl text-white mb-3">Server</div>
          <p class="text-cool-gray-20 text-sm">
            Locked 60 FPS server tick rate. No stuttering during PVP or base raids.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 text-center">
          <div class="text-5xl font-bold text-green-50 mb-2">&lt;20s</div>
          <div class="text-xl text-white mb-3">Map Saves</div>
          <p class="text-cool-gray-20 text-sm">
            Full map saves complete in under 20 seconds on NVMe. No save lag spikes.
          </p>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 text-center">
          <div class="text-5xl font-bold text-purple-50 mb-2">24/7</div>
          <div class="text-xl text-white mb-3">Uptime</div>
          <p class="text-cool-gray-20 text-sm">
            99.9% uptime SLA. Automated restarts and wipes happen on schedule.
          </p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
        Rust Server FAQ
      </h2>

      <div class="max-w-3xl mx-auto space-y-4">
        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">What map size should I use?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Map size depends on your expected player count:</p>
            <ul class="space-y-2 text-sm">
              <li>• <strong class="text-white">3000-3500:</strong> 10-25 players, close-quarters PVP</li>
              <li>• <strong class="text-white">4000-4500:</strong> 25-50 players, balanced gameplay</li>
              <li>• <strong class="text-white">5000-5500:</strong> 50-100 players, exploration-focused</li>
              <li>• <strong class="text-white">6000+:</strong> 100+ players, large servers only (Swan/Flock)</li>
            </ul>
            <p class="mt-3 text-sm">Larger maps use more RAM. Consult our sizing guide or contact support.</p>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">How do wipes work?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Rust requires periodic wipes to maintain server health:</p>
            <ul class="space-y-2 text-sm">
              <li>• <strong class="text-white">Forced Wipe:</strong> First Thursday of every month (mandated by Facepunch)</li>
              <li>• <strong class="text-white">Optional Wipes:</strong> You control weekly, bi-weekly, or custom schedules</li>
              <li>• <strong class="text-white">BP Wipes:</strong> Can be separate from map wipes</li>
              <li>• <strong class="text-white">Automated:</strong> QuackPlane handles wipes automatically on your schedule</li>
            </ul>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">Can I run a modded Rust server?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Yes! All plans support:</p>
            <ul class="space-y-2 text-sm">
              <li>• Vanilla Rust servers</li>
              <li>• uMod/Oxide plugin servers (most common)</li>
              <li>• Custom plugins and configurations</li>
              <li>• Modded gather rates, stack sizes, kits, etc.</li>
            </ul>
            <p class="mt-3 text-sm">Oxide/uMod comes pre-installed. Add plugins via QuackPlane panel.</p>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">Do I need DDoS protection for Rust?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3"><strong class="text-white">Absolutely.</strong> Rust servers are heavily targeted:</p>
            <ul class="space-y-2 text-sm">
              <li>• Banned players frequently retaliate with DDoS attacks</li>
              <li>• Rival servers attack competitors to steal players</li>
              <li>• Raid griefing through server attacks is common</li>
            </ul>
            <p class="mt-3 text-sm">All QuackHost plans include enterprise-grade DDoS protection at no extra cost.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-20">
      <div class="bg-gradient-to-r from-cyan-50 to-green-50 rounded-2xl p-1">
        <div class="bg-gray-100 rounded-xl p-12 lg:p-16 text-center">
          <h2 class="text-3xl lg:text-5xl font-bold text-white mb-6">
            Launch Your Rust Server Today
          </h2>
          <p class="text-xl text-cool-gray-20 mb-8 max-w-2xl mx-auto">
            Instant setup, pre-configured optimization, and 24/7 support. Start dominating the wasteland.
          </p>
          <div class="flex flex-wrap gap-4 justify-center">
            <a href="/pricing" class="px-8 py-4 bg-gradient-to-r from-cyan-50 to-green-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-lg">
              View Plans →
            </a>
            <a href="/blog/rust-server-setup-guide" class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-cyan-50 transition-all text-lg">
              Read Setup Guide
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Resources -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-8">Related Resources</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/blog/rust-server-setup-guide" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-cyan-50 transition-all">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-cyan-50 transition-colors">Rust Server Setup Guide</h3>
          <p class="text-cool-gray-40 text-sm">Complete walkthrough from creation to optimization</p>
        </a>

        <a href="/blog/ddos-protection-guide" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-green-50 transition-all">
          <div class="text-3xl mb-3">🛡️</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-green-50 transition-colors">DDoS Protection Guide</h3>
          <p class="text-cool-gray-40 text-sm">Learn how we keep your Rust server online</p>
        </a>

        <a href="/support" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-[#FF9C20] transition-all">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-[#FF9C20] transition-colors">24/7 Support</h3>
          <p class="text-cool-gray-40 text-sm">Get help from Rust hosting experts</p>
        </a>
      </div>
    </section>

  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  Alpine.start();
</script>
