---
import Layout from "../../layouts/layout.astro";
---

<Layout title="Minecraft Server Hosting - QuackHost">
  <div class="max-w-7xl mx-auto">

    <!-- Hero Section -->
    <div class="mb-20 mt-16 lg:mt-32 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-[#FF9C20]/10 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative">
        <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-[#FF9C20]/20 to-purple-50/20 border border-[#FF9C20]/50 rounded-full">
          <span class="text-[#FF9C20] font-bold text-sm">🎮 MINECRAFT SERVER HOSTING</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
          The Ultimate Minecraft <br class="hidden lg:block"/>
          <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">Server Hosting</span>
        </h1>
        <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
          Lightning-fast NVMe SSD storage, instant setup, and enterprise-grade DDoS protection. Host your Minecraft world with confidence.
        </p>
        <div class="flex flex-wrap gap-4 justify-center mb-12">
          <a href="/pricing" class="px-8 py-4 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg transition-all text-lg">
            View Plans & Pricing →
          </a>
          <a href="#features" class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-[#FF9C20] transition-all text-lg">
            Learn More
          </a>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-[#FF9C20] mb-1">&lt;60s</div>
            <div class="text-cool-gray-40 text-sm">Instant Setup</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-cyan-50 mb-1">99.9%</div>
            <div class="text-cool-gray-40 text-sm">Uptime SLA</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-purple-50 mb-1">24/7</div>
            <div class="text-cool-gray-40 text-sm">Expert Support</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-green-50 mb-1">DDoS</div>
            <div class="text-cool-gray-40 text-sm">Protected</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Why Choose QuackHost for Minecraft -->
    <section id="features" class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Why Choose QuackHost for Minecraft?
        </h2>
        <p class="text-xl text-cool-gray-20 max-w-3xl mx-auto">
          We've optimized every aspect of our infrastructure specifically for Minecraft servers
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-2xl font-bold text-white mb-3">NVMe SSD Storage</h3>
          <p class="text-cool-gray-20 mb-4">
            6x faster than traditional SSDs. Chunk loading, world saves, and backups happen in milliseconds.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Eliminate lag from disk I/O</div>
        </div>

        <!-- Feature 2 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🎯</div>
          <h3 class="text-2xl font-bold text-white mb-3">Optimized for 20 TPS</h3>
          <p class="text-cool-gray-20 mb-4">
            Pre-tuned server configs, Aikar's flags, and automatic optimization. Your server runs at perfect 20 TPS.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Butter-smooth gameplay</div>
        </div>

        <!-- Feature 3 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-2xl font-bold text-white mb-3">One-Click Mod Packs</h3>
          <p class="text-cool-gray-20 mb-4">
            Install Forge, Fabric, Paper, Purpur, or any mod pack with a single click. No terminal required.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 200+ mod packs available</div>
        </div>

        <!-- Feature 4 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Advanced DDoS Protection</h3>
          <p class="text-cool-gray-20 mb-4">
            Multi-layer protection stops attacks before they reach your server. Stay online during griefing attempts.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ Tested up to 720 Gbps</div>
        </div>

        <!-- Feature 5 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">💾</div>
          <h3 class="text-2xl font-bold text-white mb-3">Automatic Backups</h3>
          <p class="text-cool-gray-20 mb-4">
            Daily automated backups with one-click restore. Never lose your world to corruption or accidents.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 7-day retention included</div>
        </div>

        <!-- Feature 6 -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-[#FF9C20] transition-all">
          <div class="text-4xl mb-4">🌍</div>
          <h3 class="text-2xl font-bold text-white mb-3">Global Locations</h3>
          <p class="text-cool-gray-20 mb-4">
            12 data centers across NA, EU, and Asia-Pacific. Host close to your players for the lowest ping.
          </p>
          <div class="text-cyan-50 text-sm font-semibold">→ 5-15ms avg ping</div>
        </div>
      </div>
    </section>

    <!-- Minecraft Versions & Platforms -->
    <section class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-8 text-center">
          All Minecraft Versions & Platforms Supported
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6 text-center">
            <div class="text-3xl mb-3">⚒️</div>
            <h3 class="text-xl font-bold text-white mb-2">Vanilla</h3>
            <p class="text-cool-gray-20 text-sm">Pure Minecraft experience, latest versions</p>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6 text-center">
            <div class="text-3xl mb-3">📜</div>
            <h3 class="text-xl font-bold text-white mb-2">Paper / Purpur</h3>
            <p class="text-cool-gray-20 text-sm">Optimized servers with plugin support</p>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6 text-center">
            <div class="text-3xl mb-3">🔨</div>
            <h3 class="text-xl font-bold text-white mb-2">Forge / Fabric</h3>
            <p class="text-cool-gray-20 text-sm">Full modding capabilities, any mod pack</p>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6 text-center">
            <div class="text-3xl mb-3">📦</div>
            <h3 class="text-xl font-bold text-white mb-2">Mod Packs</h3>
            <p class="text-cool-gray-20 text-sm">FTB, Curseforge, ATM, and more</p>
          </div>
        </div>

        <div class="text-center">
          <p class="text-cool-gray-20 mb-4">Need Bedrock Edition or Pocket Edition support?</p>
          <a href="/support" class="text-cyan-50 hover:underline font-semibold">Contact our team →</a>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Minecraft Server Plans
        </h2>
        <p class="text-xl text-cool-gray-20 max-w-3xl mx-auto">
          Scalable plans for every server size, from small friend groups to massive networks
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Duck Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-2xl mb-2">🦆</div>
          <h3 class="text-2xl font-bold text-white mb-2">Duck</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$8</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>4GB DDR5 RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>2 CPU Cores</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>40GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>5-15 players</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>DDoS Protection</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-bold rounded-lg hover:border-cyan-50 transition-all text-center">
            Get Started
          </a>
        </div>

        <!-- Goose Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-[#FF9C20] rounded-xl p-8 relative">
          <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 px-3 py-1 bg-[#FF9C20] text-black text-xs font-bold rounded-full">
            POPULAR
          </div>
          <div class="text-2xl mb-2">🪿</div>
          <h3 class="text-2xl font-bold text-white mb-2">Goose</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$16</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-[#FF9C20]">✓</span>
              <span><strong class="text-white">8GB DDR5 RAM</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#FF9C20]">✓</span>
              <span><strong class="text-white">4 CPU Cores</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#FF9C20]">✓</span>
              <span>80GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#FF9C20]">✓</span>
              <span><strong class="text-white">15-50 players</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#FF9C20]">✓</span>
              <span>Priority Support</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg transition-all text-center">
            Get Started
          </a>
        </div>

        <!-- Swan Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-2xl mb-2">🦢</div>
          <h3 class="text-2xl font-bold text-white mb-2">Swan</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$32</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>16GB DDR5 RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>6 CPU Cores</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>160GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>50-100 players</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>Premium Support</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-bold rounded-lg hover:border-purple-50 transition-all text-center">
            Get Started
          </a>
        </div>

        <!-- Flock Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-green-50 transition-all">
          <div class="text-2xl mb-2">🦜</div>
          <h3 class="text-2xl font-bold text-white mb-2">Flock</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$64</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-green-50">✓</span>
              <span>32GB DDR5 RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-50">✓</span>
              <span>8 CPU Cores</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-50">✓</span>
              <span>320GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-50">✓</span>
              <span>100-200+ players</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-green-50">✓</span>
              <span>Dedicated Support</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-bold rounded-lg hover:border-green-50 transition-all text-center">
            Get Started
          </a>
        </div>
      </div>

      <div class="text-center">
        <p class="text-cool-gray-20 mb-4">Need more than 200 players? Running a network?</p>
        <a href="/support" class="text-cyan-50 hover:underline font-semibold">Contact us for custom enterprise plans →</a>
      </div>
    </section>

    <!-- Performance Benchmarks -->
    <section class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-8 text-center">
          Real-World Performance
        </h2>

        <div class="grid md:grid-cols-3 gap-8 mb-8">
          <div class="text-center">
            <div class="text-5xl font-bold text-[#FF9C20] mb-2">20.0</div>
            <div class="text-xl text-white mb-2">TPS</div>
            <p class="text-cool-gray-40 text-sm">Perfect tick rate even with 50+ players and complex red stone</p>
          </div>

          <div class="text-center">
            <div class="text-5xl font-bold text-cyan-50 mb-2">&lt;1s</div>
            <div class="text-xl text-white mb-2">Chunk Load</div>
            <p class="text-cool-gray-40 text-sm">NVMe storage loads chunks faster than players can fly</p>
          </div>

          <div class="text-center">
            <div class="text-5xl font-bold text-purple-50 mb-2">8ms</div>
            <div class="text-xl text-white mb-2">Avg Ping</div>
            <p class="text-cool-gray-40 text-sm">Low latency routing to all major regions</p>
          </div>
        </div>

        <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-8">
          <h3 class="text-2xl font-bold text-white mb-4 text-center">Tested With Popular Mods</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center text-cool-gray-20 text-sm">
            <div>✓ Create Mod</div>
            <div>✓ Pixelmon</div>
            <div>✓ RLCraft</div>
            <div>✓ All The Mods</div>
            <div>✓ SkyFactory</div>
            <div>✓ Vault Hunters</div>
            <div>✓ Better Minecraft</div>
            <div>✓ FTB Packs</div>
          </div>
        </div>
      </div>
    </section>

    <!-- QuackPlane Panel Features -->
    <section class="mb-20">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
            Manage Your Server with QuackPlane
          </h2>
          <p class="text-xl text-cool-gray-20 mb-8">
            Powerful, intuitive control panel designed specifically for Minecraft hosting
          </p>

          <div class="space-y-4">
            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#FF9C20]/20 flex items-center justify-center text-xl">📁</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">File Manager</h3>
                <p class="text-cool-gray-20 text-sm">Edit configs, upload worlds, manage plugins - all from your browser</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-cyan-50/20 flex items-center justify-center text-xl">💬</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Live Console</h3>
                <p class="text-cool-gray-20 text-sm">Real-time server console with command history and autocomplete</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-purple-50/20 flex items-center justify-center text-xl">📊</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Performance Monitoring</h3>
                <p class="text-cool-gray-20 text-sm">Track TPS, memory usage, player count, and more in real-time</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-green-50/20 flex items-center justify-center text-xl">🔌</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Plugin Installer</h3>
                <p class="text-cool-gray-20 text-sm">Browse and install plugins from Spigot, Bukkit, and CurseForge</p>
              </div>
            </div>

            <div class="flex gap-4 items-start">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#FF9C20]/20 flex items-center justify-center text-xl">⏰</div>
              <div>
                <h3 class="text-lg font-bold text-white mb-1">Scheduled Tasks</h3>
                <p class="text-cool-gray-20 text-sm">Automatic restarts, backups, and custom commands on your schedule</p>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-2xl p-12 border-2 border-gray-80 flex items-center justify-center min-h-96">
          <div class="text-center">
            <div class="text-8xl mb-4">🖥️</div>
            <p class="text-cool-gray-40">QuackPlane Dashboard Preview</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials -->
    <section class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
        Trusted by Thousands of Minecraft Communities
      </h2>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
          <div class="flex items-center gap-2 mb-4">
            <div class="text-2xl">⭐⭐⭐⭐⭐</div>
          </div>
          <p class="text-cool-gray-20 mb-4">
            "Been hosting our SMP server here for 6 months. Zero downtime, amazing performance, and support responds in minutes. Best hosting we've ever used."
          </p>
          <div class="text-white font-semibold">- CraftedRealms Network</div>
          <div class="text-cool-gray-40 text-sm">85 avg players</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
          <div class="flex items-center gap-2 mb-4">
            <div class="text-2xl">⭐⭐⭐⭐⭐</div>
          </div>
          <p class="text-cool-gray-20 mb-4">
            "Switched from another host and instantly noticed the difference. Our server now runs at 20 TPS even during peak hours. Players love the zero lag."
          </p>
          <div class="text-white font-semibold">- PixelVerse SMP</div>
          <div class="text-cool-gray-40 text-sm">120 avg players</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8">
          <div class="flex items-center gap-2 mb-4">
            <div class="text-2xl">⭐⭐⭐⭐⭐</div>
          </div>
          <p class="text-cool-gray-20 mb-4">
            "Setup was literally under 60 seconds. Imported our world, installed plugins through the panel, and we were live. Game changer for server owners."
          </p>
          <div class="text-white font-semibold">- SkyBlock Legends</div>
          <div class="text-cool-gray-40 text-sm">45 avg players</div>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
        Frequently Asked Questions
