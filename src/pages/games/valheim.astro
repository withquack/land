---
import Layout from "../../layouts/layout.astro";
---

<Layout title="Valheim Server Hosting - QuackHost">
  <div class="max-w-7xl mx-auto">

    <!-- Hero Section -->
    <div class="mb-20 mt-16 lg:mt-32 text-center relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-purple-50/10 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative">
        <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-purple-50/20 to-cyan-50/20 border border-purple-50/50 rounded-full">
          <span class="text-purple-50 font-bold text-sm">⚔️ VALHEIM SERVER HOSTING</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
          Explore Valheim <br class="hidden lg:block"/>
          <span class="bg-gradient-to-r from-purple-50 to-cyan-50 bg-clip-text text-transparent">With Your Clan</span>
        </h1>
        <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
          Powerful dedicated servers for your Viking adventures. Instant setup, mod support, and automatic world backups.
        </p>
        <div class="flex flex-wrap gap-4 justify-center mb-12">
          <a href="/pricing" class="px-8 py-4 bg-gradient-to-r from-purple-50 to-cyan-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-lg">
            Start Your Server →
          </a>
          <a href="#features" class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-purple-50 transition-all text-lg">
            Learn More
          </a>
        </div>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-purple-50 mb-1">2 Min</div>
            <div class="text-cool-gray-40 text-sm">Setup Time</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-cyan-50 mb-1">10+</div>
            <div class="text-cool-gray-40 text-sm">Players Supported</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-green-50 mb-1">Mods</div>
            <div class="text-cool-gray-40 text-sm">BepInEx Ready</div>
          </div>
          <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6">
            <div class="text-3xl font-bold text-[#FF9C20] mb-1">24/7</div>
            <div class="text-cool-gray-40 text-sm">Always Online</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Why Choose QuackHost for Valheim -->
    <section id="features" class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Perfect for Viking Adventures
        </h2>
        <p class="text-xl text-cool-gray-20 max-w-3xl mx-auto">
          Everything you need to run a smooth Valheim server for your clan
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">⚡</div>
          <h3 class="text-2xl font-bold text-white mb-3">Instant World Setup</h3>
          <p class="text-cool-gray-20 mb-4">
            Create a new Valheim world in under 2 minutes. Pre-configured settings optimized for smooth gameplay.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ Zero configuration required</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">🔧</div>
          <h3 class="text-2xl font-bold text-white mb-3">BepInEx Mod Support</h3>
          <p class="text-cool-gray-20 mb-4">
            Install Valheim Plus, build tweaks, and quality-of-life mods with one click through our panel.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ 500+ mods compatible</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">💾</div>
          <h3 class="text-2xl font-bold text-white mb-3">World Backups</h3>
          <p class="text-cool-gray-20 mb-4">
            Automatic daily backups of your Valheim world. Restore anytime if something goes wrong during a raid.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ 7-day retention</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">🛡️</div>
          <h3 class="text-2xl font-bold text-white mb-3">DDoS Protection</h3>
          <p class="text-cool-gray-20 mb-4">
            Enterprise-grade protection keeps your server online even during attacks. Your clan stays connected.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ 1+ Tbps capacity</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">🌍</div>
          <h3 class="text-2xl font-bold text-white mb-3">Low Latency</h3>
          <p class="text-cool-gray-20 mb-4">
            12 global data centers ensure low ping for your players. Choose the location closest to your group.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ 5-20ms avg ping</div>
        </div>

        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-4xl mb-4">⚙️</div>
          <h3 class="text-2xl font-bold text-white mb-3">Easy Management</h3>
          <p class="text-cool-gray-20 mb-4">
            Control your server through QuackPlane. Start, stop, restart, and configure settings from your browser.
          </p>
          <div class="text-purple-50 text-sm font-semibold">→ No terminal needed</div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-5xl font-bold text-white mb-4">
          Valheim Server Plans
        </h2>
        <p class="text-xl text-cool-gray-20 max-w-3xl mx-auto">
          Choose the right size for your Viking clan
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        <!-- Duck Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-purple-50 transition-all">
          <div class="text-2xl mb-2">🦆</div>
          <h3 class="text-2xl font-bold text-white mb-2">Duck</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$8</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>4GB DDR5 RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>2 CPU Cores</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>40GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span><strong class="text-white">2-5 players</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>Small worlds</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-bold rounded-lg hover:border-purple-50 transition-all text-center">
            Get Started
          </a>
        </div>

        <!-- Goose Plan - Popular -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-purple-50 rounded-xl p-8 relative">
          <div class="absolute -top-3 left-1/2 transform -translate-x-1/2 px-3 py-1 bg-purple-50 text-black text-xs font-bold rounded-full">
            MOST POPULAR
          </div>
          <div class="text-2xl mb-2">🪿</div>
          <h3 class="text-2xl font-bold text-white mb-2">Goose</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$16</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span><strong class="text-white">8GB DDR5 RAM</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span><strong class="text-white">4 CPU Cores</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>80GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span><strong class="text-white">5-10 players</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-purple-50">✓</span>
              <span>Medium to large worlds</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gradient-to-r from-purple-50 to-cyan-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-center">
            Get Started
          </a>
        </div>

        <!-- Swan Plan -->
        <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-8 hover:border-cyan-50 transition-all">
          <div class="text-2xl mb-2">🦢</div>
          <h3 class="text-2xl font-bold text-white mb-2">Swan</h3>
          <div class="mb-4">
            <span class="text-4xl font-bold text-white">$32</span>
            <span class="text-cool-gray-40">/month</span>
          </div>
          <ul class="space-y-3 mb-6 text-cool-gray-20 text-sm">
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>16GB DDR5 RAM</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>6 CPU Cores</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>160GB NVMe SSD</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span><strong class="text-white">10-20+ players</strong></span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-cyan-50">✓</span>
              <span>Heavily modded servers</span>
            </li>
          </ul>
          <a href="/pricing" class="block w-full px-6 py-3 bg-gray-80 border-2 border-gray-70 text-white font-bold rounded-lg hover:border-cyan-50 transition-all text-center">
            Get Started
          </a>
        </div>
      </div>

      <div class="bg-gradient-to-br from-purple-50/10 to-cyan-50/10 border-2 border-purple-50/50 rounded-xl p-6 text-center">
        <p class="text-white mb-2">
          <strong>💡 Recommendation:</strong> Goose plan (8GB) handles most Valheim servers perfectly, even with mods.
        </p>
        <p class="text-cool-gray-20 text-sm">Duck plan suitable for 2-5 player friend groups. Swan for large communities or heavy modding.</p>
      </div>
    </section>

    <!-- Popular Mods -->
    <section class="mb-20">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-2xl p-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-white mb-8 text-center">
          Popular Valheim Mods Supported
        </h2>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Valheim Plus</h3>
            <p class="text-cool-gray-20 text-sm mb-3">QoL improvements, building tweaks, difficulty adjustments</p>
            <div class="text-cool-gray-40 text-xs">Essential Mod</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Build Camera</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Advanced building controls and camera angles</p>
            <div class="text-cool-gray-40 text-xs">Building</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Epic Loot</h3>
            <p class="text-cool-gray-20 text-sm mb-3">RPG-style loot system with magic items</p>
            <div class="text-cool-gray-40 text-xs">Gameplay</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Better Raids</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Enhanced raid mechanics and difficulty</p>
            <div class="text-cool-gray-40 text-xs">Challenge</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Farming & Cooking</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Expanded farming, crops, and recipes</p>
            <div class="text-cool-gray-40 text-xs">Survival</div>
          </div>

          <div class="bg-gradient-to-br from-gray-80 to-gray-90 rounded-xl p-6">
            <h3 class="text-lg font-bold text-purple-50 mb-2">Advanced Portals</h3>
            <p class="text-cool-gray-20 text-sm mb-3">Portal customization and ore transport</p>
            <div class="text-cool-gray-40 text-xs">Quality of Life</div>
          </div>
        </div>

        <div class="text-center">
          <p class="text-cool-gray-20 mb-3">Install mods through Thunderstore or manual upload</p>
          <p class="text-cool-gray-40 text-sm">BepInEx framework included - all mods compatible</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="mb-20">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-12 text-center">
        Valheim Server FAQ
      </h2>

      <div class="max-w-3xl mx-auto space-y-4">
        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">How many players can my Valheim server support?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Valheim is well-optimized compared to other survival games:</p>
            <ul class="space-y-2 text-sm">
              <li>• <strong class="text-white">Duck (4GB):</strong> 2-5 players comfortably</li>
              <li>• <strong class="text-white">Goose (8GB):</strong> 5-10 players, recommended for most groups</li>
              <li>• <strong class="text-white">Swan (16GB):</strong> 10-20+ players, or heavy modding</li>
            </ul>
            <p class="mt-3 text-sm">Valheim's official max is 10 players, but mods can increase this limit.</p>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">Can I transfer my existing Valheim world?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Yes! Upload your existing world through QuackPlane:</p>
            <ol class="space-y-2 text-sm list-decimal list-inside">
              <li>Locate your world files (Windows: %AppData%\..\LocalLow\IronGate\Valheim\worlds\)</li>
              <li>Upload both .db and .fwl files via FTP or file manager</li>
              <li>Configure server to use your world name</li>
              <li>Restart server - your world is live!</li>
            </ol>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">How do I install mods like Valheim Plus?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Two methods for mod installation:</p>
            <div class="mb-3">
              <strong class="text-white">Method 1: One-Click (Easiest)</strong>
              <ol class="space-y-1 text-sm list-decimal list-inside ml-4 mt-2">
                <li>Open QuackPlane panel</li>
                <li>Go to Mods tab</li>
                <li>Select "Valheim Plus" or your desired mod</li>
                <li>Click Install → Server auto-restarts</li>
              </ol>
            </div>
            <div>
              <strong class="text-white">Method 2: Manual Upload</strong>
              <ol class="space-y-1 text-sm list-decimal list-inside ml-4 mt-2">
                <li>Download mod from Thunderstore</li>
                <li>Upload to BepInEx/plugins/ folder via file manager</li>
                <li>Restart server</li>
              </ol>
            </div>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">What happens if my server crashes or the world corrupts?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">QuackHost provides multiple protection layers:</p>
            <ul class="space-y-2 text-sm">
              <li>• <strong class="text-white">Auto-Backups:</strong> Daily backups, 7-day retention</li>
              <li>• <strong class="text-white">One-Click Restore:</strong> Rollback to any backup in seconds</li>
              <li>• <strong class="text-white">Crash Detection:</strong> Auto-restart if server becomes unresponsive</li>
              <li>• <strong class="text-white">24/7 Support:</strong> Contact us anytime for manual recovery</li>
            </ul>
            <p class="mt-3 text-sm">World corruption is rare in Valheim, but we're prepared if it happens.</p>
          </div>
        </details>

        <details class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden">
          <summary class="p-6 cursor-pointer hover:bg-gray-80 transition-colors">
            <h3 class="text-lg font-bold text-white inline">Can I set a server password?</h3>
          </summary>
          <div class="px-6 pb-6 text-cool-gray-20">
            <p class="mb-3">Yes! Password protection is built into Valheim and easily configured:</p>
            <ol class="space-y-2 text-sm list-decimal list-inside">
              <li>Open QuackPlane → Server Settings</li>
              <li>Set "Server Password" field</li>
              <li>Restart server for changes to take effect</li>
              <li>Share password with your clan members</li>
            </ol>
            <p class="mt-3 text-sm">Password can be changed anytime. Public servers can leave it blank.</p>
          </div>
        </details>
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-20">
      <div class="bg-gradient-to-r from-purple-50 to-cyan-50 rounded-2xl p-1">
        <div class="bg-gray-100 rounded-xl p-12 lg:p-16 text-center">
          <h2 class="text-3xl lg:text-5xl font-bold text-white mb-6">
            Start Your Viking Adventure Today
          </h2>
          <p class="text-xl text-cool-gray-20 mb-8 max-w-2xl mx-auto">
            Instant setup, mod support, and 24/7 uptime. Explore the tenth world with your clan.
          </p>
          <div class="flex flex-wrap gap-4 justify-center mb-8">
            <a href="/pricing" class="px-8 py-4 bg-gradient-to-r from-purple-50 to-cyan-50 text-black font-bold rounded-lg hover:shadow-lg transition-all text-lg">
              View Plans →
            </a>
            <a href="/support" class="px-8 py-4 bg-gray-90 border-2 border-gray-80 text-white font-bold rounded-lg hover:border-purple-50 transition-all text-lg">
              Contact Support
            </a>
          </div>
          <div class="flex flex-wrap gap-6 justify-center text-sm text-cool-gray-40">
            <div class="flex items-center gap-2">
              <span class="text-green-50">✓</span>
              <span>72-hour money-back guarantee</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-50">✓</span>
              <span>2-minute setup</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-green-50">✓</span>
              <span>Cancel anytime</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related Resources -->
    <section class="mb-20">
      <h2 class="text-2xl font-bold text-white mb-8">Related Resources</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <a href="/games/minecraft" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-[#FF9C20] transition-all">
          <div class="text-3xl mb-3">🎮</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-[#FF9C20] transition-colors">Minecraft Hosting</h3>
          <p class="text-cool-gray-40 text-sm">Optimized servers for Minecraft Java Edition</p>
        </a>

        <a href="/games/rust" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-cyan-50 transition-all">
          <div class="text-3xl mb-3">⚡</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-cyan-50 transition-colors">Rust Hosting</h3>
          <p class="text-cool-gray-40 text-sm">Dedicated resources for high-performance Rust</p>
        </a>

        <a href="/support" class="group bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl p-6 hover:border-purple-50 transition-all">
          <div class="text-3xl mb-3">💬</div>
          <h3 class="text-lg font-bold text-white mb-2 group-hover:text-purple-50 transition-colors">24/7 Support</h3>
          <p class="text-cool-gray-40 text-sm">Get help from our Valheim experts</p>
