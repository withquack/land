---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Blog">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="mb-16 mt-16 lg:mt-32 text-center">
      <div class="inline-block mb-4 px-4 py-2 bg-gradient-to-r from-[#FF9C20]/20 to-purple-50/20 border border-[#FF9C20]/50 rounded-full">
        <span class="text-[#FF9C20] font-bold text-sm">BLOG & NEWS</span>
      </div>
      <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6">
        QuackHost <span class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 bg-clip-text text-transparent">Blog</span>
      </h1>
      <p class="text-xl lg:text-2xl text-cool-gray-20 max-w-3xl mx-auto mb-8">
        Latest updates, tutorials, industry insights, and announcements from the QuackHost team.
      </p>
    </div>

    <!-- Categories -->
    <div
      x-data="{ activeFilter: 'all' }"
      class="mb-12"
    >
      <div class="flex flex-wrap gap-3 justify-center mb-12">
        <button
          @click="activeFilter = 'all'"
          :class="activeFilter === 'all' ? 'bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black' : 'bg-gray-90 text-cool-gray-20 hover:bg-gray-80'"
          class="px-6 py-3 font-semibold rounded-lg transition-all"
        >
          All Posts
        </button>
        <button
          @click="activeFilter = 'announcements'"
          :class="activeFilter === 'announcements' ? 'bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black' : 'bg-gray-90 text-cool-gray-20 hover:bg-gray-80'"
          class="px-6 py-3 font-semibold rounded-lg transition-all"
        >
          Announcements
        </button>
        <button
          @click="activeFilter === 'tutorials'"
          :class="activeFilter === 'tutorials' ? 'bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black' : 'bg-gray-90 text-cool-gray-20 hover:bg-gray-80'"
          class="px-6 py-3 font-semibold rounded-lg transition-all"
        >
          Tutorials
        </button>
        <button
          @click="activeFilter = 'updates'"
          :class="activeFilter === 'updates' ? 'bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black' : 'bg-gray-90 text-cool-gray-20 hover:bg-gray-80'"
          class="px-6 py-3 font-semibold rounded-lg transition-all"
        >
          Product Updates
        </button>
        <button
          @click="activeFilter = 'industry'"
          :class="activeFilter === 'industry' ? 'bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black' : 'bg-gray-90 text-cool-gray-20 hover:bg-gray-80'"
          class="px-6 py-3 font-semibold rounded-lg transition-all"
        >
          Industry News
        </button>
      </div>

      <!-- Featured Post -->
      <div class="mb-12">
        <div class="bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] rounded-2xl p-1">
          <div class="bg-gray-100 rounded-xl overflow-hidden">
            <div class="grid lg:grid-cols-2 gap-0">
              <div class="bg-gradient-to-br from-gray-80 to-gray-90 p-12 flex items-center justify-center">
                <div class="text-6xl">📱</div>
              </div>
              <div class="p-8 lg:p-12">
                <span class="px-3 py-1 bg-[#FF9C20] text-black text-xs font-bold rounded-full">FEATURED</span>
                <h2 class="text-3xl font-bold text-white mt-4 mb-3">
                  Introducing QuackPlane Mobile App
                </h2>
                <p class="text-cool-gray-20 mb-4">
                  Manage your game servers from anywhere with our brand new iOS and Android apps. Full feature parity with the web version, including console access, file management, and real-time monitoring.
                </p>
                <div class="flex items-center gap-4 mb-6">
                  <div class="flex items-center gap-2 text-cool-gray-40 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    <span>November 15, 2025</span>
                  </div>
                  <div class="flex items-center gap-2 text-cool-gray-40 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>5 min read</span>
                  </div>
                </div>
                <a
                  href="#"
                  class="inline-block px-6 py-3 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg hover:shadow-lg transition-all"
                >
                  Read More →
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Blog Posts Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
        <!-- Post 1 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-[#FF9C20] transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">🎮</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-cyan-50/20 text-cyan-50 text-xs font-bold rounded">TUTORIAL</span>
              <span class="text-cool-gray-40 text-xs">Nov 10, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#FF9C20] transition-colors">
              Optimizing Minecraft Server Performance: A Complete Guide
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              Learn how to maximize your Minecraft server's TPS, reduce lag, and provide the best experience for your players with these proven optimization techniques.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">8 min read</span>
              <a href="#" class="text-[#FF9C20] font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>

        <!-- Post 2 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-purple-50 transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">🚀</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-purple-50/20 text-purple-50 text-xs font-bold rounded">PRODUCT UPDATE</span>
              <span class="text-cool-gray-40 text-xs">Nov 5, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-purple-50 transition-colors">
              QuackPlane 2.0: What's New
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              We've completely redesigned QuackPlane with a focus on speed, usability, and powerful new features. Here's everything you need to know.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">6 min read</span>
              <a href="#" class="text-purple-50 font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>

        <!-- Post 3 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-green-50 transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">🛡️</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-green-50/20 text-green-50 text-xs font-bold rounded">SECURITY</span>
              <span class="text-cool-gray-40 text-xs">Oct 28, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-green-50 transition-colors">
              Understanding DDoS Protection for Game Servers
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              DDoS attacks are on the rise. Learn how QuackHost's advanced protection keeps your server online and your players happy, even during attacks.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">10 min read</span>
              <a href="#" class="text-green-50 font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>

        <!-- Post 4 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-[#FF9C20] transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">📊</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-[#FF9C20]/20 text-[#FF9C20] text-xs font-bold rounded">INDUSTRY</span>
              <span class="text-cool-gray-40 text-xs">Oct 20, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-[#FF9C20] transition-colors">
              The State of Game Server Hosting in 2025
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              Market trends, player expectations, and technological advancements shaping the game hosting industry this year.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">12 min read</span>
              <a href="#" class="text-[#FF9C20] font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>

        <!-- Post 5 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-cyan-50 transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">⚡</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-cyan-50/20 text-cyan-50 text-xs font-bold rounded">TUTORIAL</span>
              <span class="text-cool-gray-40 text-xs">Oct 12, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-cyan-50 transition-colors">
              Setting Up Your First Rust Server
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              Complete walkthrough from server creation to mod installation. Get your Rust server running in under 10 minutes.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">9 min read</span>
              <a href="#" class="text-cyan-50 font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>

        <!-- Post 6 -->
        <article class="bg-gradient-to-br from-gray-90 to-gray-100 border-2 border-gray-80 rounded-xl overflow-hidden hover:border-purple-50 transition-all group">
          <div class="bg-gradient-to-br from-gray-80 to-gray-90 h-48 flex items-center justify-center">
            <div class="text-5xl">🎉</div>
          </div>
          <div class="p-6">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2 py-1 bg-purple-50/20 text-purple-50 text-xs font-bold rounded">ANNOUNCEMENT</span>
              <span class="text-cool-gray-40 text-xs">Oct 1, 2025</span>
            </div>
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-purple-50 transition-colors">
              QuackHost Reaches 10,000 Active Servers!
            </h3>
            <p class="text-cool-gray-20 text-sm mb-4">
              A huge milestone for our community. Thank you to every gamer, streamer, and server admin who chose QuackHost.
            </p>
            <div class="flex items-center justify-between">
              <span class="text-cool-gray-40 text-xs">4 min read</span>
              <a href="#" class="text-purple-50 font-semibold text-sm hover:underline">
                Read More →
              </a>
            </div>
          </div>
        </article>
      </div>

      <!-- Pagination -->
      <div class="flex justify-center gap-2 mb-12">
        <button class="px-4 py-2 bg-gray-90 text-cool-gray-40 rounded-lg hover:bg-gray-80 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="px-4 py-2 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] text-black font-bold rounded-lg">1</button>
        <button class="px-4 py-2 bg-gray-90 text-cool-gray-20 rounded-lg hover:bg-gray-80 transition-all">2</button>
        <button class="px-4 py-2 bg-gray-90 text-cool-gray-20 rounded-lg hover:bg-gray-80 transition-all">3</button>
        <button class="px-4 py-2 bg-gray-90 text-cool-gray-20 rounded-lg hover:bg-gray-80 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Newsletter Signup -->
    <div class="mb-20">
      <div class="bg-gradient-to-r from-[#FF9C20] to-cyan-50 rounded-2xl p-12 lg:p-16 text-center">
        <h2 class="text-3xl lg:text-5xl font-bold text-black mb-6">
          Never Miss an Update
        </h2>
        <p class="text-xl text-gray-90 mb-8 max-w-2xl mx-auto">
          Subscribe to our newsletter for the latest tutorials, product updates, and industry insights delivered to your inbox.
        </p>
        <form
          class="max-w-md mx-auto flex gap-3"
          x-data="{ email: '' }"
          @submit.prevent="alert('Newsletter subscription coming soon!')"
        >
          <input
            type="email"
            x-model="email"
            placeholder="Enter your email"
            required
            class="flex-1 px-6 py-4 bg-white border-2 border-transparent rounded-lg text-black placeholder-gray-90 focus:outline-none focus:border-black transition-colors"
          />
          <button
            type="submit"
            class="px-8 py-4 bg-black text-white font-bold rounded-lg hover:bg-gray-90 transition-all"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from "alpinejs";
  Alpine.start();
</script>
