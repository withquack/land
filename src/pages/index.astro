---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Unbeatable Game Servers">
  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-7 mb-16 gap-8 pb-4 items-center">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <!-- Pre-launch Badge -->
      <div class="mb-4">
        <span class="inline-flex items-center px-4 py-2 text-sm font-semibold text-[#FF9C20] border-2 border-[#FF9C20] bg-[#FF9C20]/10 backdrop-blur">
          🚀 Launching Soon - Join the Waitlist
        </span>
      </div>

      <div class="text-4xl md:text-6xl lg:text-7xl mb-4">
        <h1 class="text-white mb-2">
          Minecraft hosting that
        </h1>
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
        >
          actually works
        </h1>
      </div>

      <p class="text-lg md:text-xl text-cool-gray-30 mb-8 max-w-2xl leading-relaxed">
        Get your server online in under 2 minutes. Terrabit DDoS protection, off-site backups, and zero headaches. Built by gamers who got tired of oversold hosts.
      </p>

      <!-- Social Proof -->
      <div class="mb-8">
        <div class="flex items-center gap-2 text-cool-gray-40 mb-4">
          <div class="flex -space-x-2">
            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-cyan-50 to-blue-50 border-2 border-gray-100"></div>
            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-purple-50 to-magenta-50 border-2 border-gray-100"></div>
            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-teal-50 to-green-50 border-2 border-gray-100"></div>
            <div class="w-8 h-8 rounded-full bg-gradient-to-r from-orange-50 to-red-50 border-2 border-gray-100"></div>
          </div>
          <span class="text-sm font-semibold">Join 500+ server owners on the waitlist</span>
        </div>
      </div>

      <!-- Waitlist Form -->
      <div class="max-w-md">
        <form
          id="waitlist-form"
          class="flex flex-col sm:flex-row gap-3"
          x-data="{ email: '', submitted: false, error: '' }"
          @submit.prevent="if (!email.includes('@')) { error = 'Please enter a valid email'; return; } submitted = true; error = ''; if (window.umami) { umami.track('waitlist-signup', { email: email }); }"
        >
          <div class="flex-1">
            <input
              type="email"
              x-model="email"
              placeholder="your@email.com"
              required
              class="w-full px-4 py-3 bg-gray-90 border-2 border-gray-70 text-white placeholder-cool-gray-50 focus:border-[#FF9C20] focus:outline-none transition-colors"
              :class="{ 'border-red-50': error }"
            />
            <p x-show="error" x-text="error" class="text-red-50 text-sm mt-1"></p>
          </div>
          <button
            type="submit"
            x-show="!submitted"
            class="px-6 py-3 text-black font-semibold bg-[#FF9C20] hover:bg-[#FF8D00] transition-colors duration-200 whitespace-nowrap"
          >
            Get Early Access
          </button>
          <div
            x-show="submitted"
            class="px-6 py-3 text-green-40 font-semibold bg-green-90 border-2 border-green-50 whitespace-nowrap"
          >
            ✓ You're on the list!
          </div>
        </form>

        <!-- Trust Elements -->
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center gap-3 text-sm text-cool-gray-40">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-green-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>Early bird pricing: 30% off</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-blue-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>No credit card required</span>
          </div>
        </div>

        <!-- Alternative CTA -->
        <div class="mt-6">
          <a
            href="#features"
            class="inline-flex items-center text-cool-gray-40 hover:text-[#FF9C20] transition-colors"
          >
            See what makes us different
            <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <img
        src="https://w7.pngwing.com/pngs/227/144/png-transparent-minecraft-illustration-minecraft-pocket-edition-minecraft-story-mode-xbox-360-wii-u-minecraft-game-video-game-mojang.png"
        alt="Minecraft Server Hosting"
        class="max-w-full h-auto"
        loading="eager"
      />
    </div>
  </div>

  <!-- Features Section -->
  <div id="features" class="mb-16 lg:mb-32" aria-label="Product Features">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4">
        Everything you need. <span class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">Nothing you don't.</span>
      </h2>
      <p class="text-lg text-cool-gray-40 max-w-2xl mx-auto">
        Stop fighting with your hosting provider. We built the service we wished existed.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-12 lg:gap-y-16"
    >
      <div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-cyan-50">No lag, ever</span
          >
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-2 transition duration-300 ease-out hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
          />
        </h3>
        <p class="text-cool-gray-40 leading-relaxed">
          Latest-gen hardware with dedicated resources. Your server runs at peak performance even with 100+ plugins installed. No "noisy neighbors" stealing your CPU.
        </p>
      </div>

      <div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-blue-50">99.9% uptime guarantee</span
          >
          <img
            src="/index/doodles/rocking chair.svg"
            class="ml-2"
            alt=""
            width="34"
            height="34"
          />
        </h3>
        <p class="text-cool-gray-40 leading-relaxed">
          Terrabit-scale DDoS protection included. Your players stay connected even during massive attacks. Check our live <a
            href="/service-status"
            class="text-blue-40 underline decoration-2 decoration-blue-40 hover:decoration-blue-50 transition-colors"
            >uptime dashboard</a
          >.
        </p>
      </div>

      <div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-green-50"
            >Grow without limits</span
          >
          <img
            src="/index/doodles/cycle.svg"
            class="ml-2 transition duration-300 ease-out hover:animate-spin"
            alt=""
            width="34"
            height="34"
          />
        </h3>
        <p class="text-cool-gray-40 leading-relaxed">
          Start small, scale big. Upgrade your plan with one click as your community grows. Downgrade anytime if things slow down. You only pay for what you actually use.
        </p>
      </div>

      <div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-teal-50"
            >No surprise bills</span
          >
          <img
            src="/index/doodles/tree.svg"
            class="ml-2 transition duration-700 ease-out hover:scale-110"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </h3>
        <p class="text-cool-gray-40 leading-relaxed">
          See exactly what you're paying for. Real-time resource usage dashboard, clear monthly billing, zero hidden fees. We show you everything, always.
        </p>
      </div>

      <div class="sm:col-span-2">
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-purple-50"
            >Sleep easy with automatic backups</span
          >
          <img
            src="/index/doodles/rain.svg"
            class="ml-2 transition duration-300 ease-out hover:translate-x-1 hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </h3>
        <p class="text-cool-gray-40 leading-relaxed">
          Your worlds are backed up off-site automatically. Server gets griefed? Click one button to restore everything to 5 minutes ago. Even if our datacenter burns down, your creations survive.
        </p>
      </div>
    </div>

    <!-- Trust Indicators -->
    <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
      <div class="flex flex-col items-center">
        <div class="text-3xl md:text-4xl font-bold text-transparent gradient bg-gradient-to-r from-cyan-50 to-blue-50 bg-clip-text mb-2">
          &lt;2min
        </div>
        <p class="text-sm text-cool-gray-40">Setup time</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="text-3xl md:text-4xl font-bold text-transparent gradient bg-gradient-to-r from-green-50 to-teal-50 bg-clip-text mb-2">
          99.9%
        </div>
        <p class="text-sm text-cool-gray-40">Uptime SLA</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="text-3xl md:text-4xl font-bold text-transparent gradient bg-gradient-to-r from-purple-50 to-magenta-50 bg-clip-text mb-2">
          24/7
        </div>
        <p class="text-sm text-cool-gray-40">DDoS protection</p>
      </div>
      <div class="flex flex-col items-center">
        <div class="text-3xl md:text-4xl font-bold text-transparent gradient bg-gradient-to-r from-orange-50 to-red-50 bg-clip-text mb-2">
          0
        </div>
        <p class="text-sm text-cool-gray-40">Hidden fees</p>
      </div>
    </div>
  </div>

  <!-- QuackPlane Section -->
  <div class="mb-16 lg:mb-32" aria-label="Powered by QuackPlane">
    <!-- Section Header -->
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-semibold text-white mb-4">
        Control everything from <span class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">your browser</span>
      </h2>
      <p class="text-lg text-cool-gray-40 max-w-2xl mx-auto">
        Meet QuackPlane: the control panel that doesn't suck.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3">
        <img
          src="/index/quackplane.webp"
          class="w-full border-2 border-gray-70"
          alt="QuackPlane Control Plane Interface"
          width="1253"
          height="1016"
          loading="lazy"
        />
      </div>

      <div class="lg:col-span-2 space-y-10">
        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-teal-50"
              >Add your staff team</span
            >
            <img
              src="/index/doodles/hand holding.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2 transition duration-300 ease-out hover:scale-110"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Let your moderators restart the server and manage files without giving them your password. Set permissions per person.
          </p>
        </div>

        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-cyan-50"
              >Control from your phone</span
            >
            <img
              src="/index/doodles/wizard.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Restart your server from the beach. Monitor player count from bed. Everything works on mobile.
          </p>
        </div>

        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-purple-50"
              >Undo griefing instantly</span
            >
            <img
              src="/index/doodles/magic wand.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2 transition duration-300 ease-out hover:translate-x-1 hover:-translate-y-1"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Griefer destroyed your spawn? One click restores your entire server to 5 minutes ago. Worlds, configs, plugins - everything.
          </p>
        </div>

        <div>
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-blue-50"
              >Drag & drop file uploads</span
            >
            <img
              src="/index/doodles/upload.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Add mods by dragging files into your browser. Edit configs with the built-in text editor. No FTP clients needed.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Mid-page CTA -->
  <div class="mb-16 lg:mb-32">
    <div class="bg-gradient-to-r from-gray-90 to-gray-95 border-2 border-gray-70 p-8 lg:p-12 text-center">
      <h2 class="text-2xl md:text-3xl font-semibold text-white mb-4">
        Ready to stop fighting with your host?
      </h2>
      <p class="text-lg text-cool-gray-40 mb-8 max-w-2xl mx-auto">
        Join the waitlist and get <span class="text-[#FF9C20] font-semibold">30% off</span> your first 3 months when we launch.
      </p>

      <!-- Duplicate waitlist form for mid-page conversion -->
      <div class="max-w-md mx-auto">
        <form
          id="waitlist-form-2"
          class="flex flex-col sm:flex-row gap-3"
          x-data="{ email: '', submitted: false, error: '' }"
          @submit.prevent="if (!email.includes('@')) { error = 'Please enter a valid email'; return; } submitted = true; error = ''; if (window.umami) { umami.track('waitlist-signup-midpage', { email: email }); }"
        >
          <div class="flex-1">
            <input
              type="email"
              x-model="email"
              placeholder="your@email.com"
              required
              class="w-full px-4 py-3 bg-gray-100 border-2 border-gray-70 text-white placeholder-cool-gray-50 focus:border-[#FF9C20] focus:outline-none transition-colors"
              :class="{ 'border-red-50': error }"
            />
            <p x-show="error" x-text="error" class="text-red-50 text-sm mt-1"></p>
          </div>
          <button
            type="submit"
            x-show="!submitted"
            class="px-6 py-3 text-black font-semibold bg-[#FF9C20] hover:bg-[#FF8D00] transition-colors duration-200 whitespace-nowrap"
          >
            Claim my discount
          </button>
          <div
            x-show="submitted"
            class="px-6 py-3 text-green-40 font-semibold bg-green-90 border-2 border-green-50 whitespace-nowrap"
          >
            ✓ Discount saved!
          </div>
        </form>
        <p class="text-sm text-cool-gray-50 mt-3">
          Limited to first 100 signups • Launch: Q1 2025
        </p>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div
    class="mb-16 lg:mb-32"
    x-data="{ open: [false, false, false, false, false, false, false, false, false], focusedIndex: 0 }"
  >
    <div class="text-center mb-12">
      <h2
        class="text-2xl lg:text-3xl font-semibold mb-4 flex items-center gap-2 flex-wrap justify-center"
      >
        <img
          src="/index/doodles/chat.svg"
          loading="lazy"
          alt=""
          width="48"
          height="48"
          class="sm:w-[62px] sm:h-[62px]"
        />
        <span class="underline decoration-4 decoration-teal-40">Questions?</span>
        <img
          src="/index/doodles/owl.svg"
          loading="lazy"
          alt=""
          width="48"
          height="48"
          class="sm:w-[62px] sm:h-[62px]"
        />
        <span class="underline decoration-4 decoration-purple-40"
          >We've got answers.</span
        >
      </h2>
      <p class="text-lg text-cool-gray-40">
        Everything you need to know about joining the waitlist.
      </p>
    </div>

    <div>
      <!-- Question 1 - Pre-launch specific -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[0] = !open[0]"
          @keydown.down.prevent="focusedIndex = Math.min(8, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[0] = !open[0]"
          @keydown.space.prevent="open[0] = !open[0]"
          @focus="focusedIndex = 0"
          id="question-0"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[0]"
          aria-controls="content-0"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >When does QuackHost launch?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[0] }"
          />
        </button>
        <div
          x-show="open[0]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-0"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            We're launching in Q1 2025! Join the waitlist now to get early access and lock in 30% off your first 3 months. We'll email you 48 hours before launch with your exclusive signup link.
          </p>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[1] = !open[1]"
          @keydown.down.prevent="focusedIndex = Math.min(8, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[1] = !open[1]"
          @keydown.space.prevent="open[1] = !open[1]"
          @focus="focusedIndex = 1"
          id="question-1"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[1]"
          aria-controls="content-1"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >What do I get for joining the waitlist?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[1] }"
          />
        </button>
        <div
          x-show="open[1]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-1"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Early bird pricing: 30% off your first 3 months. Priority access to new features. First pick of server locations. Plus, you'll be supporting a hosting company built by actual gamers, not a corporation trying to squeeze pennies.
          </p>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[2] = !open[2]"
          @keydown.down.prevent="focusedIndex = Math.min(8, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[2] = !open[2]"
          @keydown.space.prevent="open[2] = !open[2]"
          @focus="focusedIndex = 2"
          id="question-2"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[2]"
          aria-controls="content-2"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Is there a free trial?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[2] }"
          />
        </button>
        <div
          x-show="open[2]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-2"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Waitlist members get a 7-day free trial when we launch. No credit card required to start. If you're not happy, cancel before day 7 and pay nothing. If you love it (you will), your 30% discount kicks in automatically.
          </p>
        </div>
      </div>

      <!-- Question 4 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[3] = !open[3]"
          @keydown.down.prevent="focusedIndex = Math.min(8, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[3] = !open[3]"
