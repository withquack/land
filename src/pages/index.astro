---
import Layout from "../layouts/layout.astro";
import AngelDefenceBadge from "../components/angel-defence-badge.astro";
import { LAUNCH_CONFIG } from "../config/pricing";
---

<Layout title="/ Unbeatable Game Servers">
  <!-- Pre-Launch Banner -->
  {LAUNCH_CONFIG.status === 'pre-launch' && (
    <div class="mb-8 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] p-4 text-center border-l-4 border-[#FF8D00]">
      <div class="text-lg lg:text-xl font-bold text-black">
        🚀 Launching {LAUNCH_CONFIG.launchDate} • Early Adopter Pricing - Lock In Forever
      </div>
    </div>
  )}

  <!-- AngelDefence Hero Banner -->
  <div class="mb-16">
    <AngelDefenceBadge size="large" variant="banner" showTagline={true} />
  </div>

  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-7 mb-24 gap-8 items-center">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <div class="text-5xl md:text-7xl leading-tight tracking-tight">
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text font-semibold"
        >
          Level Up
        </h1>
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text font-semibold"
        >
          Your Server Game
        </h1>
      </div>

      <p class="text-cool-gray-30 text-lg md:text-xl mt-6 max-w-2xl">
        Join <span class="text-[#FF9C20] font-semibold">10,000+ gamers</span> running lag-free servers with zero downtime. Your players deserve better.
      </p>

      <!-- Gaming Stats Bar -->
      <div class="grid grid-cols-3 gap-4 mt-8 p-4 bg-cool-gray-90/50 border-l-4 border-[#FF9C20] backdrop-blur-sm">
        <div>
          <div class="text-2xl md:text-3xl font-bold text-[#FF9C20]">99.9%</div>
          <div class="text-xs text-cool-gray-40 uppercase tracking-wider">Uptime</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold text-[#FF9C20]">&lt;2min</div>
          <div class="text-xs text-cool-gray-40 uppercase tracking-wider">Deploy Time</div>
        </div>
        <div>
          <div class="text-2xl md:text-3xl font-bold text-[#FF9C20]">24/7</div>
          <div class="text-xs text-cool-gray-40 uppercase tracking-wider">Support</div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row mt-8 text-base gap-4">
        <a
          href="/pricing"
          class="group relative inline-flex justify-center items-center px-8 py-4 text-black bg-[#FF9C20] hover:bg-[#FF8D00] hover:shadow-lg hover:shadow-[#FF9C20]/20 transition-all duration-200 font-semibold border-b-4 border-[#CC6600] overflow-hidden"
        >
          <span class="relative z-10">🚀 Start Your Server</span>
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent -translate-x-full group-hover:translate-x-full transition-transform duration-700"></div>
        </a>
        <a
          href="/quackplane"
          class="group relative inline-flex justify-center items-center px-8 py-4 text-white hover:text-black border-2 border-[#FF9C20] hover:bg-[#FF9C20] hover:shadow-lg hover:shadow-[#FF9C20]/20 transition-all duration-200 font-semibold"
        >
          <span class="relative z-10">⚡ See Control Panel</span>
        </a>
      </div>
    </div>
    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <img
        src="/minecraft-hero.svg"
        alt="Minecraft Server Hosting"
        class="max-w-full h-auto"
        width="400"
        height="400"
        loading="eager"
      />
    </div>
  </div>

  <!-- Features Section -->
  <div class="mb-24 lg:mb-32" aria-label="Product Features">
    <h2 class="text-3xl lg:text-4xl font-bold mb-16 text-center">
      <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">Server Perks</span>
      <span class="text-white"> Unlocked</span>
    </h2>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12"
    >
      <div class="group relative p-6 bg-cool-gray-90/30 border-2 border-cool-gray-80 hover:border-[#FF9C20] transition-all duration-300 backdrop-blur-sm">
        <!-- Achievement Badge -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-gradient-to-br from-cyan-50 to-cyan-60 flex items-center justify-center font-bold text-black text-sm transform rotate-12 group-hover:rotate-0 transition-transform duration-300">
          💎
        </div>

        <h2 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="text-cyan-50">Max Performance</span>
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-3 transition duration-200 ease-out group-hover:-translate-y-1"
            alt=""
            width="32"
            height="32"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed text-base mb-4">
          Latest-gen hardware with dedicated resources. Your server runs smooth even with heavy modpacks and 100+ players online.
        </p>
        <div class="flex items-center gap-2 text-xs text-cool-gray-50">
          <div class="w-full bg-cool-gray-80 h-2">
            <div class="bg-gradient-to-r from-cyan-60 to-cyan-40 h-full w-[95%]"></div>
          </div>
          <span>95%</span>
        </div>
      </div>

      <div class="group relative p-6 bg-cool-gray-90/30 border-2 border-cool-gray-80 hover:border-[#FF9C20] transition-all duration-300 backdrop-blur-sm">
        <!-- Achievement Badge -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-gradient-to-br from-blue-50 to-blue-60 flex items-center justify-center font-bold text-black text-sm transform rotate-12 group-hover:rotate-0 transition-transform duration-300">
          🛡️
        </div>

        <h2 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="text-blue-50">AngelDefence™</span>
          <img
            src="/angel-defence-shield.svg"
            class="ml-3 w-8 h-10 group-hover:scale-110 transition-transform duration-300"
            alt="AngelDefence Shield"
            width="32"
            height="40"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed text-base mb-4">
          Terrabit-scale DDoS protection keeps you online during attacks. While other servers go down, yours stays up. Check our <a
            href="/service-status"
            class="text-blue-40 hover:text-blue-30 transition-colors font-semibold"
            >99.9% uptime</a>.
        </p>
        <div class="flex items-center gap-2 text-xs text-cool-gray-50">
          <div class="w-full bg-cool-gray-80 h-2">
            <div class="bg-gradient-to-r from-blue-60 to-blue-40 h-full w-[99%]"></div>
          </div>
          <span>99%</span>
        </div>
      </div>

      <div class="group relative p-6 bg-cool-gray-90/30 border-2 border-cool-gray-80 hover:border-[#FF9C20] transition-all duration-300 backdrop-blur-sm">
        <!-- Achievement Badge -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-gradient-to-br from-green-50 to-green-60 flex items-center justify-center font-bold text-black text-sm transform rotate-12 group-hover:rotate-0 transition-transform duration-300">
          📈
        </div>

        <h2 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="text-green-50">Instant Scaling</span>
          <img
            src="/index/doodles/cycle.svg"
            class="ml-3 transition duration-200 ease-out group-hover:animate-spin"
            alt=""
            width="32"
            height="32"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed text-base mb-4">
          Community blowing up? Scale to 100 players in one click. Quiet season? Scale down. No data loss, no contracts, instant changes.
        </p>
        <div class="flex items-center gap-2 text-xs text-cool-gray-50">
          <div class="w-full bg-cool-gray-80 h-2">
            <div class="bg-gradient-to-r from-green-60 to-green-40 h-full w-[88%]"></div>
          </div>
          <span>88%</span>
        </div>
      </div>

      <div class="group relative p-6 bg-cool-gray-90/30 border-2 border-cool-gray-80 hover:border-[#FF9C20] transition-all duration-300 backdrop-blur-sm">
        <!-- Achievement Badge -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-gradient-to-br from-teal-50 to-teal-60 flex items-center justify-center font-bold text-black text-sm transform rotate-12 group-hover:rotate-0 transition-transform duration-300">
          💰
        </div>

        <h2 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="text-teal-50">No BS Pricing</span>
          <img
            src="/index/doodles/tree.svg"
            class="ml-3 transition duration-200 ease-out group-hover:scale-110"
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed text-base mb-4">
          See exactly what you pay. Monitor CPU, RAM, storage in real-time. No surprise bills, no hidden fees. What you see is what you pay.
        </p>
        <div class="flex items-center gap-2 text-xs text-cool-gray-50">
          <div class="w-full bg-cool-gray-80 h-2">
            <div class="bg-gradient-to-r from-teal-60 to-teal-40 h-full w-full"></div>
          </div>
          <span>100%</span>
        </div>
      </div>

      <div class="sm:col-span-2 lg:col-span-1 group relative p-6 bg-cool-gray-90/30 border-2 border-cool-gray-80 hover:border-[#FF9C20] transition-all duration-300 backdrop-blur-sm">
        <!-- Achievement Badge -->
        <div class="absolute -top-4 -right-4 w-12 h-12 bg-gradient-to-br from-purple-50 to-purple-60 flex items-center justify-center font-bold text-black text-sm transform rotate-12 group-hover:rotate-0 transition-transform duration-300">
          💾
        </div>

        <h2 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="text-purple-50">Grief-Proof Backups</span>
          <img
            src="/index/doodles/rain.svg"
            class="ml-3 transition duration-200 ease-out group-hover:translate-x-1 group-hover:-translate-y-1"
            alt=""
            width="32"
            height="32"
            loading="lazy"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed text-base mb-4">
          Auto-backups every hour. Griefer destroyed spawn? One-click rollback. All backups stored off-site. Your world is immortal.
        </p>
        <div class="flex items-center gap-2 text-xs text-cool-gray-50">
          <div class="w-full bg-cool-gray-80 h-2">
            <div class="bg-gradient-to-r from-purple-60 to-purple-40 h-full w-full"></div>
          </div>
          <span>100%</span>
        </div>
      </div>
    </div>
  </div>

  <!-- QuackPlane Section -->
  <div class="mb-24 lg:mb-32" aria-label="Powered by QuackPlane">
    <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-center">
      <span class="text-white">Your </span>
      <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">Command Center</span>
    </h2>
    <p class="text-center text-cool-gray-40 mb-16 max-w-2xl mx-auto">
      QuackPlane control panel. Manage everything without touching a terminal. Built for gamers, not sysadmins.
    </p>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-16 items-center">
      <div class="lg:col-span-3 relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] opacity-0 group-hover:opacity-20 blur transition-opacity duration-300"></div>
        <img
          src="/index/quackplane.webp"
          class="relative w-full border-2 border-cool-gray-80 group-hover:border-[#FF9C20] transition-all duration-200"
          alt="QuackPlane Control Plane Interface"
          width="1253"
          height="1016"
          loading="lazy"
        />
        <div class="absolute top-4 right-4 px-3 py-1 bg-[#FF9C20] text-black text-xs font-bold uppercase tracking-wider">
          Live Demo
        </div>
      </div>

      <div class="lg:col-span-2 space-y-12">
        <div class="p-4 border-l-4 border-teal-50 bg-cool-gray-90/30">
          <h3 class="text-xl font-semibold mb-3 flex items-center text-teal-50">
            <span class="mr-2">🤝</span>
            <span>Invite Your Squad</span>
          </h3>
          <p class="text-cool-gray-40 leading-relaxed text-base">
            Give mods and admins their own logins. Set permissions. They can restart, manage files, monitor players. You keep control.
          </p>
        </div>

        <div class="p-4 border-l-4 border-cyan-50 bg-cool-gray-90/30">
          <h3 class="text-xl font-semibold mb-3 flex items-center text-cyan-50">
            <span class="mr-2">📱</span>
            <span>Manage From Phone</span>
          </h3>
          <p class="text-cool-gray-40 leading-relaxed text-base">
            Web-based dashboard. Works on phone, tablet, laptop. Restart server from bed. Monitor players from beach. Zero downloads required.
          </p>
        </div>

        <div class="p-4 border-l-4 border-purple-50 bg-cool-gray-90/30">
          <h3 class="text-xl font-semibold mb-3 flex items-center text-purple-50">
            <span class="mr-2">⏮️</span>
            <span>Time-Travel Backups</span>
          </h3>
          <p class="text-cool-gray-40 leading-relaxed text-base">
            Griefer destroyed spawn at 3pm? Rollback to 2:59pm. One click. Entire server restored. Worlds, configs, mods, everything. Like it never happened.
          </p>
        </div>

        <div class="p-4 border-l-4 border-blue-50 bg-cool-gray-90/30">
          <h3 class="text-xl font-semibold mb-3 flex items-center text-blue-50">
            <span class="mr-2">📦</span>
            <span>Drag & Drop Mods</span>
          </h3>
          <p class="text-cool-gray-40 leading-relaxed text-base">
            Drag mods into browser. Done. Edit configs directly in-browser. No FTP, no downloads, no terminal. Just works.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div
    class="mb-24 lg:mb-32"
    x-data="{ open: [false, false, false, false, false, false], focusedIndex: 0 }"
  >
    <h2
      class="text-3xl lg:text-4xl font-bold mb-4 text-center"
    >
      <span class="text-white">Got </span>
      <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">Questions?</span>
    </h2>
    <p class="text-center text-cool-gray-40 mb-16 max-w-2xl mx-auto">
      We've hosted 10,000+ servers. Here's what gamers ask us.
    </p>

    <div>
      <!-- Question 1 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[0] = !open[0]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[0] = !open[0]"
          @keydown.space.prevent="open[0] = !open[0]"
          @focus="focusedIndex = 0"
          id="question-0"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[0]"
          aria-controls="content-0"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >How quickly can I get my server online?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[0] }"
          />
        </button>
        <div
          x-show="open[0]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-0"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            Your server is ready in under 2 minutes! Once you complete payment,
            our system automatically provisions your server and sends you the
            login details. No waiting around - you can start building your world
            immediately.
          </p>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[1] = !open[1]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[1] = !open[1]"
          @keydown.space.prevent="open[1] = !open[1]"
          @focus="focusedIndex = 1"
          id="question-1"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[1]"
          aria-controls="content-1"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Can I upgrade or downgrade my plan anytime?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[1] }"
          />
        </button>
        <div
          x-show="open[1]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-1"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            Absolutely! Scale up when your community grows or scale down during
            quieter periods. Changes take effect immediately and billing is
            prorated - you only pay for what you use. No contracts, no
            penalties, just flexibility.
          </p>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[2] = !open[2]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[2] = !open[2]"
          @keydown.space.prevent="open[2] = !open[2]"
          @focus="focusedIndex = 2"
          id="question-2"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[2]"
          aria-controls="content-2"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >What happens if my server gets griefed?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[2] }"
          />
        </button>
        <div
          x-show="open[2]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-2"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            No panic needed! Schedule automatic backups or take your own backups
            manually. The key advantage: all backups are stored off-site,
            protecting your worlds even if our datacenter goes down. One click
            in QuackPlane and your world rolls back to before the damage
            happened. Your creations are always safe.
          </p>
        </div>
      </div>

      <!-- Question 4 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[3] = !open[3]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[3] = !open[3]"
          @keydown.space.prevent="open[3] = !open[3]"
          @focus="focusedIndex = 3"
          id="question-3"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[3]"
          aria-controls="content-3"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Do you provide DDoS protection?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[3] }"
          />
        </button>
        <div
          x-show="open[3]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-3"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            Yes! Every server comes with terrabit-scale DDoS protection at no
            extra cost. Whether someone's trying to knock your server offline or
            you're dealing with a massive influx of players, our network keeps
            you online and playable.
          </p>
        </div>
      </div>

      <!-- Question 5 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[4] = !open[4]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[4] = !open[4]"
          @keydown.space.prevent="open[4] = !open[4]"
          @focus="focusedIndex = 4"
          id="question-4"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[4]"
          aria-controls="content-4"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Can I transfer my server to QuackHost?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[4] }"
          />
        </button>
        <div
          x-show="open[4]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-4"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            Yes! We'll help you migrate your server to QuackHost for free. Just
            upload your world files, plugins, and configs through QuackPlane's
            file manager. Our support team can also assist with the transfer to
            make sure everything works perfectly on our platform.
          </p>
        </div>
      </div>

      <!-- Question 6 -->
      <div class="border-b-2 border-cool-gray-80">
        <button
          @click="open[5] = !open[5]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[5] = !open[5]"
          @keydown.space.prevent="open[5] = !open[5]"
          @focus="focusedIndex = 5"
          id="question-5"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-all duration-200"
          :aria-expanded="open[5]"
          aria-controls="content-5"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >What payment methods do you accept?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[5] }"
          />
        </button>
        <div
          x-show="open[5]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-5"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-30 leading-relaxed pb-6 px-4 text-base">
            We accept all major credit cards, PayPal, and various digital
            payment methods. Billing is monthly with no long-term contracts
            required. You can update your payment method anytime through the
            client portal.
          </p>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Hide Alpine.js content on initial page load */
    [x-cloak] {
      display: none !important;
    }
  </style>
</Layout>
