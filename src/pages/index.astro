---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Unbetable Game Servers">
  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-7 mb-16 gap-8 pb-4 items-center">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <div class="text-5xl md:text-7xl">
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
        >
          Your server &
        </h1>
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
        >
          Our obsession.
        </h1>
      </div>

      <div class="flex flex-col sm:flex-row mt-8 text-base">
        <div class="mr-8">
          <a
            href="/pricing"
            class="inline-flex justify-start items-center w-64 p-3 text-black bg-[#FF9C20] hover:bg-[#CC6600] transition-colors duration-200"
          >
            Launch your server
          </a>
        </div>
        <div class="">
          <a
            href="/quackplane"
            class="inline-flex items-center mt-4 sm:mt-0 w-64 p-3 text-white hover:text-black border border-[#FF9C20] hover:bg-[#FF8D00] transition-colors duration-200"
          >
            Discover QuackPlane
          </a>
        </div>
      </div>
    </div>
    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <img
        src="https://w7.pngwing.com/pngs/227/144/png-transparent-minecraft-illustration-minecraft-pocket-edition-minecraft-story-mode-xbox-360-wii-u-minecraft-game-video-game-mojang.png"
        alt="Minecraft"
        class="max-w-full h-auto"
      />
    </div>
  </div>

  <!-- Features Section -->
  <div class="mb-16 lg:mb-32" aria-label="Product Features">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-12 lg:gap-y-16"
    >
      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-cyan-50">Powerful</span
          >
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-2 transition duration-300 ease-out hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          High-performance infrastructure running the latest hardware. Dedicated
          resources ensure your servers run smoothly, even with tons of mods and
          plugins.
        </p>
      </div>

      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-blue-50">Reliable</span
          >
          <img
            src="/index/doodles/rocking chair.svg"
            class="ml-2"
            alt=""
            width="34"
            height="34"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          Terrabit-scale DDoS protection keeps your server online during
          attacks. Check our live <a
            href="/service-status"
            class="text-blue-40 underline decoration-2 decoration-blue-40 hover:decoration-blue-50 transition-colors"
            >service status</a
          > to see our track record.
        </p>
      </div>

      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-green-50"
            >Scalable</span
          >
          <img
            src="/index/doodles/cycle.svg"
            class="ml-2 transition duration-300 ease-out hover:animate-spin"
            alt=""
            width="34"
            height="34"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          Easily upgrade or downgrade your plan as your community grows or
          shrinks. Scale your resources up and down as needed without losing
          your data.
        </p>
      </div>

      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-teal-50"
            >Transparent</span
          >
          <img
            src="/index/doodles/tree.svg"
            class="ml-2 transition duration-700 ease-out hover:scale-110"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          Complete visibility into pricing, resource usage, and server
          performance. No hidden fees, no surprise charges - just honest,
          straightforward hosting with clear billing.
        </p>
      </div>

      <div class="sm:col-span-2">
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-purple-50"
            >Secured by off-site backups</span
          >
          <img
            src="/index/doodles/rain.svg"
            class="ml-2 transition duration-300 ease-out hover:translate-x-1 hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          Schedule automatic backups or take your own backups manually. The key
          advantage: all backups are stored off-site, protecting your worlds
          even if our datacenter goes down. Your creations are always safe.
        </p>
      </div>
    </div>
  </div>

  <!-- QuackPlane Section -->
  <div class="mb-16 lg:mb-32" aria-label="Powered by QuackPlane">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3">
        <img
          src="/index/quackplane.webp"
          class="w-full"
          alt="QuackPlane Control Plane Interface"
          width="1253"
          height="1016"
          loading="lazy"
        />
      </div>

      <div class="lg:col-span-2 space-y-12">
        <div>
          <h3 class="text-2xl font-semibold mb-4 flex items-center">
            <span class="underline decoration-4 decoration-teal-50"
              >Create your own staff team</span
            >
            <img
              src="/index/doodles/hand holding.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2 transition duration-300 ease-out hover:scale-110"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Give your friends and moderators access to restart the server,
            manage files, or monitor players - all without sharing your main
            login.
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-semibold mb-4 flex items-center">
            <span class="underline decoration-4 decoration-cyan-50"
              >Manage from anywhere</span
            >
            <img
              src="/index/doodles/wizard.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Web-based control plane lets you restart servers, monitor player
            activity, and manage your worlds from any device. No software to
            install.
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-semibold mb-4 flex items-center">
            <span class="underline decoration-4 decoration-purple-50"
              >One-click restoration</span
            >
            <img
              src="/index/doodles/magic wand.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2 transition duration-300 ease-out hover:translate-x-1 hover:-translate-y-1"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Someone griefed your server. Roll back your entire server to any
            previous backup with one click. Everything gets restored - worlds,
            configs, mods, the lot.
          </p>
        </div>

        <div>
          <h3 class="text-2xl font-semibold mb-4 flex items-center">
            <span class="underline decoration-4 decoration-blue-50"
              >Easy file management</span
            >
            <img
              src="/index/doodles/upload.svg"
              alt=""
              width="34"
              height="34"
              class="ml-2"
            />
          </h3>
          <p class="text-cool-gray-40 leading-relaxed">
            Upload mods, plugins, and resource packs with drag & drop. Built-in
            text editor lets you tweak configs without downloading files.
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ Section -->
  <div
    class="mb-16 lg:mb-32"
    x-data="{ open: [false, false, false, false, false, false], focusedIndex: 0 }"
  >
    <h2
      class="text-2xl lg:text-3xl font-semibold mb-8 flex items-center gap-2 flex-wrap"
    >
      <img
        src="/index/doodles/chat.svg"
        loading="lazy"
        alt=""
        width="48"
        height="48"
        class="sm:w-[62px] sm:h-[62px]"
      />
      <span class="underline decoration-4 decoration-teal-40">Questions?</span>
      <img
        src="/index/doodles/owl.svg"
        loading="lazy"
        alt=""
        width="48"
        height="48"
        class="sm:w-[62px] sm:h-[62px]"
      />
      <span class="underline decoration-4 decoration-purple-40"
        >We've got answers.</span
      >
    </h2>

    <div>
      <!-- Question 1 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[0] = !open[0]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[0] = !open[0]"
          @keydown.space.prevent="open[0] = !open[0]"
          @focus="focusedIndex = 0"
          id="question-0"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[0]"
          aria-controls="content-0"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >How quickly can I get my server online?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[0] }"
          />
        </button>
        <div
          x-show="open[0]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-0"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Your server is ready in under 2 minutes! Once you complete payment,
            our system automatically provisions your server and sends you the
            login details. No waiting around - you can start building your world
            immediately.
          </p>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[1] = !open[1]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[1] = !open[1]"
          @keydown.space.prevent="open[1] = !open[1]"
          @focus="focusedIndex = 1"
          id="question-1"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[1]"
          aria-controls="content-1"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Can I upgrade or downgrade my plan anytime?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[1] }"
          />
        </button>
        <div
          x-show="open[1]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-1"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Absolutely! Scale up when your community grows or scale down during
            quieter periods. Changes take effect immediately and billing is
            prorated - you only pay for what you use. No contracts, no
            penalties, just flexibility.
          </p>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[2] = !open[2]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[2] = !open[2]"
          @keydown.space.prevent="open[2] = !open[2]"
          @focus="focusedIndex = 2"
          id="question-2"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[2]"
          aria-controls="content-2"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >What happens if my server gets griefed?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[2] }"
          />
        </button>
        <div
          x-show="open[2]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-2"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            No panic needed! Schedule automatic backups or take your own backups
            manually. The key advantage: all backups are stored off-site,
            protecting your worlds even if our datacenter goes down. One click
            in QuackPlane and your world rolls back to before the damage
            happened. Your creations are always safe.
          </p>
        </div>
      </div>

      <!-- Question 4 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[3] = !open[3]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[3] = !open[3]"
          @keydown.space.prevent="open[3] = !open[3]"
          @focus="focusedIndex = 3"
          id="question-3"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[3]"
          aria-controls="content-3"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Do you provide DDoS protection?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[3] }"
          />
        </button>
        <div
          x-show="open[3]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-3"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Yes! Every server comes with terrabit-scale DDoS protection at no
            extra cost. Whether someone's trying to knock your server offline or
            you're dealing with a massive influx of players, our network keeps
            you online and playable.
          </p>
        </div>
      </div>

      <!-- Question 5 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[4] = !open[4]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[4] = !open[4]"
          @keydown.space.prevent="open[4] = !open[4]"
          @focus="focusedIndex = 4"
          id="question-4"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[4]"
          aria-controls="content-4"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >Can I transfer my server to QuackHost?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[4] }"
          />
        </button>
        <div
          x-show="open[4]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-4"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            Yes! We'll help you migrate your server to QuackHost for free. Just
            upload your world files, plugins, and configs through QuackPlane's
            file manager. Our support team can also assist with the transfer to
            make sure everything works perfectly on our platform.
          </p>
        </div>
      </div>

      <!-- Question 6 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[5] = !open[5]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[5] = !open[5]"
          @keydown.space.prevent="open[5] = !open[5]"
          @focus="focusedIndex = 5"
          id="question-5"
          class="w-full flex justify-between items-center py-5 text-left hover:bg-cool-gray-90 focus:bg-cool-gray-90 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors"
          :aria-expanded="open[5]"
          aria-controls="content-5"
        >
          <span class="text-base sm:text-lg font-semibold pr-4"
            >What payment methods do you accept?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[5] }"
          />
        </button>
        <div
          x-show="open[5]"
          x-transition:enter="transition-all ease-out duration-50"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-cloak
          id="content-5"
          class="overflow-hidden"
        >
          <p class="text-white leading-relaxed pb-5 pr-12">
            We accept all major credit cards, PayPal, and various digital
            payment methods. Billing is monthly with no long-term contracts
            required. You can update your payment method anytime through the
            client portal.
          </p>
        </div>
      </div>
    </div>
  </div>

  <style>
    /* Hide Alpine.js content on initial page load */
    [x-cloak] {
      display: none !important;
    }
  </style>
</Layout>
