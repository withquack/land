---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Unbeatable Game Servers">
  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 mb-16">
    <!-- Hero Text -->
    <div class="bg-cool-gray-90 border border-cool-gray-70 p-8 lg:p-12 flex flex-col justify-between min-h-[400px] lg:min-h-[500px]">
      <div>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold mb-6">
          <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
            Your server &
          </span>
        </h1>
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-semibold mb-8">
          <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">
            Our obsession.
          </span>
        </h1>
        <p class="text-cool-gray-40 text-lg leading-relaxed max-w-xl">
          High-performance game servers built for communities that demand reliability, scalability, and zero compromises.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <a
          href="/pricing"
          class="inline-flex justify-center items-center px-8 py-4 text-base font-semibold text-black bg-[#FF9C20] hover:bg-[#CC6600] transition-colors duration-200 border-2 border-[#FF9C20]"
        >
          Launch your server
        </a>
        <a
          href="/quackplane"
          class="inline-flex justify-center items-center px-8 py-4 text-base font-semibold text-white hover:text-black border-2 border-[#FF9C20] hover:bg-[#FF8D00] transition-colors duration-200"
        >
          Discover QuackPlane
        </a>
      </div>
    </div>

    <!-- Hero Image Placeholder -->
    <div class="bg-gradient-to-br from-cool-gray-80 to-cool-gray-90 border border-cool-gray-70 border-l-0 lg:border-l-0 p-8 lg:p-12 flex items-center justify-center min-h-[400px] lg:min-h-[500px]">
      <div class="text-center">
        <div class="w-48 h-48 mx-auto bg-cool-gray-70 border border-cool-gray-60 flex items-center justify-center">
          <span class="text-cool-gray-50 text-sm">HERO IMAGE</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Features Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 mb-16">
    <!-- Feature 1: Powerful -->
    <a
      href="#powerful"
      class="group bg-cyan-100 border border-cyan-90 p-8 hover:bg-cyan-90 transition-colors duration-200 min-h-[280px] flex flex-col"
    >
      <div class="flex-grow">
        <div class="mb-4">
          <h2 class="text-2xl lg:text-3xl font-semibold text-white group-hover:text-cyan-30 transition-colors">
            Powerful
          </h2>
          <div class="w-12 h-1 bg-cyan-50 mt-2"></div>
        </div>
        <p class="text-cyan-30 leading-relaxed">
          High-performance infrastructure running the latest hardware. Dedicated resources ensure your servers run smoothly, even with tons of mods and plugins.
        </p>
      </div>
      <div class="mt-4 text-cyan-40 group-hover:text-cyan-20 transition-colors text-xl">
        →
      </div>
    </a>

    <!-- Feature 2: Reliable -->
    <a
      href="#reliable"
      class="group bg-blue-100 border border-blue-90 border-l-0 md:border-l-0 p-8 hover:bg-blue-90 transition-colors duration-200 min-h-[280px] flex flex-col"
    >
      <div class="flex-grow">
        <div class="mb-4">
          <h2 class="text-2xl lg:text-3xl font-semibold text-white group-hover:text-blue-30 transition-colors">
            Reliable
          </h2>
          <div class="w-12 h-1 bg-blue-50 mt-2"></div>
        </div>
        <p class="text-blue-30 leading-relaxed">
          Terrabit-scale DDoS protection keeps your server online during attacks. Check our live service status to see our track record.
        </p>
      </div>
      <div class="mt-4 text-blue-40 group-hover:text-blue-20 transition-colors text-xl">
        →
      </div>
    </a>

    <!-- Feature 3: Scalable -->
    <a
      href="#scalable"
      class="group bg-green-100 border border-green-90 border-l-0 lg:border-l-0 p-8 hover:bg-green-90 transition-colors duration-200 min-h-[280px] flex flex-col"
    >
      <div class="flex-grow">
        <div class="mb-4">
          <h2 class="text-2xl lg:text-3xl font-semibold text-white group-hover:text-green-30 transition-colors">
            Scalable
          </h2>
          <div class="w-12 h-1 bg-green-50 mt-2"></div>
        </div>
        <p class="text-green-30 leading-relaxed">
          Easily upgrade or downgrade your plan as your community grows or shrinks. Scale your resources up and down as needed without losing your data.
        </p>
      </div>
      <div class="mt-4 text-green-40 group-hover:text-green-20 transition-colors text-xl">
        →
      </div>
    </a>
  </div>

  <!-- Large Feature Blocks -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-0 mb-16">
    <!-- Transparent Pricing Block -->
    <div class="bg-cool-gray-90 border border-cool-gray-70 p-8 lg:p-12 flex flex-col justify-end min-h-[400px]">
      <div class="mb-auto">
        <div class="w-full h-32 bg-cool-gray-80 border border-cool-gray-70 mb-8 flex items-center justify-center">
          <span class="text-cool-gray-50 text-sm">PRICING GRAPHIC</span>
        </div>
      </div>
      <div>
        <h2 class="text-3xl lg:text-4xl font-semibold text-white mb-4">
          Transparent Pricing
        </h2>
        <div class="w-16 h-1 bg-teal-50 mb-4"></div>
        <p class="text-cool-gray-40 leading-relaxed text-lg">
          Complete visibility into pricing, resource usage, and server performance. No hidden fees, no surprise charges - just honest, straightforward hosting with clear billing.
        </p>
      </div>
    </div>

    <!-- Backup Security Block -->
    <div class="bg-gradient-to-br from-cool-gray-80 to-cool-gray-90 border border-cool-gray-70 border-l-0 lg:border-l-0 p-8 lg:p-12 flex flex-col justify-start min-h-[400px]">
      <div>
        <h2 class="text-3xl lg:text-4xl font-semibold text-white mb-4">
          Off-Site Backups
        </h2>
        <div class="w-16 h-1 bg-purple-50 mb-4"></div>
        <p class="text-cool-gray-40 leading-relaxed text-lg mb-8">
          Schedule automatic backups or take your own backups manually. The key advantage: all backups are stored off-site, protecting your worlds even if our datacenter goes down.
        </p>
      </div>
      <div class="mt-auto">
        <div class="w-full h-32 bg-cool-gray-90 border border-cool-gray-70 flex items-center justify-center">
          <span class="text-cool-gray-50 text-sm">BACKUP ILLUSTRATION</span>
        </div>
      </div>
    </div>
  </div>

  <!-- QuackPlane Control Panel Section -->
  <div class="bg-cool-gray-90 border border-cool-gray-70 p-8 lg:p-12 mb-16">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">
      <!-- Image -->
      <div class="lg:col-span-3 bg-cool-gray-80 border border-cool-gray-70 p-4 flex items-center justify-center min-h-[400px]">
        <span class="text-cool-gray-50 text-sm">QUACKPLANE DASHBOARD</span>
      </div>

      <!-- Features List -->
      <div class="lg:col-span-2 flex flex-col justify-between">
        <div class="mb-8">
          <h2 class="text-3xl lg:text-4xl font-semibold text-white mb-4">
            QuackPlane
          </h2>
          <div class="w-16 h-1 bg-[#FF9C20] mb-4"></div>
          <p class="text-cool-gray-40 leading-relaxed">
            Your control center for managing game servers. Built for simplicity and power.
          </p>
        </div>

        <div class="space-y-6">
          <div class="border-l-4 border-teal-50 pl-4">
            <h3 class="text-xl font-semibold text-white mb-2">
              Create your own staff team
            </h3>
            <p class="text-cool-gray-40 leading-relaxed text-sm">
              Give your friends and moderators access to restart the server, manage files, or monitor players.
            </p>
          </div>

          <div class="border-l-4 border-cyan-50 pl-4">
            <h3 class="text-xl font-semibold text-white mb-2">
              Manage from anywhere
            </h3>
            <p class="text-cool-gray-40 leading-relaxed text-sm">
              Web-based control plane lets you restart servers, monitor player activity, and manage your worlds from any device.
            </p>
          </div>

          <div class="border-l-4 border-purple-50 pl-4">
            <h3 class="text-xl font-semibold text-white mb-2">
              One-click restoration
            </h3>
            <p class="text-cool-gray-40 leading-relaxed text-sm">
              Roll back your entire server to any previous backup with one click. Everything gets restored - worlds, configs, mods, the lot.
            </p>
          </div>

          <div class="border-l-4 border-blue-50 pl-4">
            <h3 class="text-xl font-semibold text-white mb-2">
              Easy file management
            </h3>
            <p class="text-cool-gray-40 leading-relaxed text-sm">
              Upload mods, plugins, and resource packs with drag & drop. Built-in text editor lets you tweak configs.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Call to Action Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-0 mb-16">
    <!-- CTA 1 -->
    <a
      href="/pricing"
      class="group bg-gradient-to-br from-[#FF9C20] to-[#FF8D00] border border-[#FF9C20] p-12 hover:from-[#CC6600] hover:to-[#CC6600] transition-all duration-200 min-h-[300px] flex flex-col justify-between"
    >
      <div>
        <h2 class="text-4xl lg:text-5xl font-semibold text-black mb-4">
          Start building today
        </h2>
        <p class="text-gray-100 text-lg leading-relaxed">
          Your server is ready in under 2 minutes. No waiting around - you can start building your world immediately.
        </p>
      </div>
      <div class="text-black text-2xl font-semibold group-hover:translate-x-2 transition-transform">
        View pricing →
      </div>
    </a>

    <!-- CTA 2 -->
    <a
      href="/service-status"
      class="group bg-cool-gray-90 border border-cool-gray-70 border-l-0 md:border-l-0 p-12 hover:bg-cool-gray-80 transition-colors duration-200 min-h-[300px] flex flex-col justify-between"
    >
      <div>
        <h2 class="text-4xl lg:text-5xl font-semibold text-white mb-4">
          99.9% uptime
        </h2>
        <p class="text-cool-gray-40 text-lg leading-relaxed">
          Check our live service status and see our track record for yourself. We're transparent about our performance.
        </p>
      </div>
      <div class="text-[#FF9C20] text-2xl font-semibold group-hover:translate-x-2 transition-transform">
        View status →
      </div>
    </a>
  </div>

  <style>
    /* Remove any default rounding */
    * {
      border-radius: 0 !important;
    }
  </style>
</Layout>
