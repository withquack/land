---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Unbeatable Game Servers">
  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-7 mb-12 gap-8 pb-4 items-center">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <div>
        <div class="text-5xl md:text-7xl font-semibold leading-tight mb-6">
          <h1
            class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] via-[#FF9C20] to-[#FF8D00] bg-clip-text animate-gradient"
          >
            Your server.
          </h1>
          <h1
            class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] via-[#FF9C20] to-[#FF8D00] bg-clip-text animate-gradient"
          >
            Our obsession.
          </h1>
        </div>
        <p class="text-xl md:text-2xl text-cool-gray-30 mb-8 leading-relaxed max-w-2xl">
          Experience game server hosting that's <span class="text-[#FF9C20] font-semibold">blazingly fast</span>,
          <span class="text-cyan-40 font-semibold">rock solid</span>, and
          <span class="text-green-40 font-semibold">incredibly simple</span>.
          Your players deserve the best. We deliver it.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 text-base">
        <a
          href="/pricing"
          class="group inline-flex justify-center items-center px-8 py-4 text-lg font-semibold text-black bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] hover:from-[#FF8D00] hover:to-[#CC6600] transition-all duration-300 shadow-lg hover:shadow-xl hover:scale-105 transform"
        >
          <span>Launch your server</span>
          <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/quackplane"
          class="group inline-flex justify-center items-center px-8 py-4 text-lg font-semibold text-white hover:text-black border-2 border-[#FF9C20] hover:bg-gradient-to-r hover:from-[#FF9C20] hover:to-[#FF8D00] transition-all duration-300 shadow-md hover:shadow-lg hover:scale-105 transform"
        >
          <span>Discover QuackPlane</span>
          <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
      </div>
    </div>
    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] rounded-lg blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
        <img
          src="https://w7.pngwing.com/pngs/227/144/png-transparent-minecraft-illustration-minecraft-pocket-edition-minecraft-story-mode-xbox-360-wii-u-minecraft-game-video-game-mojang.png"
          alt="Minecraft"
          class="relative max-w-full h-auto transform group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    </div>
  </div>

  <!-- Trust Indicators / Stats Bar -->
  <div class="mb-20 lg:mb-28">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-lg border border-gray-80 hover:border-[#FF9C20] transition-all duration-300 hover:shadow-lg hover:shadow-[#FF9C20]/20 transform hover:-translate-y-1">
        <div class="text-3xl lg:text-4xl font-bold text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text mb-2">99.9%</div>
        <div class="text-cool-gray-40 text-sm lg:text-base">Uptime Guarantee</div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-lg border border-gray-80 hover:border-cyan-50 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-50/20 transform hover:-translate-y-1">
        <div class="text-3xl lg:text-4xl font-bold text-transparent bg-gradient-to-r from-cyan-40 to-cyan-60 bg-clip-text mb-2">&lt;10ms</div>
        <div class="text-cool-gray-40 text-sm lg:text-base">Average Latency</div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-lg border border-gray-80 hover:border-green-50 transition-all duration-300 hover:shadow-lg hover:shadow-green-50/20 transform hover:-translate-y-1">
        <div class="text-3xl lg:text-4xl font-bold text-transparent bg-gradient-to-r from-green-40 to-green-60 bg-clip-text mb-2">24/7</div>
        <div class="text-cool-gray-40 text-sm lg:text-base">Expert Support</div>
      </div>
      <div class="bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-lg border border-gray-80 hover:border-purple-50 transition-all duration-300 hover:shadow-lg hover:shadow-purple-50/20 transform hover:-translate-y-1">
        <div class="text-3xl lg:text-4xl font-bold text-transparent bg-gradient-to-r from-purple-40 to-purple-60 bg-clip-text mb-2">10k+</div>
        <div class="text-cool-gray-40 text-sm lg:text-base">Servers Hosted</div>
      </div>
    </div>
  </div>

  <!-- Supported Games Section -->
  <div class="mb-20 lg:mb-32">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">
        <span class="text-white">Host your favorite</span>
        <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">games</span>
      </h2>
      <p class="text-xl text-cool-gray-40 max-w-3xl mx-auto">
        From Minecraft to Rust, we support all the games your community loves.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-[#FF9C20] transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">🎮</div>
        <h4 class="font-semibold text-white mb-1">Minecraft</h4>
        <p class="text-xs text-cool-gray-40">Java & Bedrock</p>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-cyan-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">⚔️</div>
        <h4 class="font-semibold text-white mb-1">Rust</h4>
        <p class="text-xs text-cool-gray-40">Survival</p>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-green-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">🧟</div>
        <h4 class="font-semibold text-white mb-1">ARK</h4>
        <p class="text-xs text-cool-gray-40">Survival Evolved</p>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-purple-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">🔫</div>
        <h4 class="font-semibold text-white mb-1">CS2</h4>
        <p class="text-xs text-cool-gray-40">Counter-Strike 2</p>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-blue-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">🏗️</div>
        <h4 class="font-semibold text-white mb-1">Valheim</h4>
        <p class="text-xs text-cool-gray-40">Viking Survival</p>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-6 rounded-xl border border-gray-80 hover:border-teal-50 transition-all duration-300 hover:shadow-xl hover:-translate-y-2 text-center">
        <div class="mb-4 text-4xl">🎯</div>
        <h4 class="font-semibold text-white mb-1">+50 More</h4>
        <p class="text-xs text-cool-gray-40">View all games</p>
      </div>
    </div>

    <div class="text-center mt-12">
      <a href="/games" class="inline-flex items-center text-[#FF9C20] hover:text-[#FF8D00] font-semibold transition-colors group">
        <span>Browse all supported games</span>
        <svg class="ml-2 w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Features Section -->
  <div class="mb-20 lg:mb-32" aria-label="Product Features">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-5xl font-bold mb-4">
        <span class="text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text">Why gamers choose</span>
        <span class="text-white">QuackHost</span>
      </h2>
      <p class="text-xl text-cool-gray-40 max-w-3xl mx-auto">
        Every feature designed with one goal: giving you and your players the best gaming experience possible.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-12 lg:gap-y-12"
    >
      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-xl border border-gray-80 hover:border-cyan-50 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-50/10 transform hover:-translate-y-2">
        <div class="flex items-start mb-4">
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-cyan-50 to-cyan-60 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-gray-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-auto transition duration-300 ease-out group-hover:-translate-y-2 group-hover:scale-110"
            alt=""
            width="34"
            height="34"
          />
        </div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-white">
          Blazingly Powerful
        </h3>
        <p class="text-cool-gray-30 leading-relaxed mb-4">
          High-performance infrastructure running the latest AMD Ryzen and Intel processors. Dedicated
          resources with NVMe SSD storage ensure your servers run smoothly, even with 200+ mods and
          dozens of plugins running simultaneously.
        </p>
        <ul class="text-cool-gray-40 text-sm space-y-2">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Latest Gen CPUs
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            NVMe SSD Storage
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-cyan-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Dedicated Resources
          </li>
        </ul>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-xl border border-gray-80 hover:border-blue-50 transition-all duration-300 hover:shadow-xl hover:shadow-blue-50/10 transform hover:-translate-y-2">
        <div class="flex items-start mb-4">
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-blue-50 to-blue-60 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-gray-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <img
            src="/index/doodles/rocking chair.svg"
            class="ml-auto transition duration-300 ease-out group-hover:scale-110"
            alt=""
            width="34"
            height="34"
          />
        </div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-white">
          Rock-Solid Reliable
        </h3>
        <p class="text-cool-gray-30 leading-relaxed mb-4">
          Enterprise-grade infrastructure with terrabit-scale DDoS protection keeps your server online during
          attacks. Multi-layered redundancy and automated failover systems ensure 99.9% uptime. Check our live <a
            href="/service-status"
            class="text-blue-40 font-semibold underline decoration-2 decoration-blue-40 hover:decoration-blue-50 hover:text-blue-30 transition-colors"
            >service status</a
          > to see our track record.
        </p>
        <ul class="text-cool-gray-40 text-sm space-y-2">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Terrabit DDoS Protection
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            99.9% Uptime SLA
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-blue-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Auto Failover Systems
          </li>
        </ul>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-xl border border-gray-80 hover:border-green-50 transition-all duration-300 hover:shadow-xl hover:shadow-green-50/10 transform hover:-translate-y-2">
        <div class="flex items-start mb-4">
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-green-50 to-green-60 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-gray-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
            </svg>
          </div>
          <img
            src="/index/doodles/cycle.svg"
            class="ml-auto transition duration-300 ease-out group-hover:animate-spin"
            alt=""
            width="34"
            height="34"
          />
        </div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-white">
          Infinitely Scalable
        </h3>
        <p class="text-cool-gray-30 leading-relaxed mb-4">
          Start small and grow massive. Easily upgrade or downgrade your plan as your community evolves.
          Scale your RAM, CPU, and storage independently in real-time without server downtime or losing
          your precious data. No contracts, no penalties - just pure flexibility.
        </p>
        <ul class="text-cool-gray-40 text-sm space-y-2">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-green-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Instant Scaling
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-green-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Zero Downtime Migration
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-green-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Prorated Billing
          </li>
        </ul>
      </div>

      <div class="group bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-xl border border-gray-80 hover:border-teal-50 transition-all duration-300 hover:shadow-xl hover:shadow-teal-50/10 transform hover:-translate-y-2">
        <div class="flex items-start mb-4">
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-teal-50 to-teal-60 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-gray-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <img
            src="/index/doodles/tree.svg"
            class="ml-auto transition duration-700 ease-out group-hover:scale-110"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-white">
          Crystal Clear Transparent
        </h3>
        <p class="text-cool-gray-30 leading-relaxed mb-4">
          Complete visibility into pricing, resource usage, and server
          performance metrics. Real-time monitoring dashboards show exactly what you're using and paying for.
          No hidden fees, no surprise charges, no fine print - just honest,
          straightforward hosting with clear, predictable billing.
        </p>
        <ul class="text-cool-gray-40 text-sm space-y-2">
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-teal-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Real-time Analytics
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-teal-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            No Hidden Fees
          </li>
          <li class="flex items-center">
            <svg class="w-4 h-4 mr-2 text-teal-50" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            Public Pricing
          </li>
        </ul>
      </div>

      <div class="group sm:col-span-2 bg-gradient-to-br from-gray-90 to-gray-100 p-8 rounded-xl border border-gray-80 hover:border-purple-50 transition-all duration-300 hover:shadow-xl hover:shadow-purple-50/10 transform hover:-translate-y-2">
        <div class="flex items-start mb-4">
          <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-purple-50 to-purple-60 rounded-lg flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-gray-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
            </svg>
          </div>
          <img
            src="/index/doodles/rain.svg"
            class="ml-auto transition duration-300 ease-out group-hover:translate-x-1 group-hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
            loading="lazy"
          />
        </div>
        <h3 class="text-xl lg:text-2xl font-semibold mb-3 text-white">
          Military-Grade Backups
        </h3>
        <p class="text-cool-gray-30 leading-relaxed mb-4">
