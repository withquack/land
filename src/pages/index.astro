---
import Layout from "../layouts/layout.astro";
---

<Layout title="/ Unbetable Game Servers">
  <!-- Hero Section -->
  <div class="grid grid-cols-1 lg:grid-cols-7 mb-8 gap-8 pb-4 items-center">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <div class="text-5xl md:text-7xl">
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
        >
          Your server &
        </h1>
        <h1
          class="text-transparent gradient bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
        >
          Our obsession.
        </h1>
      </div>

      <!-- Social Proof Counter -->
      <div
        class="mt-6 mb-8"
        x-data="{
          servers: 0,
          players: 0,
          uptime: 99.0,
          mounted: false,
          animateCounter(target, current, speed) {
            if (current < target) {
              setTimeout(() => {
                const increment = Math.ceil((target - current) / 20);
                const next = Math.min(current + increment, target);
                if (target === 10247) this.servers = next;
                else if (target === 87532) this.players = next;
                else if (target === 99.97) this.uptime = Math.min(current + 0.05, target);
                this.animateCounter(target, next, speed);
              }, speed);
            }
          }
        }"
        x-init="mounted = true; animateCounter(10247, 0, 30); animateCounter(87532, 0, 20)"
      >
        <div class="flex flex-wrap gap-6 text-cool-gray-30">
          <div>
            <div class="text-3xl font-bold text-white">
              <span x-text="servers.toLocaleString()">0</span>+
            </div>
            <div class="text-sm">Active Servers</div>
          </div>
          <div class="border-l border-cool-gray-70 pl-6">
            <div class="text-3xl font-bold text-white">
              <span x-text="players.toLocaleString()">0</span>+
            </div>
            <div class="text-sm">Players Online</div>
          </div>
          <div class="border-l border-cool-gray-70 pl-6">
            <div class="text-3xl font-bold text-[#FF9C20]">
              99.97%
            </div>
            <div class="text-sm">Uptime SLA</div>
          </div>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row text-base gap-4">
        <div>
          <a
            href="/pricing"
            class="inline-flex justify-center items-center w-full sm:w-64 p-3 text-black bg-[#FF9C20] hover:bg-[#CC6600] transition-colors duration-200 font-semibold"
          >
            Start Free Trial →
          </a>
          <p class="text-xs text-cool-gray-40 mt-2">No credit card required • 2GB RAM included</p>
        </div>
        <div>
          <a
            href="/quackplane"
            class="inline-flex justify-center items-center w-full sm:w-64 p-3 text-white hover:text-black border border-[#FF9C20] hover:bg-[#FF8D00] transition-colors duration-200"
          >
            Discover QuackPlane
          </a>
        </div>
      </div>
    </div>
    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <img
        src="https://w7.pngwing.com/pngs/227/144/png-transparent-minecraft-illustration-minecraft-pocket-edition-minecraft-story-mode-xbox-360-wii-u-minecraft-game-video-game-mojang.png"
        alt="Minecraft"
        class="max-w-full h-auto"
      />
    </div>
  </div>

  <!-- Trust Badges -->
  <div class="mb-16 pb-8 border-b border-cool-gray-80">
    <div class="flex flex-wrap justify-center gap-8 items-center text-cool-gray-40 text-sm">
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Terrabit DDoS Protection</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>ISO 27001 Certified</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>24/7 Expert Support</span>
      </div>
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-green-50" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Money-Back Guarantee</span>
      </div>
    </div>
  </div>

  <!-- Features Section -->
  <div class="mb-16 lg:mb-32" aria-label="Product Features">
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-12 lg:gap-y-16"
    >
      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-cyan-50">Powerful</span
          >
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-2 transition duration-300 ease-out hover:-translate-y-1"
            alt=""
            width="34"
            height="34"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          High-performance infrastructure running the latest hardware. Dedicated
          resources ensure your servers run smoothly, even with tons of mods and
          plugins.
        </p>
      </div>

      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-blue-50">Reliable</span
          >
          <img
            src="/index/doodles/rocking chair.svg"
            class="ml-2"
            alt=""
            width="34"
            height="34"
          />
        </h2>
        <p class="text-cool-gray-40 leading-relaxed">
          Terrabit-scale DDoS protection keeps your server online during
          attacks. Check our live <a
            href="/service-status"
            class="text-blue-40 underline decoration-2 decoration-blue-40 hover:decoration-blue-50 transition-colors"
            >service status</a
          > to see our track record.
        </p>
      </div>

      <div>
        <h2 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
          <span class="underline decoration-4 decoration-green-50"
