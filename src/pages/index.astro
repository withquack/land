---
import Layout from "../layouts/layout.astro";
---

<Layout
  title="/ Unbeatable Game Servers"
  description="Lightning-fast game server hosting with DDoS protection, off-site backups, and QuackPlane - the modern control panel. Launch your Minecraft server in under 2 minutes. No hidden fees, no contracts, just honest hosting."
>
  <!-- Hero Section -->
  <section class="grid grid-cols-1 lg:grid-cols-7 mb-20 lg:mb-32 gap-8 lg:gap-12 pb-4 items-center" aria-labelledby="hero-heading">
    <div
      class="col-span-1 lg:col-span-4 order-1 lg:order-1 text-white flex flex-col justify-between h-full"
    >
      <div class="space-y-4">
        <h1
          id="hero-heading"
          class="text-5xl md:text-6xl lg:text-7xl font-semibold leading-tight"
        >
          <span
            class="block text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
          >
            Your server&nbsp;&
          </span>
          <span
            class="block text-transparent bg-gradient-to-r from-[#FF9C20] to-[#FF8D00] bg-clip-text"
          >
            Our obsession.
          </span>
        </h1>
        <p class="text-lg lg:text-xl text-cool-gray-30 leading-relaxed max-w-2xl">
          Lightning-fast game servers with DDoS protection, off-site backups, and QuackPlane - the control panel that works everywhere. Launch in under 2 minutes.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-8" role="group" aria-label="Primary actions">
        <a
          href="/pricing"
          class="group inline-flex justify-center items-center px-6 py-4 text-base lg:text-lg font-semibold text-black bg-[#FF9C20] hover:bg-[#FF8D00] focus:bg-[#FF8D00] transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 focus:outline-none focus:ring-4 focus:ring-[#FF9C20] focus:ring-opacity-50"
        >
          <span>Launch your server</span>
          <svg class="ml-2 w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
        <a
          href="/quackplane"
          class="group inline-flex justify-center items-center px-6 py-4 text-base lg:text-lg font-semibold text-white border-2 border-[#FF9C20] hover:bg-[#FF9C20] hover:bg-opacity-10 focus:bg-[#FF9C20] focus:bg-opacity-10 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-[#FF9C20] focus:ring-opacity-50"
        >
          <span>Discover QuackPlane</span>
        </a>
      </div>

      <!-- Trust Signals -->
      <div class="mt-8 pt-8 border-t border-cool-gray-80">
        <div class="flex flex-wrap gap-6 text-sm text-cool-gray-40">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>Ready in 2 minutes</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>No contracts, cancel anytime</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-green-40" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
            </svg>
            <span>100% transparent pricing</span>
          </div>
        </div>
      </div>
    </div>

    <div
      class="col-span-1 lg:col-span-3 order-2 lg:order-2 text-cool-gray-30 flex justify-center lg:justify-end items-center"
    >
      <img
        src="/index/minecraft-hero.png"
        alt="Minecraft server hosting with QuackHost"
        class="max-w-full h-auto drop-shadow-2xl"
        width="500"
        height="500"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  <!-- Features Section -->
  <section class="mb-20 lg:mb-32" aria-labelledby="features-heading">
    <h2 id="features-heading" class="sr-only">Why choose QuackHost</h2>
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-x-16 lg:gap-y-20"
    >
      <!-- Feature 1: Powerful -->
      <article class="group">
        <h3 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="underline decoration-4 decoration-cyan-50 underline-offset-4">Powerful</span>
          <img
            src="/index/doodles/joy leap 2.svg"
            class="ml-3 transition duration-300 ease-out group-hover:-translate-y-2"
            alt=""
            width="34"
            height="34"
            aria-hidden="true"
          />
        </h3>
        <p class="text-cool-gray-30 leading-relaxed text-base lg:text-lg">
          High-performance infrastructure with latest-gen hardware and dedicated resources. Run hundreds of mods and plugins without lag - your players won't know the difference between 10 or 100.
        </p>
      </article>

      <!-- Feature 2: Reliable -->
      <article class="group">
        <h3 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="underline decoration-4 decoration-blue-50 underline-offset-4">Reliable</span>
          <img
            src="/index/doodles/rocking chair.svg"
            class="ml-3 transition duration-300 ease-out group-hover:scale-110"
            alt=""
            width="34"
            height="34"
            aria-hidden="true"
          />
        </h3>
        <p class="text-cool-gray-30 leading-relaxed text-base lg:text-lg">
          Terrabit-scale DDoS protection keeps griefers out and your community online. Don't take our word for it - check our <a
            href="/service-status"
            class="text-blue-40 underline decoration-2 decoration-blue-40 hover:text-blue-30 hover:decoration-blue-30 transition-colors font-medium"
            >live service status</a>.
        </p>
      </article>

      <!-- Feature 3: Scalable -->
      <article class="group">
        <h3 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="underline decoration-4 decoration-green-50 underline-offset-4">Scalable</span>
          <img
            src="/index/doodles/cycle.svg"
            class="ml-3 transition duration-300 ease-out group-hover:rotate-180"
            alt=""
            width="34"
            height="34"
            aria-hidden="true"
          />
        </h3>
        <p class="text-cool-gray-30 leading-relaxed text-base lg:text-lg">
          Community growing? Scale up instantly. Quiet season? Scale down. Change plans anytime without losing your worlds, configs, or sanity. Zero downtime, zero data loss.
        </p>
      </article>

      <!-- Feature 4: Transparent -->
      <article class="group">
        <h3 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="underline decoration-4 decoration-teal-50 underline-offset-4">Transparent</span>
          <img
            src="/index/doodles/tree.svg"
            class="ml-3 transition duration-700 ease-out group-hover:scale-125"
            alt=""
            width="34"
            height="34"
            loading="lazy"
            aria-hidden="true"
          />
        </h3>
        <p class="text-cool-gray-30 leading-relaxed text-base lg:text-lg">
          See exactly what you're paying for - pricing, resource usage, and server performance all visible at a glance. No hidden fees. No surprise charges. No fine print. Just honest hosting.
        </p>
      </article>

      <!-- Feature 5: Backups -->
      <article class="sm:col-span-2 group">
        <h3 class="text-xl lg:text-2xl font-semibold mb-4 flex items-center">
          <span class="underline decoration-4 decoration-purple-50 underline-offset-4">Protected by off-site backups</span>
          <img
            src="/index/doodles/rain.svg"
            class="ml-3 transition duration-300 ease-out group-hover:translate-x-2 group-hover:-translate-y-2"
            alt=""
            width="34"
            height="34"
            loading="lazy"
            aria-hidden="true"
          />
        </h3>
        <p class="text-cool-gray-30 leading-relaxed text-base lg:text-lg">
          Automatic or manual backups - your choice. The difference? We store them off-site, meaning even if our entire datacenter vanishes, your months of creative work survive. One-click restoration when disaster strikes.
        </p>
      </article>
    </div>
  </section>

  <!-- QuackPlane Section -->
  <section class="mb-20 lg:mb-32 py-12 lg:py-20 px-6 lg:px-12 bg-cool-gray-90 bg-opacity-30 rounded-lg border border-cool-gray-80" aria-labelledby="quackplane-heading">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 lg:gap-16 items-center">
      <div class="lg:col-span-3">
        <img
          src="/index/quackplane.webp"
          class="w-full rounded-lg shadow-2xl border border-cool-gray-70"
          alt="QuackPlane Control Panel Interface - Manage your game servers from anywhere"
          width="1253"
          height="1016"
          loading="lazy"
        />
      </div>

      <div class="lg:col-span-2 space-y-10">
        <div>
          <h2 id="quackplane-heading" class="text-3xl lg:text-4xl font-semibold mb-4 text-transparent bg-gradient-to-r from-cyan-40 to-blue-40 bg-clip-text">
            Powered by QuackPlane
          </h2>
          <p class="text-cool-gray-30 text-lg leading-relaxed">
            The control panel that doesn't get in your way. Manage everything from your phone, tablet, or desktop.
          </p>
        </div>

        <article class="group">
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-teal-50 underline-offset-4">Build your staff team</span>
            <img
              src="/index/doodles/hand holding.svg"
              alt=""
              width="34"
              height="34"
              class="ml-3 transition duration-300 ease-out group-hover:scale-110"
              aria-hidden="true"
            />
          </h3>
          <p class="text-cool-gray-30 leading-relaxed">
            Grant friends and moderators specific permissions - restart servers, manage files, monitor players. No password sharing, no security nightmares.
          </p>
        </article>

        <article class="group">
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-cyan-50 underline-offset-4">Manage from anywhere</span>
            <img
              src="/index/doodles/wizard.svg"
              alt=""
              width="34"
              height="34"
              class="ml-3 transition duration-300 ease-out group-hover:-translate-y-1"
              aria-hidden="true"
            />
          </h3>
          <p class="text-cool-gray-30 leading-relaxed">
            Web-based control panel works on every device. Restart crashed servers from your phone. Monitor player activity from your tablet. No apps to install, no compatibility issues.
          </p>
        </article>

        <article class="group">
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-purple-50 underline-offset-4">One-click restoration</span>
            <img
              src="/index/doodles/magic wand.svg"
              alt=""
              width="34"
              height="34"
              class="ml-3 transition duration-300 ease-out group-hover:translate-x-2 group-hover:-translate-y-2"
              aria-hidden="true"
            />
          </h3>
          <p class="text-cool-gray-30 leading-relaxed">
            Griefer destroyed your build? Roll back to any backup with literally one click. Worlds, configs, mods - everything restored to exactly how it was.
          </p>
        </article>

        <article class="group">
          <h3 class="text-xl lg:text-2xl font-semibold mb-3 flex items-center">
            <span class="underline decoration-4 decoration-blue-50 underline-offset-4">Drag & drop file management</span>
            <img
              src="/index/doodles/upload.svg"
              alt=""
              width="34"
              height="34"
              class="ml-3 transition duration-300 ease-out group-hover:-translate-y-1"
              aria-hidden="true"
            />
          </h3>
          <p class="text-cool-gray-30 leading-relaxed">
            Upload mods, plugins, and resource packs by dragging them onto your browser. Edit configs in our built-in text editor. No FTP clients, no command line required.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section
    class="mb-20 lg:mb-32"
    x-data="{ open: [false, false, false, false, false, false], focusedIndex: 0 }"
    aria-labelledby="faq-heading"
  >
    <h2
      id="faq-heading"
      class="text-3xl lg:text-4xl font-semibold mb-12 flex items-center gap-3 flex-wrap"
    >
      <img
        src="/index/doodles/chat.svg"
        loading="lazy"
        alt=""
        width="48"
        height="48"
        class="sm:w-[62px] sm:h-[62px]"
        aria-hidden="true"
      />
      <span class="underline decoration-4 decoration-teal-40 underline-offset-4">Questions?</span>
      <img
        src="/index/doodles/owl.svg"
        loading="lazy"
        alt=""
        width="48"
        height="48"
        class="sm:w-[62px] sm:h-[62px]"
        aria-hidden="true"
      />
      <span class="underline decoration-4 decoration-purple-40 underline-offset-4">We've got answers.</span>
    </h2>

    <div class="space-y-2">
      <!-- Question 1 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[0] = !open[0]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[0] = !open[0]"
          @keydown.space.prevent="open[0] = !open[0]"
          @focus="focusedIndex = 0"
          id="question-0"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[0]"
          aria-controls="content-0"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >How quickly can I get my server online?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[0] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[0]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-0"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            Under 2 minutes from payment to play. Our automated system provisions your server instantly, configures DDoS protection, sets up backups, and sends you login credentials. No approval queues, no manual setup, no waiting around.
          </p>
        </div>
      </div>

      <!-- Question 2 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[1] = !open[1]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[1] = !open[1]"
          @keydown.space.prevent="open[1] = !open[1]"
          @focus="focusedIndex = 1"
          id="question-1"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[1]"
          aria-controls="content-1"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >Can I change plans anytime?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[1] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[1]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-1"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            Absolutely. Upgrade when your community explodes, downgrade during quiet periods. Changes take effect immediately, billing is prorated to the second. No contracts binding you, no penalties for switching, just flexibility.
          </p>
        </div>
      </div>

      <!-- Question 3 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[2] = !open[2]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[2] = !open[2]"
          @keydown.space.prevent="open[2] = !open[2]"
          @focus="focusedIndex = 2"
          id="question-2"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[2]"
          aria-controls="content-2"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >What if my server gets griefed?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[2] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[2]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-2"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            One click in QuackPlane rolls your entire server back to any previous backup. Worlds, configs, mods, plugins - everything restored to exactly how it was before the griefing. All backups stored off-site, so even datacenter failures can't touch your creations.
          </p>
        </div>
      </div>

      <!-- Question 4 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[3] = !open[3]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[3] = !open[3]"
          @keydown.space.prevent="open[3] = !open[3]"
          @focus="focusedIndex = 3"
          id="question-3"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[3]"
          aria-controls="content-3"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >How does DDoS protection work?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[3] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[3]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-3"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            Every server gets terrabit-scale DDoS protection automatically - no extra fees, no configuration required. Attack traffic gets filtered before it reaches your server. Your players stay connected while attackers waste their time and money.
          </p>
        </div>
      </div>

      <!-- Question 5 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[4] = !open[4]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[4] = !open[4]"
          @keydown.space.prevent="open[4] = !open[4]"
          @focus="focusedIndex = 4"
          id="question-4"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[4]"
          aria-controls="content-4"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >Can I migrate my existing server?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[4] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[4]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-4"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            Yes - and we'll help you do it free. Drag your world files, plugins, and configs into QuackPlane's file manager. Need help? Our support team can handle the migration for you and verify everything works perfectly.
          </p>
        </div>
      </div>

      <!-- Question 6 -->
      <div class="border-b border-cool-gray-70">
        <button
          @click="open[5] = !open[5]"
          @keydown.down.prevent="focusedIndex = Math.min(5, focusedIndex + 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.up.prevent="focusedIndex = Math.max(0, focusedIndex - 1); $nextTick(() => document.getElementById('question-' + focusedIndex).focus())"
          @keydown.enter.prevent="open[5] = !open[5]"
          @keydown.space.prevent="open[5] = !open[5]"
          @focus="focusedIndex = 5"
          id="question-5"
          class="w-full flex justify-between items-center py-6 px-4 text-left hover:bg-cool-gray-90 hover:bg-opacity-50 focus:bg-cool-gray-90 focus:bg-opacity-50 focus:outline-none focus:ring-2 focus:ring-blue-60 focus:ring-inset transition-colors rounded"
          :aria-expanded="open[5]"
          aria-controls="content-5"
        >
          <span class="text-base sm:text-lg lg:text-xl font-semibold pr-4"
            >What payment methods work?</span
          >
          <img
            src="/index/chevron-down.svg"
            alt=""
            width="24"
            height="24"
            class="transform transition-transform duration-200 ease-out flex-shrink-0"
            :class="{ 'rotate-180': open[5] }"
            aria-hidden="true"
          />
        </button>
        <div
          x-show="open[5]"
          x-transition:enter="transition-all ease-out duration-200"
          x-transition:enter-start="transform -translate-y-2 opacity-0"
          x-transition:enter-end="transform translate-y-0 opacity-100"
          x-transition:leave="transition-all ease-in duration-150"
          x-transition:leave-start="transform translate-y-0 opacity-100"
          x-transition:leave-end="transform -translate-y-2 opacity-0"
          x-cloak
          id="content-5"
          class="overflow-hidden"
        >
          <p class="text-cool-gray-20 text-base lg:text-lg leading-relaxed pb-6 px-4 pr-12">
            All major credit cards, PayPal, and various digital payment methods. Monthly billing, no long-term contracts. Update your payment method anytime through the client portal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA Section -->
  <section class="mb-20 text-center py-16 px-6 bg-gradient-to-r from-cool-gray-90 to-cool-gray-80 rounded-lg border border-cool-gray-70" aria-labelledby="cta-heading">
    <h2 id="cta-heading" class="text-3xl lg:text-4xl font-semibold mb-4 text-white">
      Ready to launch your server?
    </h2>
    <p class="text-lg lg:text-xl text-cool-gray-30 mb-8 max-w-2xl mx-auto">
      Join thousands of server owners who've made the switch. No hidden fees, no contracts, just powerful hosting.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/pricing"
        class="inline-flex justify-center items-center px-8 py-4 text-lg font-semibold text-black bg-[#FF9C20] hover:bg-[#FF8D00] transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 focus:outline-none focus:ring-4 focus:ring-[#FF9C20] focus:ring-opacity-50"
      >
        View pricing
      </a>
      <a
        href="/service-status"
        class="inline-flex justify-center items-center px-8 py-4 text-lg font-semibold text-white border-2 border-cool-gray-60 hover:border-cool-gray-40 hover:bg-cool-gray-80 transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-cool-gray-60"
      >
        Check our uptime
      </a>
    </div>
  </section>

  <style>
    /* Hide Alpine.js content on initial page load */
    [x-cloak] {
      display: none !important;
    }
  </style>
</Layout>
